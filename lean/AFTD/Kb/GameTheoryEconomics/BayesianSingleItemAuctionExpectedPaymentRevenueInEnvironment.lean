variable {I : Type*} in
/-- Expected total payment revenue under the base prior. -/
noncomputable def BayesianSingleItemAuction.expectedPaymentRevenueInEnvironment [Fintype I]
    (A : BayesianSingleItemAuction I) (p : (I → ℝ) → I → ℝ) : ℝ :=
  ∫ t, (∑ i, p t i) ∂A.prior

variable {I : Type*} in
/-- Regular virtual values are measurable by Mathlib's measurability theorem for monotone real functions. -/
theorem BayesianSingleItemAuction.measurable_virtualValue_of_isRegular
    (A : BayesianSingleItemAuction I) (hA : A.IsRegular) (i : I) :
    Measurable (A.virtualValue i) :=
  (hA i).measurable

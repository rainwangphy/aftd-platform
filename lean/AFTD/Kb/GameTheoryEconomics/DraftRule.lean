import AFTD.Prelude
import AFTD.Kb.GameTheoryEconomics.DraftAlloc

/-!
# draft_rule

Topic: fair_division   Node: 23d38a34062b

Provenance: formalization of a published result. Source: arXiv:2611.09685 Section 4.1

Given types Agent and Object with decidable equality and finite Object, an implicit natural number T, a picking sequence s : Fin T -> Agent, and a preference profile succ : Agent -> LinearOrder Object, draft_rule s succ defines the allocation Agent -> Finset Object computed by running draft_alloc starting with Finset.univ and the list of agents List.ofFn s.
-/

/-- The draft rule generated by a picking sequence on strict preference profiles. -/
def draft_rule {Agent Object : Type*} [DecidableEq Agent] [DecidableEq Object] [Fintype Object]
    {T : ℕ} (s : Fin T → Agent) (succ : Agent → LinearOrder Object) :
    Agent → Finset Object :=
  draft_alloc succ (List.ofFn s) Finset.univ

import AFTD.Prelude

/-!
# seeded_subtraction_seq

Topic: combinatorial_games   Node: d58e31c19f4b

Provenance: formalization of a published result. Source: knowledgebase, OP-1251

The binary sequence defined recursively from a seed of length $2a + 1$, where the first $2a + 1$ values are given by the seed, and each subsequent value at index $n \ge 2a + 1$ is 1 if at least one of the values at $n - a$, $n - 2a$, or $n - (2a + 1)$ is 0, and 0 otherwise (with value false if $a = 0$).
-/

/-- The binary sequence generated by the subtraction game with moves {a, 2a, 2a+1} from an initial seed of length 2a+1. -/
def seeded_subtraction_seq (a : ℕ) (seed : Fin (2 * a + 1) → Bool) : ℕ → Bool
  | n =>
  if h : n < 2 * a + 1 then
    seed ⟨n, h⟩
  else
    if ha : a = 0 then false
    else
      have h1 : n - a < n := by omega
      have h2 : n - 2 * a < n := by omega
      have h3 : n - (2 * a + 1) < n := by omega
      !seeded_subtraction_seq a seed (n - a) ||
      !seeded_subtraction_seq a seed (n - 2 * a) ||
      !seeded_subtraction_seq a seed (n - (2 * a + 1))
termination_by n => n

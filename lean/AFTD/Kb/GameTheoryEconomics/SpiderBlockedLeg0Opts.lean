import AFTD.Prelude
import AFTD.Kb.GameTheoryEconomics.SpiderGamma
import AFTD.Kb.GameTheoryEconomics.SpiderLegEnd
import AFTD.Kb.GameTheoryEconomics.SpiderUpdateCentre
import AFTD.Kb.GameTheoryEconomics.CentreStatus
import AFTD.Kb.GameTheoryEconomics.SpiderRho

/-!
# spider_blocked_leg0_opts

Topic: combinatorial_games   Node: 4e7398541e16

Provenance: helper lemma. step towards op211_three_legged_spider_eventual_parity

The contribution of the blocked leg (r,β) alone to the raw option list of (in;{(r,β),(1,free)}): for each cut j₀ = 0,…,r-1 of that leg, both directions δ, skipping the prohibited end cut j = r with δ ≠ β; cuts with j ≥ 2 give ρ(r-j;δ,β) xor the two-leg sub-state (in;{(j-1,δ),(1,free)}), the j = 1 cut gives ρ(r-1;δ,β) xor the one-leg sub-state (update_centre in δ;{(1,free)}).
-/

/-- Options generated by cuts of the blocked leg (r,β) in (in;{(r,β),(1,free)}). -/
def spider_blocked_leg0_opts (r : ℕ) (beta : SpiderLegEnd) : List ℕ := (List.range r).flatMap (fun j_zero =>
    [SpiderLegEnd.inward, SpiderLegEnd.outward].filterMap (fun delta =>
      if j_zero + 1 == r ∧ beta ≠ SpiderLegEnd.free ∧ delta ≠ beta then none
      else
        let d := spider_rho (r - (j_zero + 1)) delta beta
        if j_zero + 1 ≥ 2 then
          some (d ^^^ spider_gamma (r + 1) CentreStatus.incoming [(j_zero, delta), (1, SpiderLegEnd.free)])
        else
          some (d ^^^ spider_gamma (r + 1)
            (spider_update_centre CentreStatus.incoming delta) [(1, SpiderLegEnd.free)])))

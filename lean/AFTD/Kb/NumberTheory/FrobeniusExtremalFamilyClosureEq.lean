import AFTD.Prelude
import AFTD.Kb.NumberTheory.FrobeniusExtremalFamily

/-!
# frobenius_extremal_family_closure_eq

Topic: elementary_number_theory   Node: a4cc5b029e6c

Provenance: helper lemma. scout/2610-32219-a-sharp-upper-bound-for-the-frobenius-number.md:457

For n ≥ 2, the additive submonoid closure of `frobenius_extremal_family n q` equals the additive submonoid closure of the pair {q, (n - 2) * q + 1}.
-/

/-- The additive submonoid generated by S_{n,q} equals that generated by {q, (n - 2) * q + 1}. -/
theorem frobenius_extremal_family_closure_eq (n q : ℕ) (hn : 2 ≤ n) : AddSubmonoid.closure (frobenius_extremal_family n q) = AddSubmonoid.closure {q, (n - 2) * q + 1} := by
  apply le_antisymm
  · rw [AddSubmonoid.closure_le]
    intro x hx
    unfold frobenius_extremal_family at hx
    rcases hx with ⟨i, hi1, hin, rfl⟩ | hx
    · have hq : q ∈ AddSubmonoid.closure ({q, (n - 2) * q + 1} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      have := AddSubmonoid.nsmul_mem (AddSubmonoid.closure ({q, (n - 2) * q + 1} : Set ℕ)) hq i
      rwa [nsmul_eq_mul] at this
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact AddSubmonoid.subset_closure (by simp)
  · rw [AddSubmonoid.closure_le]
    intro x hx
    apply AddSubmonoid.subset_closure
    unfold frobenius_extremal_family
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rw [Set.mem_union]
    rcases hx with rfl | rfl
    · left
      exact ⟨1, le_refl 1, by omega, by ring⟩
    · right
      rfl

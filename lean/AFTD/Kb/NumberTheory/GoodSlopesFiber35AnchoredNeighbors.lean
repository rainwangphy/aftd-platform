private def f35_opt : Finset (ZMod 35) := {6,8,11,16,22,26,29,31}
private def f35_point (i : Nat) : ZMod 35 × ZMod 35 := (((i / 35 : Nat) : ZMod 35), ((i % 35 : Nat) : ZMod 35))
private def f35_form (a : ZMod 35) (p : ZMod 35 × ZMod 35) : ZMod 35 := p.2 + a * p.1
private def f35_flag (i : Nat) : ZMod 35 := if i = 1225 then 6 else if i = 1226 then 8 else if i = 1227 then 11 else if i = 1228 then 16 else if i = 1229 then 22 else if i = 1230 then 26 else if i = 1231 then 29 else if i = 1232 then 31 else 0
private def f35_val (S : Finset (ZMod 35 × ZMod 35)) (g : ZMod 35 → Prop) : Sat.Valuation := fun i => if i < 1225 then f35_point i ∈ S else g (f35_flag i)

private theorem f35_sat_and {v : Sat.Valuation} {f g : Sat.Fmla} (hf : v.satisfies_fmla f) (hg : v.satisfies_fmla g) : v.satisfies_fmla (f.and g) := by
  refine ⟨?_⟩
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hf.prop c h
  · exact hg.prop c h

private theorem f35_sat_one {v : Sat.Valuation} {c : Sat.Clause} (h : v.satisfies c) : v.satisfies_fmla (Sat.Fmla.one c) := by
  refine ⟨?_⟩
  intro c' hc'
  have hc : c' = c := List.mem_singleton.mp hc'
  simpa only [hc] using h

private theorem f35_sat_positive_mem (v : Sat.Valuation) (L : Sat.Clause) (i : Nat)
    (hi : List.Mem (Sat.Literal.pos i) L) (hv : v i) : v.satisfies L := by
  change List Sat.Literal at L
  induction L with
  | nil => cases hi
  | cons a as ih =>
    change v.neg a → v.satisfies as
    intro hn
    rcases List.mem_cons.mp hi with h | h
    · subst a
      exact False.elim (hn hv)
    · exact ih h

private theorem f35_sat_line (S : Finset (ZMod 35 × ZMod 35)) (g : ZMod 35 → Prop)
    (a t : ZMod 35) (L : List (Fin 1225))
    (hcover : ∃ p ∈ S, f35_form a p = t)
    (hidx : ∀ p : ZMod 35 × ZMod 35, f35_form a p = t → p ∈ L.map (fun i => f35_point i.val)) :
    (f35_val S g).satisfies (L.map fun i => Sat.Literal.pos i.val) := by
  obtain ⟨p,hp,hpform⟩ := hcover
  obtain ⟨i,hi,hip⟩ := List.mem_map.mp (hidx p hpform)
  apply f35_sat_positive_mem (f35_val S g) (L.map fun i => Sat.Literal.pos i.val) i.val
  · exact List.mem_map.mpr ⟨i,hi,rfl⟩
  · simp only [f35_val, i.isLt, if_true, hip]
    exact hp


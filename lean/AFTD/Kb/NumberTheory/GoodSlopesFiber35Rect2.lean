private def r2_good : Finset (ZMod 35) := {3,4,6,8,9,12,13,17,18,19,23,24,26,27,29,31,33,34}
private def r2_point (i : Nat) : ZMod 35 × ZMod 35 := (((i / 35 : Nat) : ZMod 35), ((i % 35 : Nat) : ZMod 35))
private def r2_form (a : ZMod 35) (p : ZMod 35 × ZMod 35) : ZMod 35 := p.2 + a * p.1
private def r2_val (S : Finset (ZMod 35 × ZMod 35)) : Sat.Valuation := fun i => r2_point i ∈ S

private theorem r2_sat_and {v : Sat.Valuation} {f g : Sat.Fmla}
    (hf : v.satisfies_fmla f) (hg : v.satisfies_fmla g) : v.satisfies_fmla (f.and g) := by
  refine ⟨?_⟩
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hf.prop c h
  · exact hg.prop c h

private theorem r2_sat_one {v : Sat.Valuation} {c : Sat.Clause}
    (h : v.satisfies c) : v.satisfies_fmla (Sat.Fmla.one c) := by
  refine ⟨?_⟩
  intro c' hc'
  have hc : c' = c := List.mem_singleton.mp hc'
  simpa only [hc] using h

private theorem r2_sat_positive_mem (v : Sat.Valuation) (L : Sat.Clause) (i : Nat)
    (hi : List.Mem (Sat.Literal.pos i) L) (hv : v i) : v.satisfies L := by
  change List Sat.Literal at L
  induction L with
  | nil => cases hi
  | cons a as ih =>
    change v.neg a → v.satisfies as
    intro hn
    rcases List.mem_cons.mp hi with h | h
    · subst a
      exact False.elim (hn hv)
    · exact ih h

private theorem r2_sat_pair (S : Finset (ZMod 35 × ZMod 35))
    (hgood : ∀ a ∈ r2_good, Set.InjOn (r2_form a) S)
    (i j : Nat) (a : ZMod 35) (ha : a ∈ r2_good)
    (hne : r2_point i ≠ r2_point j)
    (heq : r2_form a (r2_point i) = r2_form a (r2_point j)) :
    (r2_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j] := by
  change r2_point i ∈ S → r2_point j ∈ S → False
  intro hi hj
  exact hne (hgood a ha hi hj heq)

private theorem r2_sat_quad (S : Finset (ZMod 35 × ZMod 35))
    (hwidth : ∀ x : ZMod 35, (S.filter fun p => p.1 = x).card ≤ 3)
    (i j k l : Nat) (x : ZMod 35)
    (hi : (r2_point i).1 = x) (hj : (r2_point j).1 = x)
    (hk : (r2_point k).1 = x) (hl : (r2_point l).1 = x)
    (hd : ({r2_point i, r2_point j, r2_point k, r2_point l} : Finset (ZMod 35 × ZMod 35)).card = 4) :
    (r2_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j, Sat.Literal.neg k, Sat.Literal.neg l] := by
  classical
  change r2_point i ∈ S → r2_point j ∈ S → r2_point k ∈ S → r2_point l ∈ S → False
  intro h1 h2 h3 h4
  have hsub : ({r2_point i, r2_point j, r2_point k, r2_point l} : Finset (ZMod 35 × ZMod 35)) ⊆ S.filter (fun p => p.1 = x) := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact Finset.mem_filter.mpr ⟨h1,hi⟩
    · exact Finset.mem_filter.mpr ⟨h2,hj⟩
    · exact Finset.mem_filter.mpr ⟨h3,hk⟩
    · exact Finset.mem_filter.mpr ⟨h4,hl⟩
  have hh := Finset.card_le_card hsub
  have hw := hwidth x
  omega

private theorem r2_sat_line (S : Finset (ZMod 35 × ZMod 35))
    (hcover : ∀ a ∈ r2_good, ∀ t : ZMod 35, ∃ p ∈ S, r2_form a p = t)
    (a t : ZMod 35) (L : List Nat) (ha : a ∈ r2_good)
    (hidx : ∀ p : ZMod 35 × ZMod 35, r2_form a p = t → p ∈ L.map r2_point) :
    (r2_val S).satisfies (L.map Sat.Literal.pos) := by
  obtain ⟨p,hp,hpform⟩ := hcover a ha t
  obtain ⟨i,hi,hip⟩ := List.mem_map.mp (hidx p hpform)
  apply r2_sat_positive_mem (r2_val S) (L.map Sat.Literal.pos) i
  · exact List.mem_map.mpr ⟨i,hi,rfl⟩
  · change r2_point i ∈ S
    simpa only [hip] using hp


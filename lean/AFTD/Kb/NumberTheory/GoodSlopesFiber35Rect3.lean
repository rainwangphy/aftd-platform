private def r3_good : Finset (ZMod 35) := {2,3,4,6,9,12,13,17,19,22,24,26,27,29,31,32,33,34}
private def r3_point (i : Nat) : ZMod 35 × ZMod 35 := (((i / 35 : Nat) : ZMod 35), ((i % 35 : Nat) : ZMod 35))
private def r3_form (a : ZMod 35) (p : ZMod 35 × ZMod 35) : ZMod 35 := p.2 + a * p.1
private def r3_val (S : Finset (ZMod 35 × ZMod 35)) : Sat.Valuation := fun i => r3_point i ∈ S

private theorem r3_sat_and {v : Sat.Valuation} {f g : Sat.Fmla}
    (hf : v.satisfies_fmla f) (hg : v.satisfies_fmla g) : v.satisfies_fmla (f.and g) := by
  refine ⟨?_⟩
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hf.prop c h
  · exact hg.prop c h

private theorem r3_sat_one {v : Sat.Valuation} {c : Sat.Clause}
    (h : v.satisfies c) : v.satisfies_fmla (Sat.Fmla.one c) := by
  refine ⟨?_⟩
  intro c' hc'
  have hc : c' = c := List.mem_singleton.mp hc'
  simpa only [hc] using h

private theorem r3_sat_positive_mem (v : Sat.Valuation) (L : Sat.Clause) (i : Nat)
    (hi : List.Mem (Sat.Literal.pos i) L) (hv : v i) : v.satisfies L := by
  change List Sat.Literal at L
  induction L with
  | nil => cases hi
  | cons a as ih =>
    change v.neg a → v.satisfies as
    intro hn
    rcases List.mem_cons.mp hi with h | h
    · subst a
      exact False.elim (hn hv)
    · exact ih h

private theorem r3_sat_pair (S : Finset (ZMod 35 × ZMod 35))
    (hgood : ∀ a ∈ r3_good, Set.InjOn (r3_form a) S)
    (i j : Nat) (a : ZMod 35) (ha : a ∈ r3_good)
    (hne : r3_point i ≠ r3_point j)
    (heq : r3_form a (r3_point i) = r3_form a (r3_point j)) :
    (r3_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j] := by
  change r3_point i ∈ S → r3_point j ∈ S → False
  intro hi hj
  exact hne (hgood a ha hi hj heq)

private theorem r3_sat_quad (S : Finset (ZMod 35 × ZMod 35))
    (hwidth : ∀ x : ZMod 35, (S.filter fun p => p.1 = x).card ≤ 3)
    (i j k l : Nat) (x : ZMod 35)
    (hi : (r3_point i).1 = x) (hj : (r3_point j).1 = x)
    (hk : (r3_point k).1 = x) (hl : (r3_point l).1 = x)
    (hd : ({r3_point i, r3_point j, r3_point k, r3_point l} : Finset (ZMod 35 × ZMod 35)).card = 4) :
    (r3_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j, Sat.Literal.neg k, Sat.Literal.neg l] := by
  classical
  change r3_point i ∈ S → r3_point j ∈ S → r3_point k ∈ S → r3_point l ∈ S → False
  intro h1 h2 h3 h4
  have hsub : ({r3_point i, r3_point j, r3_point k, r3_point l} : Finset (ZMod 35 × ZMod 35)) ⊆ S.filter (fun p => p.1 = x) := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact Finset.mem_filter.mpr ⟨h1,hi⟩
    · exact Finset.mem_filter.mpr ⟨h2,hj⟩
    · exact Finset.mem_filter.mpr ⟨h3,hk⟩
    · exact Finset.mem_filter.mpr ⟨h4,hl⟩
  have hh := Finset.card_le_card hsub
  have hw := hwidth x
  omega

private theorem r3_sat_line (S : Finset (ZMod 35 × ZMod 35))
    (hcover : ∀ a ∈ r3_good, ∀ t : ZMod 35, ∃ p ∈ S, r3_form a p = t)
    (a t : ZMod 35) (L : List Nat) (ha : a ∈ r3_good)
    (hidx : ∀ p : ZMod 35 × ZMod 35, r3_form a p = t → p ∈ L.map r3_point) :
    (r3_val S).satisfies (L.map Sat.Literal.pos) := by
  obtain ⟨p,hp,hpform⟩ := hcover a ha t
  obtain ⟨i,hi,hip⟩ := List.mem_map.mp (hidx p hpform)
  apply r3_sat_positive_mem (r3_val S) (L.map Sat.Literal.pos) i
  · exact List.mem_map.mpr ⟨i,hi,rfl⟩
  · change r3_point i ∈ S
    simpa only [hip] using hp


set_option maxRecDepth 30000
set_option maxHeartbeats 10000000

private def w3_good : Finset (ZMod 35) := {2,3,6,8,12,13,17,18,19,22,23,24,26,27,31,32,33,34}
private def w3_point (i : Nat) : ZMod 35 × ZMod 35 := (((i / 35 : Nat) : ZMod 35), ((i % 35 : Nat) : ZMod 35))
private def w3_form (a : ZMod 35) (p : ZMod 35 × ZMod 35) : ZMod 35 := p.2 + a * p.1
private def w3_val (S : Finset (ZMod 35 × ZMod 35)) : Sat.Valuation := fun i => w3_point i ∈ S

private theorem w3_sat_and {v : Sat.Valuation} {f g : Sat.Fmla}
    (hf : v.satisfies_fmla f) (hg : v.satisfies_fmla g) : v.satisfies_fmla (f.and g) := by
  refine ⟨?_⟩
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hf.prop c h
  · exact hg.prop c h

private theorem w3_sat_one {v : Sat.Valuation} {c : Sat.Clause}
    (h : v.satisfies c) : v.satisfies_fmla (Sat.Fmla.one c) := by
  refine ⟨?_⟩
  intro c' hc'
  have hc : c' = c := List.mem_singleton.mp hc'
  simpa only [hc] using h

private theorem w3_sat_positive_mem (v : Sat.Valuation) (L : Sat.Clause) (i : Nat)
    (hi : List.Mem (Sat.Literal.pos i) L) (hv : v i) : v.satisfies L := by
  change List Sat.Literal at L
  induction L with
  | nil => cases hi
  | cons a as ih =>
    change v.neg a → v.satisfies as
    intro hn
    rcases List.mem_cons.mp hi with h | h
    · subst a
      exact False.elim (hn hv)
    · exact ih h

private theorem w3_sat_pair (S : Finset (ZMod 35 × ZMod 35))
    (hgood : ∀ a ∈ w3_good, Set.InjOn (w3_form a) S)
    (i j : Nat) (a : ZMod 35) (ha : a ∈ w3_good)
    (hne : w3_point i ≠ w3_point j)
    (heq : w3_form a (w3_point i) = w3_form a (w3_point j)) :
    (w3_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j] := by
  change w3_point i ∈ S → w3_point j ∈ S → False
  intro hi hj
  exact hne (hgood a ha hi hj heq)

private theorem w3_sat_quad (S : Finset (ZMod 35 × ZMod 35))
    (hwidth : ∀ x : ZMod 35, (S.filter fun p => p.1 = x).card ≤ 3)
    (i j k l : Nat) (x : ZMod 35)
    (hi : (w3_point i).1 = x) (hj : (w3_point j).1 = x)
    (hk : (w3_point k).1 = x) (hl : (w3_point l).1 = x)
    (hd : ({w3_point i, w3_point j, w3_point k, w3_point l} : Finset (ZMod 35 × ZMod 35)).card = 4) :
    (w3_val S).satisfies [Sat.Literal.neg i, Sat.Literal.neg j, Sat.Literal.neg k, Sat.Literal.neg l] := by
  classical
  change w3_point i ∈ S → w3_point j ∈ S → w3_point k ∈ S → w3_point l ∈ S → False
  intro h1 h2 h3 h4
  have hsub : ({w3_point i, w3_point j, w3_point k, w3_point l} : Finset (ZMod 35 × ZMod 35)) ⊆ S.filter (fun p => p.1 = x) := by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact Finset.mem_filter.mpr ⟨h1,hi⟩
    · exact Finset.mem_filter.mpr ⟨h2,hj⟩
    · exact Finset.mem_filter.mpr ⟨h3,hk⟩
    · exact Finset.mem_filter.mpr ⟨h4,hl⟩
  have hh := Finset.card_le_card hsub
  have hw := hwidth x
  omega

private theorem w3_sat_line (S : Finset (ZMod 35 × ZMod 35))
    (hcover : ∀ a ∈ w3_good, ∀ t : ZMod 35, ∃ p ∈ S, w3_form a p = t)
    (a t : ZMod 35) (L : List Nat) (ha : a ∈ w3_good)
    (hidx : ∀ p : ZMod 35 × ZMod 35, w3_form a p = t → p ∈ L.map w3_point) :
    (w3_val S).satisfies (L.map Sat.Literal.pos) := by
  obtain ⟨p,hp,hpform⟩ := hcover a ha t
  obtain ⟨i,hi,hip⟩ := List.mem_map.mp (hidx p hpform)
  apply w3_sat_positive_mem (w3_val S) (L.map Sat.Literal.pos) i
  · exact List.mem_map.mpr ⟨i,hi,rfl⟩
  · change w3_point i ∈ S
    simpa only [hip] using hp

theorem good_slopes_fiber35_width3_rect4 (S : Finset (ZMod 35 × ZMod 35))
  (h0 : (0,0) ∈ S) (h1 : (1,34) ∈ S)
  (hinj : ∀ a ∈ ({2,3,6,8,12,13,17,18,19,22,23,24,26,27,31,32,33,34} : Finset (ZMod 35)), Set.InjOn (fun p : ZMod 35 × ZMod 35 => p.2 + a*p.1) S)
  (hcover : ∀ a ∈ ({2,3,6,8,12,13,17,18,19,22,23,24,26,27,31,32,33,34} : Finset (ZMod 35)), ∀ t : ZMod 35, ∃ p ∈ S, p.2 + a*p.1 = t)
  (hwidth : ∀ x : ZMod 35, (S.filter fun p => p.1 = x).card ≤ 3) : False := by
  change ∀ a ∈ w3_good, Set.InjOn (w3_form a) S at hinj
  change ∀ a ∈ w3_good, ∀ t : ZMod 35, ∃ p ∈ S, w3_form a p = t at hcover
  have hF : (w3_val S).satisfies_fmla aftd_rect35_formula := by
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and
    apply w3_sat_and

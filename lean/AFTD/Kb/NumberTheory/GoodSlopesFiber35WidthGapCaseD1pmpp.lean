theorem good_slopes_fiber35_width_gap_case_d1pmpp (S : Finset (ZMod 35 × ZMod 35)) (hcard : S.card = 35)
    (h0 : ((0 : ZMod 35), (0 : ZMod 35)) ∈ S) (h1 : ((1 : ZMod 35), (34 : ZMod 35)) ∈ S)
    (hx : ∀ x : ZMod 35, (S.filter (fun p => p.1 = x)).card ≤ 3)
    (hline : (S.filter (fun p => p.2 + p.1 = 0)).card ≤ 3)
    (hnb : ∀ a : ZMod 35, IsUnit a → a ∉ good_slopes_point_directions 35 S →
      ((good_slopes_point_directions 35 S).filter (fun b => b ≠ a ∧ (b.val % 5 = a.val % 5 ∨ b.val % 7 = a.val % 7))).card ≤ 5) (hin2 : (2 : ZMod 35) ∈ good_slopes_point_directions 35 S) (hin4 : (4 : ZMod 35) ∈ good_slopes_point_directions 35 S) (hin8 : (8 : ZMod 35) ∈ good_slopes_point_directions 35 S) (hout29 : (29 : ZMod 35) ∉ good_slopes_point_directions 35 S) :
    (good_slopes_point_directions 35 S).card ≤ 16 := by
  by_contra hlt
  have h17 : 17 ≤ (good_slopes_point_directions 35 S).card := by omega
  have hF : (W35.rval S (good_slopes_point_directions 35 S)).satisfies_fmla W35.cd1pmpp.formula :=
    good_slopes_fiber35_sat_fmla_sound S _ _ ([(2 : ZMod 35), (4 : ZMod 35), (8 : ZMod 35)] : List (ZMod 35)) ([(29 : ZMod 35)] : List (ZMod 35)) (by simp [hin2, hin4, hin8]) (by simp [hout29]) h0 h1
      (W35.good_inj S) (W35.good_cover S hcard) hx hline hnb h17 (W35.good_sub S) _ (by decide +kernel)
  exact W35.cd1pmpp.sat_proof _ hF

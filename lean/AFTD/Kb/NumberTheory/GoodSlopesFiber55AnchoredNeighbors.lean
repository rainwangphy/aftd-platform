private def in875fast_f55_opt : Finset (ZMod 55) := {6,12,16,21,23,26,31,34,36,41,46,51}
private def in875fast_f55_point (i : Nat) : ZMod 55 × ZMod 55 := (((i / 55 : Nat) : ZMod 55), ((i % 55 : Nat) : ZMod 55))
private def in875fast_f55_form (a : ZMod 55) (p : ZMod 55 × ZMod 55) : ZMod 55 := p.2 + a * p.1
private def in875fast_f55_flag (i : Nat) : ZMod 55 := if i = 3025 then 6 else if i = 3026 then 12 else if i = 3027 then 16 else if i = 3028 then 21 else if i = 3029 then 23 else if i = 3030 then 26 else if i = 3031 then 31 else if i = 3032 then 34 else if i = 3033 then 36 else if i = 3034 then 41 else if i = 3035 then 46 else if i = 3036 then 51 else 0
private def in875fast_f55_val (S : Finset (ZMod 55 × ZMod 55)) (g : ZMod 55 → Prop) : Sat.Valuation := fun i => if i < 3025 then in875fast_f55_point i ∈ S else g (in875fast_f55_flag i)

private theorem in875fast_f55_sat_and {v : Sat.Valuation} {f g : Sat.Fmla} (hf : v.satisfies_fmla f) (hg : v.satisfies_fmla g) : v.satisfies_fmla (f.and g) := by
  refine ⟨?_⟩
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hf.prop c h
  · exact hg.prop c h

private theorem in875fast_f55_sat_one {v : Sat.Valuation} {c : Sat.Clause} (h : v.satisfies c) : v.satisfies_fmla (Sat.Fmla.one c) := by
  refine ⟨?_⟩
  intro c' hc'
  have hc : c' = c := List.mem_singleton.mp hc'
  simpa only [hc] using h

private theorem in875fast_f55_sat_positive_mem (v : Sat.Valuation) (L : Sat.Clause) (i : Nat)
    (hi : List.Mem (Sat.Literal.pos i) L) (hv : v i) : v.satisfies L := by
  change List Sat.Literal at L
  induction L with
  | nil => cases hi
  | cons a as ih =>
    change v.neg a → v.satisfies as
    intro hn
    rcases List.mem_cons.mp hi with h | h
    · subst a
      exact False.elim (hn hv)
    · exact ih h

private theorem in875fast_f55_point_index (p : ZMod 55 × ZMod 55) :
    in875fast_f55_point (55*p.1.val + p.2.val) = p := by
  have hx := ZMod.val_lt p.1
  have hy := ZMod.val_lt p.2
  have hdiv : (55*p.1.val+p.2.val)/55 = p.1.val := by omega
  have hmod : (55*p.1.val+p.2.val)%55 = p.2.val := by omega
  apply Prod.ext
  · simp [in875fast_f55_point,hdiv]
  · simp [in875fast_f55_point,hmod]

private theorem in875fast_f55_sat_line (S : Finset (ZMod 55 × ZMod 55)) (g : ZMod 55 → Prop)
    (a t : ZMod 55) (L : List (Fin 3025))
    (hcover : ∃ p ∈ S, in875fast_f55_form a p = t)
    (hidx : ∀ x : ZMod 55, 55*x.val + (t-a*x).val ∈ L.map Fin.val) :
    (in875fast_f55_val S g).satisfies (L.map fun i => Sat.Literal.pos i.val) := by
  obtain ⟨p,hp,hpform⟩ := hcover
  have hp2 : p.2 = t-a*p.1 := by
    dsimp [in875fast_f55_form] at hpform
    linear_combination hpform
  have hm : 55*p.1.val+p.2.val ∈ L.map Fin.val := by
    simpa only [hp2] using hidx p.1
  obtain ⟨i,hi,hieq⟩ := List.mem_map.mp hm
  apply in875fast_f55_sat_positive_mem (in875fast_f55_val S g) (L.map fun i => Sat.Literal.pos i.val) i.val
  · exact List.mem_map.mpr ⟨i,hi,rfl⟩
  · have hpoint : in875fast_f55_point i.val = p := by rw [hieq]; exact in875fast_f55_point_index p
    simp only [in875fast_f55_val, i.isLt, if_true, hpoint]
    exact hp

theorem good_slopes_fiber55_anchored_neighbors (S : Finset (ZMod 55 × ZMod 55)) (g : ZMod 55 → Prop)
  (h0 : (0,0) ∈ S) (h1 : (1,54) ∈ S)
  (hinj : ∀ a ∈ ({6,12,16,21,23,26,31,34,36,41,46,51} : Finset (ZMod 55)), g a → Set.InjOn (fun p : ZMod 55 × ZMod 55 => p.2 + a*p.1) S)
  (hcover : ∀ a ∈ ({6,12,16,21,23,26,31,34,36,41,46,51} : Finset (ZMod 55)), g a → ∀ t : ZMod 55, ∃ p ∈ S, p.2 + a*p.1 = t)
  (hthree : ∀ a b c, a ∈ ({6,12,16,21,23,26,31,34,36,41,46,51} : Finset (ZMod 55)) → b ∈ ({6,12,16,21,23,26,31,34,36,41,46,51} : Finset (ZMod 55)) → c ∈ ({6,12,16,21,23,26,31,34,36,41,46,51} : Finset (ZMod 55)) → a ≠ b → a ≠ c → b ≠ c → g a ∨ g b ∨ g c) : False := by
  change ∀ a ∈ in875fast_f55_opt, g a → Set.InjOn (in875fast_f55_form a) S at hinj
  change ∀ a ∈ in875fast_f55_opt, g a → ∀ t : ZMod 55, ∃ p ∈ S, in875fast_f55_form a p = t at hcover
  change ∀ a b c, a ∈ in875fast_f55_opt → b ∈ in875fast_f55_opt → c ∈ in875fast_f55_opt → a ≠ b → a ≠ c → b ≠ c → g a ∨ g b ∨ g c at hthree
  have hF : (in875fast_f55_val S g).satisfies_fmla aftd_in875fast_n55_formula := by
    apply in875fast_f55_sat_and
    apply in875fast_f55_sat_and
    apply in875fast_f55_sat_and

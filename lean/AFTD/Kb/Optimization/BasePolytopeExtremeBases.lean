import AFTD.Prelude

/-!
# base_polytope_extreme_bases

Topic: submodular   Node: 665e2d6487b5

Provenance: formalization of a published result. Source: Edmonds 1970; Fujishige 1980

The set of greedy bases of a set function f on Finset (Fin n) consists of the vectors generated by Edmonds' greedy algorithm over all permutations π of Fin n.
-/

/-- The set of greedy bases (extreme points) of the base polytope of f. -/
def base_polytope_extreme_bases {n : ℕ} (f : Finset (Fin n) → ℝ) : Set (Fin n → ℝ) := { p | ∃ π : Equiv.Perm (Fin n), p = fun i => f (Finset.univ.filter (fun j => π.symm j ≤ π.symm i)) - f (Finset.univ.filter (fun j => π.symm j < π.symm i)) }

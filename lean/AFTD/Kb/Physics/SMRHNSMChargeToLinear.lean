set_option autoImplicit true in
set_option relaxedAutoImplicit true in
open SMRHN in
open SMνCharges in
open SMνACCs in
open BigOperators in
variable {n : ℕ} in
/-- An element of `charges` which satisfies the linear ACCs gives us a element of `LinSols`. -/
def SMRHN.SM.chargeToLinear (S : (SM n).Charges) (hGrav : accGrav S = 0)
    (hSU2 : accSU2 S = 0) (hSU3 : accSU3 S = 0) : (SM n).LinSols :=
  ⟨S, by
    intro i
    match i with
    | ⟨0, _⟩ => exact hGrav
    | ⟨1, _⟩ => exact hSU2
    | ⟨2, _⟩ => exact hSU3⟩

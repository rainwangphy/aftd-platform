set_option autoImplicit true in
set_option relaxedAutoImplicit true in
universe u v w in
variable {α : Type u} {β : Type v} {δ : Type w} in
/-- Prepend an element to an ω-sequence. -/
def Cslib.ωSequence.cons (a : α) (s : ωSequence α) : ωSequence α
  | 0 => a
  | n + 1 => s n

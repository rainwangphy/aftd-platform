import AFTD.Prelude
import AFTD.Kb.Tcs.CycleCoverReverseReachable

/-!
# cycle_cover_group_preserves_reachability

Topic: graphs   Node: bf5ca0efb4ec

Provenance: helper lemma. step towards simple_graph_normalized_hop_group_quadratic_word_diameter

Every element k of the subgroup generated by the cycle covers of R maps each point x to a point reachable from x and reachable back to x along R. In particular k preserves the partition of V into mutual-reachability classes (the strongly connected components).
-/

/-- Every element of the cycle-cover group preserves both directions of R-reachability. -/
theorem cycle_cover_group_preserves_reachability {V : Type*} [Fintype V] (R : V → V → Prop)
    (k : Equiv.Perm V) (hk : k ∈ Subgroup.closure {p : Equiv.Perm V | ∀ v, R v (p v)}) (x : V) :
    Relation.ReflTransGen R x (k x) ∧ Relation.ReflTransGen R (k x) x := by
  have key : ∀ k ∈ Subgroup.closure {p : Equiv.Perm V | ∀ v, R v (p v)},
      ∀ x, Relation.ReflTransGen R x (k x) ∧ Relation.ReflTransGen R (k x) x := by
    intro k hk
    refine Subgroup.closure_induction
      (p := fun g _ => ∀ x, Relation.ReflTransGen R x (g x) ∧ Relation.ReflTransGen R (g x) x)
      ?_ ?_ ?_ ?_ hk
    · intro p hp x
      exact ⟨Relation.ReflTransGen.single (hp x), cycle_cover_reverse_reachable R p hp x⟩
    · intro x
      exact ⟨Relation.ReflTransGen.refl, Relation.ReflTransGen.refl⟩
    · intro a b ha hb h1 h2 x
      rw [Equiv.Perm.mul_apply]
      exact ⟨(h2 x).1.trans (h1 (b x)).1, (h1 (b x)).2.trans (h2 x).2⟩
    · intro a ha h1 x
      exact ⟨by simpa using (h1 (a⁻¹ x)).2, by simpa using (h1 (a⁻¹ x)).1⟩
  exact key k hk x

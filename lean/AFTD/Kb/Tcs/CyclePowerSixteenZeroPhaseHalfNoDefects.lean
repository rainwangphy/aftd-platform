import AFTD.Prelude
import AFTD.Kb.Tcs.CyclePowerDyadicDefectiveHalfModel
import AFTD.Kb.Tcs.CyclePowerDyadicTightClassParent
import AFTD.Kb.Tcs.CyclePowerDyadicClassWeight

/-!
# cycle_power_sixteen_zero_phase_half_no_defects

Topic: combinatorics   Node: 03864e5732c4

Provenance: helper lemma. RT-1 / OP-205, arXiv:2610.15635: the zero phase of the hnodefect hypothesis of cycle_power_dyadic_middle_bits_from_defective_halves at t = 4. SAT core of experiment 35537 (window [-24, 24], 90 groups) turned into a kernel-checked LRAT certificate.

An exponent-four (offsets 0..15) zero-phase dyadic defective half model has no defects: every defect bit e(v) is false.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 40000000


namespace RT1T16

def pz (q : ℕ) : ℤ := (q : ℤ) - 64

def bval (x : ℤ → ℕ → Bool) (e : ℤ → Bool) (i : ℕ) : Bool :=
  if i % 4 = 0 then x (pz (i / 64)) (i / 4 % 16)
  else if i % 4 = 1 then e (pz (i / 4))
  else if i % 4 = 2 then (x (pz (i / 1024)) (i / 64 % 16) && x (pz (i / 1024)) (i / 4 % 16))
  else false

def rval (x : ℤ → ℕ → Bool) (e : ℤ → Bool) : Sat.Valuation := fun i => bval x e i = true

def xc (q a : ℕ) : ℕ := 64 * q + 4 * a
def ec (q : ℕ) : ℕ := 4 * q + 1
def zc (q a b : ℕ) : ℕ := 1024 * q + 64 * a + 4 * b + 2

section
variable (x : ℤ → ℕ → Bool) (e : ℤ → Bool)

theorem bval_xc (q a : ℕ) (ha : a < 16) : bval x e (xc q a) = x (pz q) a := by
  unfold bval xc
  rw [if_pos (by omega)]
  have h1 : (64 * q + 4 * a) / 64 = q := by omega
  have h2 : (64 * q + 4 * a) / 4 % 16 = a := by omega
  rw [h1, h2]

theorem bval_ec (q : ℕ) : bval x e (ec q) = e (pz q) := by
  unfold bval ec
  rw [if_neg (by omega), if_pos (by omega)]
  have h1 : (4 * q + 1) / 4 = q := by omega
  rw [h1]

theorem bval_zc (q a b : ℕ) (ha : a < 16) (hb : b < 16) :
    bval x e (zc q a b) = (x (pz q) a && x (pz q) b) := by
  unfold bval zc
  rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
  have h1 : (1024 * q + 64 * a + 4 * b + 2) / 1024 = q := by omega
  have h2 : (1024 * q + 64 * a + 4 * b + 2) / 64 % 16 = a := by omega
  have h3 : (1024 * q + 64 * a + 4 * b + 2) / 4 % 16 = b := by omega
  rw [h1, h2, h3]

end

theorem pz_sub (q a : ℕ) (h : a ≤ q) : pz (q - a) = pz q - (a : ℤ) := by
  unfold pz; push_cast [Nat.cast_sub h]; ring

theorem fsum_eq (n : ℕ) (g : ℕ → ℕ) : (Finset.range n).sum g = ((List.range n).map g).sum := by
  induction n with
  | zero => simp
  | succ n ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append, List.sum_append]; simp

/-! generic soundness of the two clause shapes of a counting group -/

theorem neg_sound (f : ℕ → ℕ) (G S : List ℕ) (hG : G.Nodup) (hS : S.Nodup)
    (hsub : ∀ i ∈ S, i ∈ G) (k : ℕ) (hsum : (G.map f).sum ≤ k) (hlen : k < S.length)
    (hall : ∀ i ∈ S, 1 ≤ f i) : False := by
  have h1 : (S.map f).sum ≤ (G.map f).sum := by
    rw [← List.sum_toFinset f hS, ← List.sum_toFinset f hG]
    apply Finset.sum_le_sum_of_subset
    intro i hi; rw [List.mem_toFinset] at hi ⊢; exact hsub i hi
  have h2 : (S.map f).length ≤ (S.map f).sum :=
    List.length_le_sum_of_one_le _ (by
      intro i hi; obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hi; exact hall j hj)
  rw [List.length_map] at h2
  omega

theorem pos_sound (f : ℕ → ℕ) (hf : ∀ i, f i ≤ 1) (G S : List ℕ) (hG : G.Nodup) (hS : S.Nodup)
    (hsub : ∀ i ∈ S, i ∈ G) (k : ℕ) (hsum : k ≤ (G.map f).sum) (hlen : G.length < S.length + k)
    (hall : ∀ i ∈ S, f i = 0) : False := by
  rw [← List.sum_toFinset f hG] at hsum
  have hsub' : S.toFinset ⊆ G.toFinset := by
    intro i hi; rw [List.mem_toFinset] at hi ⊢; exact hsub i hi
  rw [← Finset.sum_sdiff hsub'] at hsum
  have h0 : ∑ x ∈ S.toFinset, f x = 0 :=
    Finset.sum_eq_zero (fun i hi => hall i (List.mem_toFinset.mp hi))
  have h1 : ∑ x ∈ G.toFinset \ S.toFinset, f x ≤ (G.toFinset \ S.toFinset).card := by
    calc ∑ x ∈ G.toFinset \ S.toFinset, f x ≤ (G.toFinset \ S.toFinset).sum (fun _ => 1) :=
          Finset.sum_le_sum (fun i _ => hf i)
      _ = _ := by simp
  rw [Finset.card_sdiff_of_subset hsub', List.toFinset_card_of_nodup hG,
    List.toFinset_card_of_nodup hS] at h1
  have : S.length ≤ G.length := by
    have := Finset.card_le_card hsub'
    rwa [List.toFinset_card_of_nodup hG, List.toFinset_card_of_nodup hS] at this
  omega

/-! groups -/

inductive Grp
  | rk (j qv : ℕ)
  | top (qv : ℕ)
  | cov (d qv : ℕ)
  | cnt (qv : ℕ)

def Grp.list : Grp → List ℕ
  | .rk j qv => (List.range (2 ^ j)).map (fun a => zc (qv - a) a (a + 16 - 2 ^ j))
  | .top qv => (List.range 8).map (fun a => zc (qv - a) a (a + 8)) ++ [ec qv]
  | .cov d qv => (List.range (16 - d)).map (fun a => zc (qv - a) a (a + d))
  | .cnt qv => (List.range 16).map (fun a => xc (qv - a) a) ++ [ec qv]

def Grp.k : Grp → ℕ
  | .cnt _ => 5
  | _ => 1

def Grp.exact : Grp → Bool
  | .cov _ _ => false
  | _ => true

def Grp.valid : Grp → Bool
  | .rk j qv => decide (1 ≤ j ∧ j < 3 ∧ 15 ≤ qv)
  | .top qv => decide (15 ≤ qv)
  | .cov d qv => decide (1 ≤ d ∧ d < 16 ∧ d ≠ 8 ∧ 15 ≤ qv)
  | .cnt qv => decide (15 ≤ qv)

section
variable (x : ℤ → ℕ → Bool) (e : ℤ → Bool)

theorem map_rk (j qv : ℕ) (hj : 1 ≤ j) (hj3 : j < 3) (hq : 15 ≤ qv) :
    ((Grp.rk j qv).list.map (fun i => (bval x e i).toNat)) =
      (List.range (2 ^ j)).map (fun (a : ℕ) => (x (pz qv - (a : ℤ)) a &&
        x (pz qv - (a : ℤ)) (a + 2 ^ 4 - 2 ^ j)).toNat) := by
  have hp : 2 ^ j ≤ 4 := by interval_cases j <;> norm_num
  have hp1 : 1 ≤ 2 ^ j := Nat.one_le_two_pow
  unfold Grp.list
  rw [List.map_map]
  apply List.map_congr_left
  intro a ha
  rw [List.mem_range] at ha
  simp only [Function.comp]
  rw [bval_zc x e _ _ _ (by omega) (by omega), pz_sub _ _ (by omega)]
  norm_num

theorem map_top (qv : ℕ) (hq : 15 ≤ qv) :
    ((Grp.top qv).list.map (fun i => (bval x e i).toNat)) =
      (List.range (2 ^ (4 - 1))).map (fun (a : ℕ) => (x (pz qv - (a : ℤ)) a &&
        x (pz qv - (a : ℤ)) (a + 2 ^ 4 - 2 ^ (4 - 1))).toNat) ++ [(e (pz qv + 0)).toNat] := by
  unfold Grp.list
  rw [List.map_append, List.map_map]
  simp only [show (2:ℕ) ^ 4 = 16 from rfl, show (2:ℕ) ^ (4 - 1) = 8 from rfl]
  congr 1
  · apply List.map_congr_left
    intro a ha
    rw [List.mem_range] at ha
    simp only [Function.comp]
    rw [bval_zc x e _ _ _ (by omega) (by omega), pz_sub _ _ (by omega),
      show a + 16 - 8 = a + 8 by omega]
  · simp [bval_ec]

theorem map_cov (d qv : ℕ) (hd : d < 16) (hq : 15 ≤ qv) :
    ((Grp.cov d qv).list.map (fun i => (bval x e i).toNat)) =
      (List.range (16 - d)).map (fun (a : ℕ) => (x (pz qv - (a : ℤ)) a &&
        x (pz qv - (a : ℤ)) (a + d)).toNat) := by
  unfold Grp.list
  rw [List.map_map]
  apply List.map_congr_left
  intro a ha
  rw [List.mem_range] at ha
  simp only [Function.comp]
  rw [bval_zc x e _ _ _ (by omega) (by omega), pz_sub _ _ (by omega)]

theorem map_cnt (qv : ℕ) (hq : 15 ≤ qv) :
    ((Grp.cnt qv).list.map (fun i => (bval x e i).toNat)) =
      (List.range (2 ^ 4)).map (fun (a : ℕ) => (x (pz qv - (a : ℤ)) a).toNat) ++ [(e (pz qv)).toNat] := by
  unfold Grp.list
  rw [List.map_append, List.map_map]
  congr 1
  · apply List.map_congr_left
    intro a ha
    rw [List.mem_range] at ha
    simp only [Function.comp]
    rw [bval_xc x e _ _ (by omega), pz_sub _ _ (by omega)]
  · simp [bval_ec]

theorem grp_fact (hm : cycle_power_dyadic_defective_half_model 4 x e 0) (g : Grp)
    (hg : g.valid = true) :
    (g.exact = true → (g.list.map (fun i => (bval x e i).toNat)).sum = g.k) ∧
      g.k ≤ (g.list.map (fun i => (bval x e i).toNat)).sum := by
  rcases hm with ⟨_, hl, ht, hc, hn⟩
  cases g with
  | rk j qv =>
    simp only [Grp.valid, decide_eq_true_eq] at hg
    have h := hl j (by omega) (pz qv)
    rw [fsum_eq] at h
    have e1 : ((Grp.rk j qv).list.map (fun i => (bval x e i).toNat)).sum = 1 := by
      rw [map_rk x e j qv hg.1 hg.2.1 hg.2.2]; exact h
    exact ⟨fun _ => e1, by rw [e1]; rfl⟩
  | top qv =>
    simp only [Grp.valid, decide_eq_true_eq] at hg
    have h := ht (pz qv)
    rw [fsum_eq] at h
    have e1 : ((Grp.top qv).list.map (fun i => (bval x e i).toNat)).sum = 1 := by
      rw [map_top x e qv hg, List.sum_append, List.sum_singleton]; exact h
    exact ⟨fun _ => e1, by rw [e1]; rfl⟩
  | cov d qv =>
    simp only [Grp.valid, decide_eq_true_eq] at hg
    obtain ⟨a, ha, h1, h2⟩ := hc d hg.1 hg.2.1 (by norm_num; exact hg.2.2.1) (pz qv)
    simp only [show (2:ℕ) ^ 4 = 16 from rfl] at ha
    refine ⟨by simp [Grp.exact], ?_⟩
    rw [map_cov x e d qv hg.2.1 hg.2.2.2, ← fsum_eq]
    simp only [Grp.k]
    calc 1 = (x (pz qv - (a : ℤ)) a && x (pz qv - (a : ℤ)) (a + d)).toNat := by simp [h1, h2]
      _ ≤ _ := Finset.single_le_sum (f := fun (a : ℕ) => (x (pz qv - (a : ℤ)) a &&
            x (pz qv - (a : ℤ)) (a + d)).toNat) (fun _ _ => Nat.zero_le _)
            (Finset.mem_range.mpr (by omega))
  | cnt qv =>
    simp only [Grp.valid, decide_eq_true_eq] at hg
    have h := hn (pz qv)
    rw [fsum_eq] at h
    have e1 : ((Grp.cnt qv).list.map (fun i => (bval x e i).toNat)).sum = 5 := by
      rw [map_cnt x e qv hg, List.sum_append, List.sum_singleton]; exact h
    exact ⟨fun _ => e1, by rw [e1]; rfl⟩

end

/-! clause checker -/

def negAtoms : List Sat.Literal → Option (List ℕ)
  | [] => some []
  | .neg i :: r => (negAtoms r).map (i :: ·)
  | .pos _ :: _ => none

def posAtoms : List Sat.Literal → Option (List ℕ)
  | [] => some []
  | .pos i :: r => (posAtoms r).map (i :: ·)
  | .neg _ :: _ => none

theorem negAtoms_mem : ∀ (c : List Sat.Literal) (S : List ℕ), negAtoms c = some S →
    ∀ i ∈ S, List.Mem (Sat.Literal.neg i) c
  | [], S, h => by simp [negAtoms] at h; subst h; simp
  | .neg j :: r, S, h => by
    simp only [negAtoms, Option.map_eq_some_iff] at h
    obtain ⟨T, hT, rfl⟩ := h
    intro i hi
    rcases List.mem_cons.mp hi with rfl | hi
    · exact List.Mem.head _
    · exact List.Mem.tail _ (negAtoms_mem r T hT i hi)
  | .pos _ :: _, S, h => by simp [negAtoms] at h

theorem posAtoms_mem : ∀ (c : List Sat.Literal) (S : List ℕ), posAtoms c = some S →
    ∀ i ∈ S, List.Mem (Sat.Literal.pos i) c
  | [], S, h => by simp [posAtoms] at h; subst h; simp
  | .pos j :: r, S, h => by
    simp only [posAtoms, Option.map_eq_some_iff] at h
    obtain ⟨T, hT, rfl⟩ := h
    intro i hi
    rcases List.mem_cons.mp hi with rfl | hi
    · exact List.Mem.head _
    · exact List.Mem.tail _ (posAtoms_mem r T hT i hi)
  | .neg _ :: _, S, h => by simp [posAtoms] at h

def cands (i : ℕ) : List Grp :=
  if i % 4 = 0 then [.cnt (i / 64 + i / 4 % 16)]
  else if i % 4 = 1 then [.top (i / 4), .cnt (i / 4)]
  else [.rk 1 (i / 1024 + i / 64 % 16), .rk 2 (i / 1024 + i / 64 % 16),
    .top (i / 1024 + i / 64 % 16), .cov (i / 4 % 16 - i / 64 % 16) (i / 1024 + i / 64 % 16)]

def chkNegG (S : List ℕ) (g : Grp) : Bool :=
  g.valid && g.exact && decide (S.Nodup ∧ g.list.Nodup ∧ (∀ i ∈ S, i ∈ g.list) ∧ g.k < S.length)

def chkPosG (S : List ℕ) (g : Grp) : Bool :=
  g.valid && decide (S.Nodup ∧ g.list.Nodup ∧ (∀ i ∈ S, i ∈ g.list) ∧
    g.list.length < S.length + g.k)

def chkGroup (c : List Sat.Literal) : Bool :=
  match negAtoms c with
  | some (i :: S) => (cands i).any (chkNegG (i :: S))
  | _ => match posAtoms c with
    | some (i :: S) => (cands i).any (chkPosG (i :: S))
    | _ => false

def par : List (ℕ × ℕ) := [(14,0),(1,15),(12,0),(13,1),(2,14),(3,15),(8,0),(9,1),(10,2),(11,3),
  (4,12),(5,13),(6,14),(7,15)]

def chkSmall : List Sat.Literal → Bool
  | [.pos i] => decide (i % 4 = 0 ∧ (i / 4 % 16 = 0 ∨ i / 4 % 16 = 15)) || decide (i = ec 64)
  | [.neg i, .pos j] =>
    decide (i % 4 = 0 ∧ j % 4 = 0 ∧ i / 64 = j / 64 ∧ (i / 4 % 16, j / 4 % 16) ∈ par) ||
    decide (i % 4 = 2 ∧ (j = xc (i / 1024) (i / 64 % 16) ∨ j = xc (i / 1024) (i / 4 % 16)))
  | [.pos z, .neg i, .neg j] =>
    decide (z % 4 = 2 ∧ i = xc (z / 1024) (z / 64 % 16) ∧ j = xc (z / 1024) (z / 4 % 16))
  | _ => false

def chk (c : List Sat.Literal) : Bool := chkSmall c || chkGroup c

theorem sat_of (v : Sat.Valuation) (c : Sat.Clause)
    (h : (∀ l, List.Mem l c → v.neg l) → False) : v.satisfies c := by
  change List Sat.Literal at c
  induction c with
  | nil => exact h (fun l hl => by cases hl)
  | cons a as ih =>
    intro ha
    exact ih (fun hall => h (fun l hl => by
      cases hl with
      | head => exact ha
      | tail _ hl => exact hall l hl))

section
variable (x : ℤ → ℕ → Bool) (e : ℤ → Bool)

theorem par_ok (hm : cycle_power_dyadic_defective_half_model 4 x e 0) (p : ℤ) (c q : ℕ)
    (h : (c, q) ∈ par) (hc : x p c = true) : x p q = true := by
  have h1 := cycle_power_dyadic_tight_class_parent 4 1 (by omega) (by omega) (x p) (hm.1 p)
  have h2 := cycle_power_dyadic_tight_class_parent 4 2 (by omega) (by omega) (x p) (hm.1 p)
  have h3 := cycle_power_dyadic_tight_class_parent 4 3 (by omega) (by omega) (x p) (hm.1 p)
  simp only [par, List.mem_cons, Prod.mk.injEq, List.not_mem_nil, or_false] at h
  rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
    ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ |
    ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact (h1 0 (by norm_num)).1 (by norm_num) hc
  · exact (h1 1 (by norm_num)).2 (by norm_num) hc
  · exact (h2 0 (by norm_num)).1 (by norm_num) hc
  · exact (h2 1 (by norm_num)).1 (by norm_num) hc
  · exact (h2 2 (by norm_num)).2 (by norm_num) hc
  · exact (h2 3 (by norm_num)).2 (by norm_num) hc
  · exact (h3 0 (by norm_num)).1 (by norm_num) hc
  · exact (h3 1 (by norm_num)).1 (by norm_num) hc
  · exact (h3 2 (by norm_num)).1 (by norm_num) hc
  · exact (h3 3 (by norm_num)).1 (by norm_num) hc
  · exact (h3 4 (by norm_num)).2 (by norm_num) hc
  · exact (h3 5 (by norm_num)).2 (by norm_num) hc
  · exact (h3 6 (by norm_num)).2 (by norm_num) hc
  · exact (h3 7 (by norm_num)).2 (by norm_num) hc

theorem end_ok (hm : cycle_power_dyadic_defective_half_model 4 x e 0) (p : ℤ) :
    x p 0 = true ∧ x p 15 = true := by
  have h := hm.2.1 0 (by omega) p
  simp only [pow_zero, Finset.sum_range_one, Nat.cast_zero, sub_zero, zero_add] at h
  cases h0 : x p 0 <;> cases h7 : x p 15 <;> simp_all

theorem s_small (hm : cycle_power_dyadic_defective_half_model 4 x e 0) (he0 : e 0 = true)
    (c : List Sat.Literal) (h : chkSmall c = true) : (rval x e).satisfies c := by
  unfold chkSmall at h
  split at h
  · rename_i i
    simp only [Bool.or_eq_true, decide_eq_true_eq] at h
    apply sat_of; intro hall
    have h1 : ¬ rval x e i := hall _ (List.Mem.head _)
    apply h1
    unfold rval
    rcases h with ⟨h4, h0 | h15⟩ | rfl
    · have : i = xc (i / 64) 0 := by unfold xc; omega
      rw [this, bval_xc x e _ _ (by omega)]; exact (end_ok x e hm _).1
    · have : i = xc (i / 64) 15 := by unfold xc; omega
      rw [this, bval_xc x e _ _ (by omega)]; exact (end_ok x e hm _).2
    · rw [bval_ec]; simpa [pz] using he0
  · rename_i i j
    simp only [Bool.or_eq_true, decide_eq_true_eq] at h
    apply sat_of; intro hall
    have h1 : rval x e i := hall _ (List.Mem.head _)
    have h2 : ¬ rval x e j := hall _ (List.Mem.tail _ (List.Mem.head _))
    unfold rval at h1 h2
    apply h2
    rcases h with ⟨hi, hj, hq, hp⟩ | ⟨hz, hj | hj⟩
    · have ei : i = xc (i / 64) (i / 4 % 16) := by unfold xc; omega
      have ej : j = xc (i / 64) (j / 4 % 16) := by unfold xc; omega
      rw [ei, bval_xc x e _ _ (by omega)] at h1
      rw [ej, bval_xc x e _ _ (by omega)]
      exact par_ok x e hm _ _ _ hp h1
    · have ei : i = zc (i / 1024) (i / 64 % 16) (i / 4 % 16) := by unfold zc; omega
      rw [ei, bval_zc x e _ _ _ (by omega) (by omega)] at h1
      rw [hj, bval_xc x e _ _ (by omega)]
      simp only [Bool.and_eq_true] at h1; exact h1.1
    · have ei : i = zc (i / 1024) (i / 64 % 16) (i / 4 % 16) := by unfold zc; omega
      rw [ei, bval_zc x e _ _ _ (by omega) (by omega)] at h1
      rw [hj, bval_xc x e _ _ (by omega)]
      simp only [Bool.and_eq_true] at h1; exact h1.2
  · rename_i z i j
    simp only [decide_eq_true_eq] at h
    obtain ⟨hz, hi, hj⟩ := h
    apply sat_of; intro hall
    have h0 : ¬ rval x e z := hall _ (List.Mem.head _)
    have h1 : rval x e i := hall _ (List.Mem.tail _ (List.Mem.head _))
    have h2 : rval x e j := hall _ (List.Mem.tail _ (List.Mem.tail _ (List.Mem.head _)))
    unfold rval at h0 h1 h2
    apply h0
    have ez : z = zc (z / 1024) (z / 64 % 16) (z / 4 % 16) := by unfold zc; omega
    rw [hi, bval_xc x e _ _ (by omega)] at h1
    rw [hj, bval_xc x e _ _ (by omega)] at h2
    rw [ez, bval_zc x e _ _ _ (by omega) (by omega), h1, h2]; rfl
  · simp at h

theorem s_group (hm : cycle_power_dyadic_defective_half_model 4 x e 0)
    (c : List Sat.Literal) (h : chkGroup c = true) : (rval x e).satisfies c := by
  have hf1 : ∀ i, (fun i => (bval x e i).toNat) i ≤ 1 := fun i => Bool.toNat_le _
  unfold chkGroup at h
  split at h
  · rename_i i S hS
    obtain ⟨g, -, hg⟩ := List.any_eq_true.mp h
    simp only [chkNegG, Bool.and_eq_true, decide_eq_true_eq] at hg
    obtain ⟨⟨hv, hex⟩, hnd, hgnd, hsub, hlen⟩ := hg
    apply sat_of; intro hall

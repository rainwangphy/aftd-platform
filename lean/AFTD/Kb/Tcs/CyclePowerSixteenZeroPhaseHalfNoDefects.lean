theorem cycle_power_sixteen_zero_phase_defect_window_refuted (x : ℤ → ℕ → Bool) (e : ℤ → Bool)
    (hm : cycle_power_dyadic_defective_half_model 4 x e 0) (he0 : e 0 = true) : False := by
  have hF : (RT1T16.rval x e).satisfies_fmla RT1T16.c0.formula :=
    RT1T16.s_fmla x e hm he0 _ (by decide +kernel)
  exact RT1T16.c0.sat_proof _ hF

theorem rt1t16_shift (t : ℕ) (y : ℤ → ℕ → Bool) (e : ℤ → Bool) (s : ℤ)
    (h : cycle_power_dyadic_defective_half_model t y e s) (v : ℤ) :
    cycle_power_dyadic_defective_half_model t (fun p a => y (v+p) a) (fun p => e (v+p)) s := by
  rcases h with ⟨hw, hl, ht, hc, hn⟩
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro p
    exact hw (v+p)
  · intro j hj p
    simpa only [add_sub_assoc] using hl j hj (v+p)
  · intro p
    simpa only [add_sub_assoc, add_assoc] using ht (v+p)
  · intro d hd hd8 hd4 p
    obtain ⟨a,ha,ha1,ha2⟩ := hc d hd hd8 hd4 (v+p)
    refine ⟨a, ha, ?_, ?_⟩
    · simpa only [add_sub_assoc] using ha1
    · simpa only [add_sub_assoc] using ha2
  · intro p
    simpa only [add_sub_assoc] using hn (v+p)

theorem cycle_power_sixteen_zero_phase_half_no_defects (y : ℤ → ℕ → Bool) (e : ℤ → Bool)
    (hm : cycle_power_dyadic_defective_half_model 4 y e 0) : ∀ v, e v = false := by
  intro v
  by_contra hv
  have hv' : e v = true := by simpa using hv
  exact cycle_power_sixteen_zero_phase_defect_window_refuted (fun p a => y (v+p) a)
    (fun p => e (v+p)) (rt1t16_shift 4 y e 0 hm v) (by simpa using hv')

theorem cycle_power_thirty_one_double_true_bit_one_refuted_3b28f_m6f_m2t (x : ℤ → ℕ → Bool)
    (htight : ∀ p, cycle_power_dyadic_class_weight (4+1) (x p) =
        (Finset.range (2^(4+1))).sum (fun a => (x p a).toNat))
    (hexact : ∀ j < 4+1, ∀ v : ℤ, (Finset.range (2^j)).sum (fun a =>
        (x (v-(a : ℤ)) a && x (v-(a : ℤ)) (a+2^(4+1)-2^j)).toNat) = 1)
    (hcover : ∀ d : ℕ, 1 ≤ d → d < 2^(4+1) → ∀ v : ℤ,
        ∃ a : ℕ, a < 2^(4+1)-d ∧ x (v-(a : ℤ)) a = true ∧
          x (v-(a : ℤ)) (a+d) = true)
    (hcount : ∀ v : ℤ, (Finset.range (2^(4+1))).sum (fun a =>
        (x (v-(a : ℤ)) a).toNat) = (4+1)+1)
    (hu0 : x (0 : ℤ) 1 = true) (hu1 : x (1 : ℤ) 1 = true) (hu2 : x (3 : ℤ) 28 = false) (hu3 : x (-6 : ℤ) 1 = false) (hu4 : x (-2 : ℤ) 1 = true) : False := by
  have hm : RT1C32.Model x := ⟨htight, hexact, hcover, hcount⟩
  have hP : ∀ i ∈ ([RT1C32.xc 128 1, RT1C32.xc 129 1, RT1C32.xc 126 1] : List ℕ), RT1C32.bval x i = true := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl
    · rw [RT1C32.bval_xc x _ _ (by norm_num)]; simpa [RT1C32.pz] using hu0
    · rw [RT1C32.bval_xc x _ _ (by norm_num)]; simpa [RT1C32.pz] using hu1
    · rw [RT1C32.bval_xc x _ _ (by norm_num)]; simpa [RT1C32.pz] using hu4
  have hN : ∀ i ∈ ([RT1C32.xc 131 28, RT1C32.xc 122 1] : List ℕ), RT1C32.bval x i = false := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl
    · rw [RT1C32.bval_xc x _ _ (by norm_num)]; simpa [RT1C32.pz] using hu2
    · rw [RT1C32.bval_xc x _ _ (by norm_num)]; simpa [RT1C32.pz] using hu3
  have hF : (RT1C32.rval x).satisfies_fmla RT1C32.tt_3b28f_m6f_m2t.formula :=
    RT1C32.s_fmla x hm _ _ hP hN _ (by decide +kernel)
  exact RT1C32.tt_3b28f_m6f_m2t.sat_proof _ hF

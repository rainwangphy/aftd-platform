import AFTD.Prelude
import AFTD.Kb.Tcs.Enc1385Game
import AFTD.Kb.Tcs.TreeGameEdge
import AFTD.Kb.Tcs.PrioritizedBorelGame

/-!
# enc1385ReplayEdges

Topic: automata   Node: aba404885f4e

Provenance: helper lemma. Opponent-block simulation for arXiv:2611.10136, Conjecture 19.

Construct the phase-game edge sequence generated by replaying a finite sequence of direction-priority actions from a given phase position.
-/

noncomputable def enc1385ReplayEdges {Q : Type} [Fintype Q] (G : PrioritizedBorelGame Q 3) : List Bool → Enc1385State Q → List (Bool × Fin 3) → List (TreeGameEdge (Enc1385State Q) 3)
| _, _, [] => []
| node, s, a :: rest => let next := enc1385Step G s a.1; ⟨node,s,a.1,a.2,next⟩ :: enc1385ReplayEdges G (node ++ [a.1]) next rest

import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphIsHop
import AFTD.Kb.Tcs.SimpleGraphLeapGroup
import AFTD.Kb.Tcs.SimpleGraphKayakPaddle
import AFTD.Kb.Tcs.KayakPaddleLeapGroupNeOfEvenSecond
import AFTD.Kb.Tcs.KayakPaddleLeapGroupNeOfEvenFirst

/-!
# kayak_paddle_leap_group_ne_of_even_cycle

Topic: graphs   Node: 1f1b2d15127e

Provenance: original. Related work: arXiv:2610.18463 (The group generated by a graph's derangements), Question 2.20 (and the sentence before it: 'We believe that many, if not all, kayak paddle graphs have leap group equal to either S_n or A_n'); list entry OP-301 (a partial classification).

If one of the two cycles of the kayak paddle graph KP(k, m, l) has even length, its leap group is neither the symmetric nor the alternating group on its vertices.
-/

theorem kayak_paddle_leap_group_ne_of_even_cycle (k m l : ℕ) (hk : 3 ≤ k) (hm : 3 ≤ m) (hl : 1 ≤ l)
    (he : Even k ∨ Even m) :
    simple_graph_leap_group (simple_graph_kayak_paddle k m l) ≠ ⊤ ∧
      simple_graph_leap_group (simple_graph_kayak_paddle k m l) ≠ alternatingGroup _ := by
  rcases he with he | he
  · exact kayak_paddle_leap_group_ne_of_even_first k m l hk hm hl he
  · exact kayak_paddle_leap_group_ne_of_even_second k m l hk hm hl he

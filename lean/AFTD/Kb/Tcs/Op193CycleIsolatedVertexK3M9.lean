def vertex (i : ℕ) : Finset (Fin 9 ⊕ Unit) :=
  verts ⟨i % 57, Nat.mod_lt _ (by decide)⟩

theorem verts_valid : ∀ i : Fin 57,
    ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)).IsNIndepSet 3 (verts i) := by
  decide

def normalization (a b c : Fin 5) : Equiv.Perm (Fin 5) :=
  let e0 := Equiv.swap a 0
  let e1 := Equiv.swap (e0 b) 1
  let e2 := Equiv.swap (e1 (e0 c)) 2
  (e0.trans e1).trans e2

theorem normalization_spec : ∀ a b c : Fin 5, a ≠ b → a ≠ c → b ≠ c →
    normalization a b c a = 0 ∧ normalization a b c b = 1 ∧
    normalization a b c c = 2 := by
  decide

def valuation (c : Fin 57 → Fin 5) : Sat.Valuation :=
  fun n => (c ⟨(n / 5) % 57, Nat.mod_lt _ (by decide)⟩).val = n % 5

def clauseOK : Sat.Clause → Bool
  | [.pos a, .pos b, .pos c, .pos d, .pos e] =>
      a % 5 == 0 && b == a+1 && c == a+2 && d == a+3 && e == a+4
  | [.neg a, .neg b] =>
      a % 5 == b % 5 && decide (Disjoint (vertex (a/5)) (vertex (b/5)))
  | [.pos a] => a == 60 || a == 96 || a == 162
  | _ => false

theorem clauseOK_sound (c : Fin 57 → Fin 5)
    (hproper : ∀ i j, Disjoint (verts i) (verts j) → c i ≠ c j)
    (h0 : c 12 = 0) (h1 : c 19 = 1) (h2 : c 32 = 2)
    (cl : Sat.Clause) (h : clauseOK cl = true) : (valuation c).satisfies cl := by
  rcases cl with _ | ⟨l, rest⟩
  · simp [clauseOK] at h
  rcases rest with _ | ⟨l2, rest⟩
  · cases l with
    | neg a => simp [clauseOK] at h
    | pos a =>
      simp only [clauseOK, Bool.or_eq_true, beq_iff_eq] at h
      rcases h with (h | h) | h <;> subst a
      · simpa [valuation, Sat.Valuation.satisfies, Sat.Valuation.neg] using congrArg Fin.val h0
      · simpa [valuation, Sat.Valuation.satisfies, Sat.Valuation.neg] using congrArg Fin.val h1
      · simpa [valuation, Sat.Valuation.satisfies, Sat.Valuation.neg] using congrArg Fin.val h2
  rcases rest with _ | ⟨l3, rest⟩
  · cases l <;> cases l2 <;> simp only [clauseOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq,
      Bool.false_eq_true, false_and] at h
    next a b =>
      rcases h with ⟨hab, hd⟩
      have hn := hproper ⟨(a/5)%57, Nat.mod_lt _ (by decide)⟩
        ⟨(b/5)%57, Nat.mod_lt _ (by decide)⟩ hd
      intro ha hb
      apply hn
      apply Fin.ext
      dsimp [valuation, Sat.Valuation.neg] at ha hb
      omega
  rcases rest with _ | ⟨l4, rest⟩
  · cases l <;> cases l2 <;> cases l3 <;> simp [clauseOK] at h
  rcases rest with _ | ⟨l5, rest⟩
  · cases l <;> cases l2 <;> cases l3 <;> cases l4 <;> simp [clauseOK] at h
  rcases rest with _ | ⟨l6, rest⟩
  · cases l <;> cases l2 <;> cases l3 <;> cases l4 <;> cases l5 <;>
      simp only [clauseOK, Bool.and_eq_true, beq_iff_eq, Bool.false_eq_true, false_and] at h
    next a b d e f =>
      rcases h with ⟨⟨⟨⟨ha, hb⟩, hd⟩, he⟩, hf⟩
      subst b; subst d; subst e; subst f
      have hdiv1 : (a+1)/5 = a/5 := by omega
      have hdiv2 : (a+2)/5 = a/5 := by omega
      have hdiv3 : (a+3)/5 = a/5 := by omega
      have hdiv4 : (a+4)/5 = a/5 := by omega
      have hmod1 : (a+1)%5 = 1 := by omega
      have hmod2 : (a+2)%5 = 2 := by omega
      have hmod3 : (a+3)%5 = 3 := by omega
      have hmod4 : (a+4)%5 = 4 := by omega
      have bound := (c ⟨(a/5)%57, Nat.mod_lt _ (by decide)⟩).isLt
      simp only [Sat.Valuation.satisfies, Sat.Valuation.neg, valuation,
        hdiv1, hdiv2, hdiv3, hdiv4, ha, hmod1, hmod2, hmod3, hmod4]
      omega
  cases l <;> cases l2 <;> cases l3 <;> cases l4 <;> cases l5 <;>
    cases l6 <;> simp [clauseOK] at h


theorem checked_clauses : in777.formula.all clauseOK = true := by
  decide +kernel

theorem not_five_colorable :
    ¬ (GStableKneser ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)) 3).Colorable 5 := by
  rintro ⟨C⟩
  let raw : Fin 57 → Fin 5 := fun i => C ⟨verts i, verts_valid i⟩
  have hproper : ∀ i j, Disjoint (verts i) (verts j) → raw i ≠ raw j := by
    intro i j hd
    apply C.valid
    refine ⟨hd, ?_⟩
    intro heq
    have hv : verts i = verts j := congrArg Subtype.val heq
    have hn : (verts i).Nonempty := Finset.card_pos.mp (by rw [(verts_valid i).card_eq]; decide)
    obtain ⟨x, hx⟩ := hn
    exact (Finset.disjoint_left.mp hd) hx (by rw [← hv]; exact hx)
  have h01 : raw 12 ≠ raw 19 := hproper _ _ (by decide)
  have h02 : raw 12 ≠ raw 32 := hproper _ _ (by decide)
  have h12 : raw 19 ≠ raw 32 := hproper _ _ (by decide)
  let p := normalization (raw 12) (raw 19) (raw 32)
  let c : Fin 57 → Fin 5 := fun i => p (raw i)
  have hpc : ∀ i j, Disjoint (verts i) (verts j) → c i ≠ c j := by
    intro i j hd heq
    exact hproper i j hd (p.injective heq)
  have hs := normalization_spec (raw 12) (raw 19) (raw 32) h01 h02 h12
  have hF : (valuation c).satisfies_fmla in777.formula := ⟨fun cl hcl =>
    clauseOK_sound c hpc hs.1 hs.2.1 hs.2.2 cl ((List.all_eq_true.mp checked_clauses) cl hcl)⟩
  exact in777.sat_proof _ hF

end Inbox777SAT

/-- Smallest open case of OP-193: the G-stable Kneser graph KG(C_9 ⊔ K_1, 3) has chromatic number 6. -/
theorem op_193_cycle_isolated_vertex_k3_m9 :
    (GStableKneser ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)) 3).chromaticNumber = 6 := by
  have hu : (GStableKneser ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)) 3).chromaticNumber ≤ 6 := by
    have h := op_193_cycle_isolated_vertex_chromatic_le 3 9 (by omega) (by omega)
    have hnum : ((9 : ℕ) : ℕ∞) - 2 * ((3 : ℕ) : ℕ∞) + 3 = 6 := by decide
    rw [hnum] at h
    exact h
  have hn : ¬ (GStableKneser ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)) 3).chromaticNumber ≤ 5 := by
    intro h
    apply Inbox777SAT.not_five_colorable
    exact (SimpleGraph.chromaticNumber_le_iff_colorable (n := 5)).mp h
  have hl : (5 : ℕ∞) < (GStableKneser ((SimpleGraph.cycleGraph 9).sum (⊥ : SimpleGraph Unit)) 3).chromaticNumber := lt_of_not_ge hn
  apply le_antisymm hu
  exact ENat.natCast_add_one_le_iff.mpr hl

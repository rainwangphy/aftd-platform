import AFTD.Prelude
import AFTD.Kb.Tcs.Op309SelectedEdgeGraph

/-!
# op309_canonical_padded_port_classes

Topic: graphs   Node: 367b326176bb

Provenance: helper lemma. OP-309 canonical quotient; retain exactly transitive closures of equalities within selected components.

Every equality between two unselected original edge ports is generated by a chain of equalities occurring within selected-edge components, so no extra global identification is imposed.
-/

def op309_canonical_padded_port_classes
    {V A : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (R : Finset G.edgeSet)
    (q : Sum G.edgeSet (V × Fin 3) → A) : Prop :=
  ∀ e f : G.edgeSet, e ∉ R → f ∉ R → q (.inl e) = q (.inl f) →
    Relation.ReflTransGen
      (fun x y : G.edgeSet =>
        x ∉ R ∧ y ∉ R ∧ q (.inl x) = q (.inl y) ∧
        ∃ a b : V, a ∈ x.1 ∧ b ∈ y.1 ∧
          (R.filter fun g => a ∈ g.1).Nonempty ∧
          (R.filter fun g => b ∈ g.1).Nonempty ∧
          (op309_selected_edge_graph G R).Reachable a b) e f

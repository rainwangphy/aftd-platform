  let incident : List (List Nat) := [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 9, 10], [1, 3, 11], [2, 4, 6], [5, 7, 9], [8, 10, 11]]
  let edgeAdj : List (List Nat) := [[1, 2, 9, 10], [0, 2, 3, 11], [0, 1, 4, 6], [1, 4, 5, 11], [2, 3, 5, 6], [3, 4, 7, 9], [2, 4, 7, 8], [5, 6, 8, 9], [6, 7, 10, 11], [0, 5, 7, 10], [0, 8, 9, 11], [1, 3, 8, 10]]
  let disjoint : List Nat → List Nat → Bool := fun xs ys => xs.all fun x => !(ys.contains x)
  let selectedDominates : List Nat → Bool := fun R =>
    (List.range 12).all fun i => (edgeAdj[i]!).any fun j => R.contains j
  let merge : List Nat → (Nat × Nat) → List Nat := fun q pr =>
    let a := q[pr.1]!
    let b := q[pr.2]!
    q.map fun c => if c = b then a else c
  let classScore : List (List Nat) → List Nat → Nat → Nat := fun groups alive a =>
    (groups.map fun gg => if gg.contains a then (gg.filter fun v => alive.contains v).length - 1 else 0).sum
  let rec peel (groups : List (List Nat)) : Nat → List Nat → List Nat
    | 0, alive => alive
    | fuel+1, alive =>
      match alive.find? (fun a => classScore groups alive a ≤ 4) with
      | none => alive
      | some a => peel groups fuel (alive.erase a)
  let checkOptions : Block → Block → Opt → Opt → Bool := fun b₁ b₂ o₁ o₂ => Id.run do
    let R := b₁.2.1 ++ b₂.2.1
    let q := (o₁.1 ++ o₂.1).foldl merge (List.range 12)
    let unused := (List.range 8).filter fun v => !(b₁.1.contains v || b₂.1.contains v)
    let groups := [o₁.2.map (fun e => q[e]!), o₂.2.map (fun e => q[e]!)] ++
      unused.map (fun v => (incident[v]!).map (fun e => q[e]!))
    if groups.any (fun gg => gg.eraseDups.length != gg.length) then return true
    let classes := ((List.range 12).filter fun e => !(R.contains e)).map (fun e => q[e]!) |>.eraseDups
    return !(peel groups 12 classes).isEmpty
  let checkPair : Block → Block → Bool := fun b₁ b₂ =>
    if !(disjoint b₁.1 b₂.1) || (b₁.2.2.1 && b₂.2.2.1) ||
        !(selectedDominates (b₁.2.1 ++ b₂.2.1)) then true
    else b₁.2.2.2.all fun o₁ => b₂.2.2.2.all fun o₂ => checkOptions b₁ b₂ o₁ o₂

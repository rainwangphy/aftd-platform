def incident : List (List Nat) := [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 9, 10], [1, 3, 11], [2, 4, 6], [5, 7, 9], [8, 10, 11]]
def edgeAdj : List (List Nat) := [[1, 2, 9, 10], [0, 2, 3, 11], [0, 1, 4, 6], [1, 4, 5, 11], [2, 3, 5, 6], [3, 4, 7, 9], [2, 4, 7, 8], [5, 6, 8, 9], [6, 7, 10, 11], [0, 5, 7, 10], [0, 8, 9, 11], [1, 3, 8, 10]]

def disjoint (xs ys : List Nat) : Bool := xs.all fun x => !(ys.contains x)
def selectedDominates (R : List Nat) : Bool :=
  (List.range 12).all fun i => (edgeAdj[i]!).any fun j => R.contains j

def merge (q : List Nat) (pr : Nat × Nat) : List Nat :=
  let a := q[pr.1]!
  let b := q[pr.2]!
  q.map fun c => if c = b then a else c

def classScore (groups : List (List Nat)) (alive : List Nat) (a : Nat) : Nat :=
  (groups.map fun g => if g.contains a then (g.filter fun v => alive.contains v).length - 1 else 0).sum

def peel (groups : List (List Nat)) : Nat → List Nat → List Nat
  | 0, alive => alive
  | fuel+1, alive =>
    match alive.find? (fun a => classScore groups alive a ≤ 4) with
    | none => alive
    | some a => peel groups fuel (alive.erase a)

def checkOptions (b₁ b₂ : Block) (o₁ o₂ : Opt) : Bool := Id.run do
  let R := b₁.edges ++ b₂.edges
  let q := (o₁.pairs ++ o₂.pairs).foldl merge (List.range 12)
  let unused := (List.range 8).filter fun v => !(b₁.vertices.contains v || b₂.vertices.contains v)
  let groups := [o₁.clique.map (fun e => q[e]!), o₂.clique.map (fun e => q[e]!)] ++
    unused.map (fun v => (incident[v]!).map (fun e => q[e]!))
  if groups.any (fun g => g.eraseDups.length != g.length) then return true
  let classes := ((List.range 12).filter fun e => !(R.contains e)).map (fun e => q[e]!) |>.eraseDups
  return !(peel groups 12 classes).isEmpty

def checkPair (b₁ b₂ : Block) : Bool :=
  if !(disjoint b₁.vertices b₂.vertices) || (b₁.long && b₂.long) ||
      !(selectedDominates (b₁.edges ++ b₂.edges)) then true
  else b₁.options.all fun o₁ => b₂.options.all fun o₂ => checkOptions b₁ b₂ o₁ o₂

def checkFirst (b : Block) : Bool :=
  catalog.all (checkPair b)

theorem chunk0 : (((catalog.drop 0).take 10).all checkFirst) = true := by decide
theorem chunk1 : (((catalog.drop 10).take 10).all checkFirst) = true := by decide
theorem chunk2 : (((catalog.drop 20).take 10).all checkFirst) = true := by decide
theorem chunk3 : (((catalog.drop 30).take 10).all checkFirst) = true := by decide

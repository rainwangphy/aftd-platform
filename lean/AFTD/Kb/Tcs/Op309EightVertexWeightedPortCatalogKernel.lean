theorem whole : catalog.all checkFirst = true := by
  have hparts : catalog =
    ((catalog.drop 0).take 10) ++
    ((catalog.drop 10).take 10) ++
    ((catalog.drop 20).take 10) ++
    ((catalog.drop 30).take 10) ++
    ((catalog.drop 40).take 10) ++
    ((catalog.drop 50).take 10) ++
    ((catalog.drop 60).take 10) ++
    ((catalog.drop 70).take 10) := by decide
  rw [hparts]
  simp only [List.all_append, chunk0, chunk1, chunk2, chunk3, chunk4, chunk5, chunk6, chunk7, Bool.and_self]
end In1099Weighted


    simp only [Finset.image_image] at h2
    rw [h1] at h2
    exact h2

theorem op861_threefold_fixed_certificate
    (f g : Finset (Fin 13) → Fin 13)
    (hf : ∀ S, S.card = 7 → f S ∈ S)
    (hg : ∀ S, S.card = 7 → g S ∈ S)
    (hproper : ∀ S T, S.card = 7 → T.card = 7 → (S ∩ T).card ≤ 3 → f S ≠ g T)
    (hrot : ∀ S, S.card = 7 → g (S.image op861cb_rot) = op861cb_rot (g S)) : False := by
  let F : Fin 16 → Fin 13 := fun i => f (op861cb_left i)
  let G : Fin 11 → Fin 13 := fun j => g (op861cb_right j)
  apply op861_symmetry_finite_core_bridge F G
  · intro i
    have hmem : F i ∈ op861cb_left i := hf _ (op861cb_left_card i)
    refine ⟨hmem, ?_⟩
    intro he
    have h12 : 12 ∈ op861cb_left i := by simpa [he] using hmem
    obtain ⟨j, hj⟩ := op861cb_fixed_near i h12
    have hrotfixed : op861cb_rot (g (op861cb_fixed j)) = g (op861cb_fixed j) := by
      have hh := hrot (op861cb_fixed j) (op861cb_fixed_card j)
      rw [op861cb_fixed_rot j] at hh
      exact hh.symm
    have hcol : g (op861cb_fixed j) = 12 := op861cb_fixed_value _ hrotfixed
    have hneq := hproper (op861cb_left i) (op861cb_fixed j)
      (op861cb_left_card i) (op861cb_fixed_card j) hj
    apply hneq
    change F i = g (op861cb_fixed j)
    rw [he, hcol]
  · intro j
    exact hg _ (op861cb_right_card j)
  · intro i j t ht
    have hc : ((op861cb_right j).image (op861cb_pow t)).card = 7 := by
      rw [op861cb_pow_card, op861cb_right_card]
    have hneq := hproper (op861cb_left i) ((op861cb_right j).image (op861cb_pow t))
      (op861cb_left_card i) hc ht
    have heq := op861cb_pow_equivariant g hrot (op861cb_right j) (op861cb_right_card j) t
    change F i ≠ _ at hneq
    rw [heq] at hneq
    exact hneq


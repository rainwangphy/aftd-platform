theorem op861_subtype_from_global
    (f g : {S : Finset (Fin 13) // S.card = 7} → Fin 13)
    (p : Equiv.Perm (Fin 13))
    (hp : ∀ i, p i = (![1,2,0,4,5,3,7,8,6,10,11,9,12] : Fin 13 → Fin 13) i)
    (hf : ∀ S, f S ∈ S.val) (hg : ∀ S, g S ∈ S.val)
    (hfg : ∀ S T, (S.val ∩ T.val).card ≤ 3 → f S ≠ g T)
    (hsym : ∀ S : {S : Finset (Fin 13) // S.card = 7},
      g ⟨S.val.map p.toEmbedding, by simpa using S.property⟩ = p (g S))
    (hglobal : ∀ (ff gg : Finset (Fin 13) → Fin 13),
      (∀ S, S.card = 7 → ff S ∈ S) →
      (∀ S, S.card = 7 → gg S ∈ S) →
      (∀ S T, S.card = 7 → T.card = 7 → (S ∩ T).card ≤ 3 → ff S ≠ gg T) →
      (∀ S, S.card = 7 → gg (S.image op861cb_rot) = op861cb_rot (gg S)) → False) : False := by
  classical
  let ff : Finset (Fin 13) → Fin 13 := fun S => if h : S.card = 7 then f ⟨S,h⟩ else 0
  let gg : Finset (Fin 13) → Fin 13 := fun S => if h : S.card = 7 then g ⟨S,h⟩ else 0
  apply hglobal ff gg
  · intro S hs
    simpa [ff, hs] using hf ⟨S, hs⟩
  · intro S hs
    simpa [gg, hs] using hg ⟨S, hs⟩
  · intro S T hs ht hst
    simpa [ff, gg, hs, ht] using hfg ⟨S,hs⟩ ⟨T,ht⟩ hst
  · intro S hs
    have hfun : (p : Fin 13 → Fin 13) = op861cb_rot := by
      funext i
      simpa [op861cb_rot] using hp i
    have hcard : (S.image op861cb_rot).card = 7 := by
      rw [Finset.card_image_of_injective _ op861cb_rot_inj, hs]
    have heq : S.map p.toEmbedding = S.image op861cb_rot := by
      rw [Finset.map_eq_image]
      exact congrArg S.image hfun
    have hh := hsym ⟨S, hs⟩
    simp only [heq, hfun] at hh
    simpa [gg, hs, hcard] using hh

theorem op861_no_threefold_right_equivariant_k7_r3 (f g : {S : Finset (Fin 13) // S.card = 7} → Fin 13) (p : Equiv.Perm (Fin 13)) (hp : ∀ i, p i = (![1,2,0,4,5,3,7,8,6,10,11,9,12] : Fin 13 → Fin 13) i) (hf : ∀ S, f S ∈ S.val) (hg : ∀ S, g S ∈ S.val) (hfg : ∀ S T, (S.val ∩ T.val).card ≤ 3 → f S ≠ g T) (hsym : ∀ S : {S : Finset (Fin 13) // S.card = 7}, g ⟨S.val.map p.toEmbedding, by simpa using S.property⟩ = p (g S)) : False := by
  exact op861_subtype_from_global f g p hp hf hg hfg hsym op861_threefold_fixed_certificate

theorem op861cb_pow_equivariant (g : Finset (Fin 13) → Fin 13)
    (hrot : ∀ S, S.card = 7 → g (S.image op861cb_rot) = op861cb_rot (g S))
    (S : Finset (Fin 13)) (hS : S.card = 7) (t : Fin 3) :
    g (S.image (op861cb_pow t)) = op861cb_pow t (g S) := by
  have hp0 : op861cb_pow 0 = id := by
    funext x
    simp [op861cb_pow]
  have hp1 : op861cb_pow 1 = op861cb_rot := by
    funext x
    simp [op861cb_pow]
  have hp2 : op861cb_pow 2 = op861cb_rot ∘ op861cb_rot := by
    funext x
    simp [op861cb_pow]
  fin_cases t
  · change g (S.image (op861cb_pow 0)) = op861cb_pow 0 (g S)
    rw [hp0]
    simp
  · change g (S.image (op861cb_pow 1)) = op861cb_pow 1 (g S)
    rw [hp1]
    exact hrot S hS
  · change g (S.image (op861cb_pow 2)) = op861cb_pow 2 (g S)
    rw [hp2]
    have h1 := hrot S hS
    have hs : (S.image op861cb_rot).card = 7 := by
      have h := op861cb_pow_card S (1 : Fin 3)
      rw [hp1, hS] at h

    1867942097327864262818865284, 435020126824178816][d.val]!

def validWordState (x : WordState) : Prop :=
  x.a < 4 ∧ x.b < 4 ∧ x.u < 4 ∧ x.c < 4 ∧
  x.a ≠ x.b ∧ x.a ≠ x.u ∧ x.b ≠ x.u ∧
  ∃ t, t < 2 ∧ t ≠ x.a ∧ t ≠ x.b ∧ t ≠ x.u
instance (x : WordState) : Decidable (validWordState x) := by
  unfold validWordState
  infer_instance

def initialWordState (d : Nat) (x : WordState) : Prop :=
  x.c ≠ x.a ∧ x.c ≠ x.b ∧ (d = x.b ∨ d = x.c) ∧
  x.used = (x.c == x.u)
instance (d : Nat) (x : WordState) : Decidable (initialWordState d x) := by
  unfold initialWordState
  infer_instance

def closingWordState (d : Nat) (x : WordState) : Prop :=
  x.used = true ∧ x.c ≠ x.a ∧ (d = x.c ∨ d = x.a)
instance (d : Nat) (x : WordState) : Decidable (closingWordState d x) := by
  unfold closingWordState
  infer_instance

theorem all_word_states_valid (i : Fin 96) : validWordState wordStates[i.val]! := by
  revert i
  decide

theorem initial_mask_correct (d : Fin 4) (i : Fin 96) :
  (initialMask d).testBit i.val = decide (initialWordState d.val wordStates[i.val]!) := by
  revert d i
  decide

theorem closing_mask_correct (d : Fin 4) (i : Fin 96) :
  closing[d.val]!.testBit i.val = decide (closingWordState d.val wordStates[i.val]!) := by
  revert d i
  decide
end In1051Cert


def closing : Array Nat := #[621397353053053628184701096,2485589412212214515332417544,9942357656516916370005303328,13049344420335381055952420992]
def advance (mask d : Nat) : Nat :=
  (List.range 96).foldl (fun out i => if mask.testBit i then out ||| ((trans[d]!)[i]!) else out) 0

def stepCode (key d : Nat) : Nat :=
  let mask := key / 12
  let parity := (key % 6) / 3
  let pat := key % 3
  let nextPat := if pat < 2 ∧ d = 1-pat then d else 2
  let accepted := if mask &&& (closing[d]!) != 0 then 6 else 0
  (advance mask d) * 12 + accepted + (1-parity) * 3 + nextPat

def checkCode (key : Nat) : Bool :=
  let accepted := (key % 12) / 6
  let parity := (key % 6) / 3
  let pat := key % 3
  (if parity = 0 then ((accepted == 1) == (pat == 2)) else true) &&
  ([0,1,2,3] : List Nat).all (fun d => certMember (stepCode key d) certTree)


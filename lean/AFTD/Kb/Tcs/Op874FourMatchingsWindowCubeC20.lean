  rintro ⟨f, h, hP, ⟨u0, u1, u2, u3⟩⟩
  have hF : (IN1204.val f h).satisfies_fmla IN1204.c20.formula :=
    IN1204.fmla_sound f h hP [Sat.Literal.pos (IN1204.Fa 10 0), Sat.Literal.pos (IN1204.Fa 11 1), Sat.Literal.pos (IN1204.Fa 12 2), Sat.Literal.pos (IN1204.Fa 13 0)] (by
      intro l hl
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hl
      rcases hl with rfl | rfl | rfl | rfl
      · exact IN1204.sat_pos f h _ _ u0
      · exact IN1204.sat_pos f h _ _ u1
      · exact IN1204.sat_pos f h _ _ u2
      · exact IN1204.sat_pos f h _ _ u3
      ) _ (by decide +kernel)
  exact IN1204.c20.sat_proof _ hF

theorem op874_tight_nontriangle_minority_disjoint_four_window_obstruction :
    let mate : Fin 12 → Fin 12 := ![8,10,6,9,7,11,2,4,0,3,1,5]
    let bit : Fin 12 → Bool := ![false,true,false,true,true,true,false,true,false,true,true,true]
    let opposite : Fin 12 → Fin 6 := fun i => if bit i then 4 else 5
    ¬ ∃ (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6),
      (∀ i, w (i-1) ≠ w i) ∧
      Function.Injective ![w 11,w 0,w 7,w 8] ∧
      Function.Injective ![w 1,w 2,w 5,w 6] ∧
      (∀ i, Function.Injective (h i)) ∧
      (∀ i p, h i p ≠ (if bit i then 5 else 4) ∧
        h i p ≠ Fin.castAdd 2 (w (i-1)) ∧ h i p ≠ Fin.castAdd 2 (w i)) ∧
      (∀ i, h i 0 ≠ h (i+1) 1 ∧ h i 0 ≠ h (i+1) 2 ∧
        h i 2 ≠ h (i+1) 1 ∧ h i 2 ≠ h (i+1) 2) ∧
      (∀ i, h i 0 ≠ h (mate i) 0 ∧ h i 0 ≠ h (mate i) 1 ∧
        h i 1 ≠ h (mate i) 0 ∧ h i 1 ≠ h (mate i) 1) ∧
      (∀ i, ¬ (h i 2 = opposite i ∧ h (mate i) 2 = opposite i)) ∧
      (∀ i, (∀ j : Fin 4,
        h (i+(Fin.castAdd 8 j)) 1 ≠ opposite (i+(Fin.castAdd 8 j)) ∧
        h (i+(Fin.castAdd 8 j)+1) 0 ≠ opposite (i+(Fin.castAdd 8 j)+1)) →
        ∀ c : Fin 4, ∃ k : Fin 6, w (i-1+(Fin.castAdd 6 k)) = c) := by
  intro mate bit opposite
  rintro ⟨w, h, hP⟩
  obtain ⟨w', h', hP', hu⟩ := in1233_symm w h hP
  have heq : (in1233_c0.formula : List (List Sat.Literal)) = in1233_cl :=
    in1233_fb_eq _ _ (by decide +kernel)
  have hF : (in1233_val w' h').satisfies_fmla in1233_c0.formula :=
    ⟨fun c hc => in1233_sound w' h' hP' hu c (by rw [← heq]; exact hc)⟩
  exact in1233_c0.sat_proof _ hF

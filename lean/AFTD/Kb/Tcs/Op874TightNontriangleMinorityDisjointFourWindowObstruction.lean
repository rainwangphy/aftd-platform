import AFTD.Prelude
import AFTD.Kb.GameTheoryEconomics.TotalPreorder
import AFTD.Kb.GameTheoryEconomics.LinearOrderToTotalPreorder
import AFTD.Kb.Tcs.C

/-!
# op874_tight_nontriangle_minority_disjoint_four_window_obstruction

Topic: graphs   Node: 069a01793102

Provenance: helper lemma. Nontriangle minority-palette obstruction for OP-874; https://arxiv.org/abs/2610.41950.

For the displayed tight cut on a Hamiltonian factor, neither minority matching edge lies in a triangle, but requiring disjoint high palettes on both is incompatible with exact ownership and the four-window condition.
-/

def in1233_mate : Fin 12 → Fin 12 := ![8,10,6,9,7,11,2,4,0,3,1,5]
def in1233_bit : Fin 12 → Bool := ![false,true,false,true,true,true,false,true,false,true,true,true]
def in1233_opp : Fin 12 → Fin 6 := fun i => if in1233_bit i then 4 else 5
def in1233_forb : Fin 12 → Fin 6 := fun i => if in1233_bit i then 5 else 4

def in1233_Wa (i : Fin 12) (c : Fin 4) : ℕ := 1 + 4 * i.val + c.val
def in1233_Ha (i : Fin 12) (p : Fin 3) (x : Fin 6) : ℕ := 49 + 18 * i.val + 6 * p.val + x.val

def in1233_pairs (n : ℕ) : List (Fin n × Fin n) :=
  ((List.finRange n).flatMap fun a => (List.finRange n).map fun b => (a, b)).filter
    (fun ab => decide (ab.1 < ab.2))

open Sat in
def in1233_cl : List (List Literal) :=
  ((List.finRange 12).map fun i => (List.finRange 4).map fun c => Literal.pos (in1233_Wa i c)) ++
  ((List.finRange 12).flatMap fun i => (in1233_pairs 4).map fun ab =>
    [Literal.neg (in1233_Wa i ab.1), Literal.neg (in1233_Wa i ab.2)]) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 3).map fun p =>
    (List.finRange 6).map fun x => Literal.pos (in1233_Ha i p x)) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 3).flatMap fun p => (in1233_pairs 6).map fun ab =>
    [Literal.neg (in1233_Ha i p ab.1), Literal.neg (in1233_Ha i p ab.2)]) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 4).map fun c =>
    [Literal.neg (in1233_Wa (i - 1) c), Literal.neg (in1233_Wa i c)]) ++
  (([(11,0),(11,7),(11,8),(0,7),(0,8),(7,8),(1,2),(1,5),(1,6),(2,5),(2,6),(5,6)] :
      List (Fin 12 × Fin 12)).flatMap fun ab => (List.finRange 4).map fun c =>
    [Literal.neg (in1233_Wa ab.1 c), Literal.neg (in1233_Wa ab.2 c)]) ++
  ((List.finRange 12).flatMap fun i => (in1233_pairs 3).flatMap fun pq => (List.finRange 6).map fun x =>
    [Literal.neg (in1233_Ha i pq.1 x), Literal.neg (in1233_Ha i pq.2 x)]) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 3).map fun p =>
    [Literal.neg (in1233_Ha i p (in1233_forb i))]) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 3).flatMap fun p => (List.finRange 4).flatMap fun c =>
    [[Literal.neg (in1233_Ha i p (Fin.castAdd 2 c)), Literal.neg (in1233_Wa (i - 1) c)],
     [Literal.neg (in1233_Ha i p (Fin.castAdd 2 c)), Literal.neg (in1233_Wa i c)]]) ++
  ((List.finRange 12).flatMap fun i =>
    ([(0,1),(0,2),(2,1),(2,2)] : List (Fin 3 × Fin 3)).flatMap fun pq => (List.finRange 6).map fun x =>
    [Literal.neg (in1233_Ha i pq.1 x), Literal.neg (in1233_Ha (i + 1) pq.2 x)]) ++
  ((List.finRange 12).flatMap fun i =>
    ([(0,0),(0,1),(1,0),(1,1)] : List (Fin 3 × Fin 3)).flatMap fun pq => (List.finRange 6).map fun x =>
    [Literal.neg (in1233_Ha i pq.1 x), Literal.neg (in1233_Ha (in1233_mate i) pq.2 x)]) ++
  ((List.finRange 12).map fun i =>
    [Literal.neg (in1233_Ha i 2 (in1233_opp i)), Literal.neg (in1233_Ha (in1233_mate i) 2 (in1233_opp i))]) ++
  ((List.finRange 12).flatMap fun i => (List.finRange 4).map fun c =>
    ((List.finRange 4).map fun j =>
        Literal.pos (in1233_Ha (i + Fin.castAdd 8 j) 1 (in1233_opp (i + Fin.castAdd 8 j)))) ++
    ((List.finRange 4).map fun j =>
        Literal.pos (in1233_Ha (i + Fin.castAdd 8 j + 1) 0 (in1233_opp (i + Fin.castAdd 8 j + 1)))) ++
    ((List.finRange 6).map fun k => Literal.pos (in1233_Wa (i - 1 + Fin.castAdd 6 k) c))) ++
  [[Literal.pos (in1233_Wa 11 0)], [Literal.pos (in1233_Wa 0 1)], [Literal.pos (in1233_Wa 7 2)],
   [Literal.pos (in1233_Wa 8 3)]]

def in1233_P (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) : Prop :=
  (∀ i, w (i-1) ≠ w i) ∧
  Function.Injective ![w 11,w 0,w 7,w 8] ∧
  Function.Injective ![w 1,w 2,w 5,w 6] ∧
  (∀ i, Function.Injective (h i)) ∧
  (∀ i p, h i p ≠ (if in1233_bit i then 5 else 4) ∧
    h i p ≠ Fin.castAdd 2 (w (i-1)) ∧ h i p ≠ Fin.castAdd 2 (w i)) ∧
  (∀ i, h i 0 ≠ h (i+1) 1 ∧ h i 0 ≠ h (i+1) 2 ∧
    h i 2 ≠ h (i+1) 1 ∧ h i 2 ≠ h (i+1) 2) ∧
  (∀ i, h i 0 ≠ h (in1233_mate i) 0 ∧ h i 0 ≠ h (in1233_mate i) 1 ∧
    h i 1 ≠ h (in1233_mate i) 0 ∧ h i 1 ≠ h (in1233_mate i) 1) ∧
  (∀ i, ¬ (h i 2 = in1233_opp i ∧ h (in1233_mate i) 2 = in1233_opp i)) ∧
  (∀ i, (∀ j : Fin 4,
    h (i+(Fin.castAdd 8 j)) 1 ≠ in1233_opp (i+(Fin.castAdd 8 j)) ∧
    h (i+(Fin.castAdd 8 j)+1) 0 ≠ in1233_opp (i+(Fin.castAdd 8 j)+1)) →
    ∀ c : Fin 4, ∃ k : Fin 6, w (i-1+(Fin.castAdd 6 k)) = c)

theorem in1233_inj4 {α : Type*} {a b c d : α} (h : Function.Injective ![a, b, c, d]) :
    a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d := by
  refine ⟨fun e => ?_, fun e => ?_, fun e => ?_, fun e => ?_, fun e => ?_, fun e => ?_⟩
  · exact absurd (@h 0 1 (by simp [e])) (by decide)
  · exact absurd (@h 0 2 (by simp [e])) (by decide)
  · exact absurd (@h 0 3 (by simp [e])) (by decide)
  · exact absurd (@h 1 2 (by simp [e])) (by decide)
  · exact absurd (@h 1 3 (by simp [e])) (by decide)
  · exact absurd (@h 2 3 (by simp [e])) (by decide)

/-- Colour symmetry: normalise the first window palette. -/
theorem in1233_symm (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) (hP : in1233_P w h) :
    ∃ w' h', in1233_P w' h' ∧ w' 11 = 0 ∧ w' 0 = 1 ∧ w' 7 = 2 ∧ w' 8 = 3 := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hP
  have hb : Function.Bijective ![w 11, w 0, w 7, w 8] := Finite.injective_iff_bijective.mp h2
  let σ : Fin 4 ≃ Fin 4 := (Equiv.ofBijective _ hb).symm
  have hσ : ∀ j : Fin 4, σ (![w 11, w 0, w 7, w 8] j) = j := fun j =>
    (Equiv.ofBijective _ hb).symm_apply_apply j
  let τ : Fin 6 → Fin 6 := fun x => if hx : x.val < 4 then Fin.castAdd 2 (σ ⟨x.val, hx⟩) else x
  have τc : ∀ c : Fin 4, τ (Fin.castAdd 2 c) = Fin.castAdd 2 (σ c) := by
    intro c
    simp only [τ, Fin.val_castAdd, c.isLt, dite_true]
  have τhi : ∀ x : Fin 6, 4 ≤ x.val → τ x = x := by
    intro x hx
    simp only [τ, dif_neg (show ¬ x.val < 4 by omega)]
  have τinj : Function.Injective τ := by
    intro x y hxy
    by_cases hx : x.val < 4 <;> by_cases hy : y.val < 4
    · have := congrArg Fin.val hxy
      simp only [τ, dif_pos hx, dif_pos hy, Fin.val_castAdd] at this
      have := σ.injective (Fin.ext this)
      exact Fin.ext (by simpa using congrArg Fin.val this)
    · have := congrArg Fin.val hxy
      simp only [τ, dif_pos hx, dif_neg hy, Fin.val_castAdd] at this
      have := (σ ⟨x.val, hx⟩).isLt
      omega
    · have := congrArg Fin.val hxy
      simp only [τ, dif_neg hx, dif_pos hy, Fin.val_castAdd] at this
      have := (σ ⟨y.val, hy⟩).isLt
      omega
    · simpa [τ, dif_neg hx, dif_neg hy] using hxy
  have τopp : ∀ i, τ (in1233_opp i) = in1233_opp i := by
    intro i; apply τhi; unfold in1233_opp; split_ifs <;> decide
  have τforb : ∀ i, τ (if in1233_bit i then 5 else 4) = (if in1233_bit i then 5 else 4) := by
    intro i; apply τhi; split_ifs <;> decide
  refine ⟨fun i => σ (w i), fun i p => τ (h i p), ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
    hσ 0, hσ 1, hσ 2, hσ 3⟩
  · intro i; exact σ.injective.ne (h1 i)
  · have : (![σ (w 11), σ (w 0), σ (w 7), σ (w 8)] : Fin 4 → Fin 4) = σ ∘ ![w 11, w 0, w 7, w 8] := by
      funext j; fin_cases j <;> rfl
    rw [this]; exact σ.injective.comp h2
  · have : (![σ (w 1), σ (w 2), σ (w 5), σ (w 6)] : Fin 4 → Fin 4) = σ ∘ ![w 1, w 2, w 5, w 6] := by
      funext j; fin_cases j <;> rfl
    rw [this]; exact σ.injective.comp h3
  · intro i; exact τinj.comp (h4 i)
  · intro i p
    obtain ⟨a, b, c⟩ := h5 i p
    refine ⟨?_, ?_, ?_⟩
    · rw [← τforb i]; exact τinj.ne a
    · rw [← τc]; exact τinj.ne b
    · rw [← τc]; exact τinj.ne c
  · intro i
    obtain ⟨a, b, c, d⟩ := h6 i
    exact ⟨τinj.ne a, τinj.ne b, τinj.ne c, τinj.ne d⟩
  · intro i
    obtain ⟨a, b, c, d⟩ := h7 i
    exact ⟨τinj.ne a, τinj.ne b, τinj.ne c, τinj.ne d⟩
  · intro i ⟨a, b⟩
    rw [← τopp i] at a b
    exact h8 i ⟨τinj a, τinj b⟩
  · intro i hw c
    obtain ⟨k, hk⟩ := h9 i (fun j => by
      obtain ⟨a, b⟩ := hw j
      refine ⟨fun e => a (by show τ (h _ _) = _; rw [e, τopp]), fun e => b (by show τ (h _ _) = _; rw [e, τopp])⟩) (σ.symm c)
    exact ⟨k, by simp only [hk, Equiv.apply_symm_apply]⟩

def in1233_val (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) : Sat.Valuation := fun n =>
  (∃ i c, n = in1233_Wa i c ∧ w i = c) ∨ (∃ i p x, n = in1233_Ha i p x ∧ h i p = x)

theorem in1233_valW (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) (i : Fin 12) (c : Fin 4) :
    in1233_val w h (in1233_Wa i c) ↔ w i = c := by
  constructor
  · rintro (⟨i', c', e, hw⟩ | ⟨i', p, x, e, -⟩)
    · unfold in1233_Wa at e
      have h1 : i = i' := Fin.ext (by omega)
      have h2 : c = c' := Fin.ext (by omega)
      rw [h1, h2]; exact hw
    · unfold in1233_Wa in1233_Ha at e
      omega
  · intro hw; exact Or.inl ⟨i, c, rfl, hw⟩

theorem in1233_valH (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) (i : Fin 12) (p : Fin 3)
    (x : Fin 6) : in1233_val w h (in1233_Ha i p x) ↔ h i p = x := by
  constructor
  · rintro (⟨i', c', e, -⟩ | ⟨i', p', x', e, hh⟩)
    · unfold in1233_Wa in1233_Ha at e
      omega
    · unfold in1233_Ha at e
      have h1 : i = i' := Fin.ext (by omega)
      have h2 : p = p' := Fin.ext (by omega)
      have h3 : x = x' := Fin.ext (by omega)
      rw [h1, h2, h3]; exact hh
  · intro hh; exact Or.inr ⟨i, p, x, rfl, hh⟩

theorem in1233_sat_of (v : Sat.Valuation) (c : Sat.Clause)
    (h : (∀ l, List.Mem l c → v.neg l) → False) : v.satisfies c := by
  change List Sat.Literal at c
  induction c with
  | nil => exact h (fun l hl => by cases hl)
  | cons a as ih =>
    intro ha
    exact ih (fun hall => h (fun l hl => by
      cases hl with
      | head => exact ha
      | tail _ hl => exact hall l hl))

theorem in1233_sound (w : Fin 12 → Fin 4) (h : Fin 12 → Fin 3 → Fin 6) (hP : in1233_P w h)
    (hu : w 11 = 0 ∧ w 0 = 1 ∧ w 7 = 2 ∧ w 8 = 3) :
    ∀ c ∈ in1233_cl, (in1233_val w h).satisfies c := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hP
  have vW := in1233_valW w h
  have vH := in1233_valH w h
  intro c hc
  apply in1233_sat_of
  intro hall
  have hn : ∀ n, List.Mem (Sat.Literal.neg n) c → in1233_val w h n := fun n hm => hall _ hm
  have hp : ∀ n, List.Mem (Sat.Literal.pos n) c → ¬ in1233_val w h n := fun n hm => hall _ hm
  simp only [in1233_cl, List.mem_append, List.mem_flatMap, List.mem_map, List.mem_finRange,
    true_and, List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false] at hc
  rcases hc with ((((((((((((⟨i, rfl⟩ | ⟨i, ab, hab, rfl⟩) | ⟨i, p, rfl⟩) | ⟨i, p, ab, hab, rfl⟩) |
    ⟨i, c, rfl⟩) | ⟨ab, hab, c, rfl⟩) | ⟨i, pq, hpq, x, rfl⟩) | ⟨i, p, rfl⟩) |
    ⟨i, p, c, rfl | rfl⟩) | ⟨i, pq, hpq, x, rfl⟩) | ⟨i, pq, hpq, x, rfl⟩) | ⟨i, rfl⟩) |
    ⟨i, c, rfl⟩) | (rfl | rfl | rfl | rfl)
  · exact hp _ (List.mem_map.2 ⟨w i, List.mem_finRange _, rfl⟩) ((vW _ _).2 rfl)
  · simp only [in1233_pairs, List.mem_filter, List.mem_flatMap, List.mem_map, List.mem_finRange,
      true_and, decide_eq_true_eq] at hab
    obtain ⟨⟨a, b, rfl⟩, hlt⟩ := hab
    have ea := (vW _ _).1 (hn _ (List.Mem.head _))
    have eb := (vW _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact absurd (ea.symm.trans eb) (ne_of_lt hlt)
  · exact hp _ (List.mem_map.2 ⟨h i p, List.mem_finRange _, rfl⟩) ((vH _ _ _).2 rfl)
  · simp only [in1233_pairs, List.mem_filter, List.mem_flatMap, List.mem_map, List.mem_finRange,
      true_and, decide_eq_true_eq] at hab
    obtain ⟨⟨a, b, rfl⟩, hlt⟩ := hab
    have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vH _ _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact absurd (ea.symm.trans eb) (ne_of_lt hlt)
  · have ea := (vW _ _).1 (hn _ (List.Mem.head _))
    have eb := (vW _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact h1 i (ea.trans eb.symm)
  · have ea := (vW _ _).1 (hn _ (List.Mem.head _))
    have eb := (vW _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    have hne := ea.trans eb.symm
    obtain ⟨d1, d2, d3, d4, d5, d6⟩ := in1233_inj4 h2
    obtain ⟨e1, e2, e3, e4, e5, e6⟩ := in1233_inj4 h3
    rcases hab with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact d1 hne
    · exact d2 hne
    · exact d3 hne
    · exact d4 hne
    · exact d5 hne
    · exact d6 hne
    · exact e1 hne
    · exact e2 hne
    · exact e3 hne
    · exact e4 hne
    · exact e5 hne
    · exact e6 hne
  · simp only [in1233_pairs, List.mem_filter, List.mem_flatMap, List.mem_map, List.mem_finRange,
      true_and, decide_eq_true_eq] at hpq
    obtain ⟨⟨a, b, rfl⟩, hlt⟩ := hpq
    have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vH _ _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact absurd (h4 i (ea.trans eb.symm)) (ne_of_lt hlt)
  · exact (h5 i p).1 ((vH _ _ _).1 (hn _ (List.Mem.head _)))
  · have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vW _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact (h5 i p).2.1 (by rw [ea, eb])
  · have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vW _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact (h5 i p).2.2 (by rw [ea, eb])
  · have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vH _ _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    have hne := ea.trans eb.symm
    obtain ⟨d1, d2, d3, d4⟩ := h6 i
    rcases hpq with rfl | rfl | rfl | rfl
    · exact d1 hne
    · exact d2 hne
    · exact d3 hne
    · exact d4 hne
  · have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vH _ _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    have hne := ea.trans eb.symm
    obtain ⟨d1, d2, d3, d4⟩ := h7 i
    rcases hpq with rfl | rfl | rfl | rfl
    · exact d1 hne
    · exact d2 hne
    · exact d3 hne
    · exact d4 hne
  · have ea := (vH _ _ _).1 (hn _ (List.Mem.head _))
    have eb := (vH _ _ _).1 (hn _ (List.Mem.tail _ (List.Mem.head _)))
    exact h8 i ⟨ea, eb⟩
  · obtain ⟨k, hk⟩ := h9 i (fun j => ⟨fun e => hp _ (by
        apply List.mem_append_left; apply List.mem_append_left
        exact List.mem_map.2 ⟨j, List.mem_finRange _, rfl⟩) ((vH _ _ _).2 e),
      fun e => hp _ (by
        apply List.mem_append_left; apply List.mem_append_right
        exact List.mem_map.2 ⟨j, List.mem_finRange _, rfl⟩) ((vH _ _ _).2 e)⟩) c
    exact hp _ (by
        apply List.mem_append_right
        exact List.mem_map.2 ⟨k, List.mem_finRange _, rfl⟩) ((vW _ _).2 hk)
  · exact hp _ (List.Mem.head _) ((vW _ _).2 hu.1)
  · exact hp _ (List.Mem.head _) ((vW _ _).2 hu.2.1)
  · exact hp _ (List.Mem.head _) ((vW _ _).2 hu.2.2.1)
  · exact hp _ (List.Mem.head _) ((vW _ _).2 hu.2.2.2)

def in1233_lb : Sat.Literal → Sat.Literal → Bool
  | .pos a, .pos b => a == b
  | .neg a, .neg b => a == b
  | _, _ => false

def in1233_cb : List Sat.Literal → List Sat.Literal → Bool
  | [], [] => true
  | a :: as, b :: bs => in1233_lb a b && in1233_cb as bs
  | _, _ => false

def in1233_fb : List (List Sat.Literal) → List (List Sat.Literal) → Bool
  | [], [] => true
  | a :: as, b :: bs => in1233_cb a b && in1233_fb as bs
  | _, _ => false

theorem in1233_lb_eq : ∀ a b : Sat.Literal, in1233_lb a b = true → a = b
  | .pos a, .pos b, h => by simp only [in1233_lb, beq_iff_eq] at h; rw [h]
  | .neg a, .neg b, h => by simp only [in1233_lb, beq_iff_eq] at h; rw [h]
  | .pos _, .neg _, h => by simp [in1233_lb] at h
  | .neg _, .pos _, h => by simp [in1233_lb] at h

theorem in1233_cb_eq : ∀ a b : List Sat.Literal, in1233_cb a b = true → a = b
  | [], [], _ => rfl
  | a :: as, b :: bs, h => by
    simp only [in1233_cb, Bool.and_eq_true] at h
    rw [in1233_lb_eq a b h.1, in1233_cb_eq as bs h.2]
  | [], _ :: _, h => by simp [in1233_cb] at h
  | _ :: _, [], h => by simp [in1233_cb] at h

theorem in1233_fb_eq : ∀ a b : List (List Sat.Literal), in1233_fb a b = true → a = b
  | [], [], _ => rfl
  | a :: as, b :: bs, h => by
    simp only [in1233_fb, Bool.and_eq_true] at h
    rw [in1233_cb_eq a b h.1, in1233_fb_eq as bs h.2]
  | [], _ :: _, h => by simp [in1233_fb] at h
  | _ :: _, [], h => by simp [in1233_fb] at h

open Lean Elab Command in
elab "in1233_lrat_core " nm:ident ppSpace cnf:term:max ppSpace lrat:term:max : command => do
  Command.liftTermElabM do
    let cnf ← unsafe Lean.Elab.Term.evalTerm String (mkConst ``String) cnf
    let lrat ← unsafe Lean.Elab.Term.evalTerm String (mkConst ``String) lrat
    let (_,ctx,_,proof) ← Mathlib.Tactic.Sat.fromLRATAux cnf lrat nm.getId
    addDecl <| Declaration.defnDecl {
      name := nm.getId ++ `formula, levelParams := [], type := mkConst ``Sat.Fmla, value := ctx,
      hints := ReducibilityHints.abbrev, safety := DefinitionSafety.safe }

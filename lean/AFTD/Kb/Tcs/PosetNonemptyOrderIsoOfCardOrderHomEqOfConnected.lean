import AFTD.Prelude
import AFTD.Kb.Tcs.PosetOrderIsoOfInjectiveOrderHoms
import AFTD.Kb.GameTheoryEconomics.ArenaReachableTrans

/-!
# poset_nonempty_order_iso_of_card_order_hom_eq_of_connected

Topic: combinatorics   Node: 14dd503c08a3

Provenance: formalization of a published result. Source: arXiv:2610.20802 (Two short proofs of the A^A theorem), Lemma 2.4.

Let X and Y be finite posets (possibly empty). If for every finite nonempty connected poset Z the number of order-preserving maps Z → X equals the number of order-preserving maps Z → Y, then X and Y are order-isomorphic. (A poset is connected when its comparability graph is.)
-/

noncomputable section

/-- `IsPosetRel r` says that `r` is a partial order: reflexive, transitive, antisymmetric. -/
def IsPosetRel {α : Type*} (r : α → α → Prop) : Prop :=
  (∀ a, r a a) ∧ (∀ a b c, r a b → r b c → r a c) ∧ (∀ a b, r a b → r b a → a = b)

/-- The number of maps `A → B` preserving the relations `rA` and `rB`. -/
def PosetHomCount (A B : Type*) (rA : A → A → Prop) (rB : B → B → Prop) : ℕ :=
  Nat.card {f : A → B // ∀ a b, rA a b → rB (f a) (f b)}

/-- The number of injective maps `A → B` preserving the relations `rA` and `rB`. -/
def PosetInjCount (A B : Type*) (rA : A → A → Prop) (rB : B → B → Prop) : ℕ :=
  Nat.card {f : A → B // Function.Injective f ∧ ∀ a b, rA a b → rB (f a) (f b)}

/-- A finite type carries only finitely many setoids. -/
instance poset_hom_count_instFintypeSetoid {α : Type*} [Fintype α] : Fintype (Setoid α) := by
  classical
  exact Fintype.ofInjective (fun s : Setoid α => {p : α × α | s p.1 p.2}) (by
    intro s t h
    refine Setoid.ext (fun a b => ?_)
    have h' := Set.ext_iff.mp h (a, b)
    simpa using h')

/-- Setoids on a type are classically distinguishable. -/
instance poset_hom_count_instDecidableEqSetoid {α : Type*} : DecidableEq (Setoid α) :=
  Classical.decEq _

/-- The quotient of a finite type by a setoid is finite. -/
instance poset_hom_count_instFintypeQuotient {W : Type*} [Fintype W] (π : Setoid W) :
    Fintype (Quotient π) := by
  classical
  exact Fintype.ofSurjective (Quotient.mk π) (fun x => by
    obtain ⟨a, ha⟩ := Quotient.exists_rep x
    exact ⟨a, ha⟩)

/-- The relation-preserving map count agrees with the number of order homomorphisms. -/
theorem poset_hom_count_eq_orderHom_card {A B : Type*} [Preorder A] [Preorder B] :
    PosetHomCount A B (·≤·) (·≤·) = Nat.card (A →o B) := by
  unfold PosetHomCount
  exact Nat.card_congr
    { toFun := fun f => ⟨f.1, f.2⟩
      invFun := fun g => ⟨g.1, g.monotone'⟩
      left_inv := fun f => rfl
      right_inv := fun g => rfl }

/-- A relation-preserving map out of an empty type is unique. -/
theorem poset_hom_count_eq_one_of_isEmpty {W X : Type*} [IsEmpty W] (r : W → W → Prop)
    (rX : X → X → Prop) : PosetHomCount W X r rX = 1 := by
  haveI : Subsingleton {f : W → X // ∀ a b, r a b → rX (f a) (f b)} :=
    ⟨fun f g => Subtype.ext (funext fun w => (IsEmpty.false w).elim)⟩
  haveI : Nonempty {f : W → X // ∀ a b, r a b → rX (f a) (f b)} :=
    ⟨⟨fun w => (IsEmpty.false w).elim, fun a => (IsEmpty.false a).elim⟩⟩
  rw [PosetHomCount, Nat.card_unique]

/-- The kernel of a function, as a setoid. -/
def funKernel {W X : Type*} (f : W → X) : Setoid W :=
  Setoid.mk (fun a b => f a = f b) ⟨fun _ => rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- `IsKernelOf f π` says that the setoid `π` is exactly the kernel of `f`. -/
def IsKernelOf {W X : Type*} (f : W → X) (π : Setoid W) : Prop :=
  ∀ a b : W, π a b ↔ f a = f b

/-- The preorder on `Quotient π` generated by `r` (reflexive-transitive closure). -/
def quotRel {W : Type*} (r : W → W → Prop) (π : Setoid W) : Quotient π → Quotient π → Prop :=
  fun x y => Relation.ReflTransGen
    (fun x y => ∃ a b : W, x = Quotient.mk π a ∧ y = Quotient.mk π b ∧ r a b) x y

/-- `quotRel` is reflexive. -/
theorem quotRel_refl {W : Type*} (r : W → W → Prop) (π : Setoid W) (x : Quotient π) :
    quotRel r π x x := Relation.ReflTransGen.refl

/-- `quotRel` is transitive. -/
theorem quotRel_trans {W : Type*} (r : W → W → Prop) (π : Setoid W) :
    ∀ x y z, quotRel r π x y → quotRel r π y z → quotRel r π x z :=
  fun _ _ _ => Relation.ReflTransGen.trans

/-- The quotient map is monotone for `quotRel`. -/
theorem quotRel_of_le {W : Type*} (r : W → W → Prop) (π : Setoid W) {a b : W}
    (h : r a b) : quotRel r π (Quotient.mk π a) (Quotient.mk π b) :=
  Relation.ReflTransGen.single ⟨a, b, rfl, rfl, h⟩

/-- `quotRel` is contained in every reflexive transitive relation containing the lifted `r`. -/
theorem quotRel_minimal {W : Type*} (r : W → W → Prop) (π : Setoid W)
    {s : Quotient π → Quotient π → Prop}
    (hrefl : ∀ x, s x x) (htrans : ∀ x y z, s x y → s y z → s x z)
    (hbase : ∀ a b : W, r a b → s (Quotient.mk π a) (Quotient.mk π b))
    {x y : Quotient π} (h : quotRel r π x y) : s x y := by
  haveI : Std.Refl s := ⟨hrefl⟩
  haveI : IsTrans (Quotient π) s := ⟨htrans⟩
  have h2 : Relation.ReflTransGen s x y :=
    (Relation.ReflTransGen.mono
      (r := fun x y => ∃ a b : W, x = Quotient.mk π a ∧ y = Quotient.mk π b ∧ r a b)
      (p := s) (fun x y hxy => by
        obtain ⟨a, b, hx, hy, hr⟩ := hxy
        rw [hx, hy]
        exact hbase a b hr)) x y h
  rwa [Relation.reflTransGen_eq_self] at h2

/-- The bottom-setoid term, read back on representatives. -/
theorem quotRel_bot_out {W : Type*} (r : W → W → Prop)
    (hrefl : ∀ a, r a a) (htrans : ∀ a b c, r a b → r b c → r a c)
    {q q' : Quotient (⊥ : Setoid W)} (h : quotRel r ⊥ q q') : r q.out q'.out := by
  classical
  refine quotRel_minimal (s := fun x y => r x.out y.out) r ⊥ (fun x => hrefl _)
    (fun x y z => htrans _ _ _) (fun a b hab => ?_) h
  have ha : (Quotient.mk (⊥ : Setoid W) a).out = a :=
    show (Quotient.mk (⊥ : Setoid W) a).out = a from
      Quotient.exact (Quotient.out_eq (Quotient.mk (⊥ : Setoid W) a))
  have hb : (Quotient.mk (⊥ : Setoid W) b).out = b :=
    show (Quotient.mk (⊥ : Setoid W) b).out = b from
      Quotient.exact (Quotient.out_eq (Quotient.mk (⊥ : Setoid W) b))
  rw [ha, hb]
  exact hab

/-- Kernel factorisation: monotone maps with kernel `π` are the injective monotone maps on `W/π`. -/
def poset_hom_count_fiberEquiv {W X : Type*} [Preorder X] (r : W → W → Prop) (π : Setoid W) :
    {f : W → X // (∀ a b, r a b → f a ≤ f b) ∧ IsKernelOf f π} ≃
      {g : Quotient π → X // Function.Injective g ∧ ∀ x y, quotRel r π x y → g x ≤ g y} where
  toFun f :=
    ⟨Quotient.lift f.1 (fun a b hab => (f.2.2 a b).mp hab),
     ⟨fun x y hxy => by
        induction x using Quotient.ind with
        | _ a =>
          induction y using Quotient.ind with
          | _ b =>
            rw [Quotient.lift_mk, Quotient.lift_mk] at hxy
            exact Quotient.sound ((f.2.2 a b).mpr hxy),
      fun x y hxy => by
        refine quotRel_minimal (s := fun x y =>
          Quotient.lift f.1 (fun a b hab => (f.2.2 a b).mp hab) x
            ≤ Quotient.lift f.1 (fun a b hab => (f.2.2 a b).mp hab) y) r π
          (fun x => le_refl _) (fun x y z => le_trans) (fun a b hab => ?_) hxy
        rw [Quotient.lift_mk, Quotient.lift_mk]
        exact f.2.1 a b hab⟩⟩
  invFun g :=
    ⟨fun a => g.1 (Quotient.mk π a),
     ⟨fun a b hab => g.2.2 _ _ (quotRel_of_le r π hab),
      fun a b => ⟨fun h => congrArg g.1 (Quotient.sound h),
        fun h => Quotient.exact (g.2.1 h)⟩⟩⟩
  left_inv f := by
    refine Subtype.ext (funext fun a => ?_)
    simp only [Quotient.lift_mk]
  right_inv g := by
    refine Subtype.ext (funext fun q => ?_)
    induction q using Quotient.ind with
    | _ a => simp only [Quotient.lift_mk]

/-- Fibres of the kernel map are the pointwise kernel condition. -/
def poset_hom_count_kernelEquiv {W X : Type*} [Preorder X] (r : W → W → Prop) (π : Setoid W) :
    {f : {f : W → X // ∀ a b, r a b → f a ≤ f b} // funKernel f.1 = π} ≃
      {f : W → X // (∀ a b, r a b → f a ≤ f b) ∧ IsKernelOf f π} where
  toFun f := ⟨f.1.1, f.1.2, fun a b => (Setoid.ext_iff.mp f.2 a b).symm⟩
  invFun f := ⟨⟨f.1, f.2.1⟩, Setoid.ext (fun a b => (f.2.2 a b).symm)⟩
  left_inv f := by
    refine Subtype.ext (Subtype.ext rfl)
  right_inv f := by
    refine Subtype.ext rfl

/-- The fibre decomposition `Hom(W, X) = ∑_π Inj(W/π, X)`. -/
theorem poset_hom_count_eq_sum {W X : Type*} [Fintype W] [Fintype X] [Preorder X]
    (r : W → W → Prop) :
    PosetHomCount W X r (·≤·) = ∑ π : Setoid W, PosetInjCount (Quotient π) X (quotRel r π) (·≤·) := by
  classical
  have h1 : PosetHomCount W X r (·≤·) =
      Nat.card (Σ π : Setoid W, {f : {f : W → X // ∀ a b, r a b → f a ≤ f b} // funKernel f.1 = π}) :=
    Nat.card_congr (Equiv.sigmaFiberEquiv (fun f : {f : W → X // ∀ a b, r a b → f a ≤ f b} => funKernel f.1)).symm
  rw [h1, Nat.card_sigma]
  refine Finset.sum_congr rfl (fun π _ => ?_)
  exact Nat.card_congr ((poset_hom_count_kernelEquiv r π).trans (poset_hom_count_fiberEquiv r π))

/-- The bottom-setoid term of the fibre sum is the count of injective maps. -/
def poset_inj_count_botEquiv {W X : Type*} [Preorder X] (r : W → W → Prop)
    (hrefl : ∀ a, r a a) (htrans : ∀ a b c, r a b → r b c → r a c) :
    {g : Quotient (⊥ : Setoid W) → X // Function.Injective g ∧ ∀ x y, quotRel r ⊥ x y → g x ≤ g y} ≃
      {f : W → X // Function.Injective f ∧ ∀ a b, r a b → f a ≤ f b} where
  toFun g :=
    ⟨fun a => g.1 (Quotient.mk (⊥ : Setoid W) a),
     ⟨fun a b hab => by
        have h2 : Quotient.mk (⊥ : Setoid W) a = Quotient.mk (⊥ : Setoid W) b := g.2.1 hab
        exact Quotient.exact h2,
      fun a b hab => g.2.2 _ _ (quotRel_of_le r ⊥ hab)⟩⟩
  invFun g :=
    ⟨fun q => g.1 q.out,
     ⟨fun q q' hqq => by
        have h2 : q.out = q'.out := g.2.1 hqq
        calc q = Quotient.mk (⊥ : Setoid W) q.out := (Quotient.out_eq q).symm
          _ = Quotient.mk (⊥ : Setoid W) q'.out := by rw [h2]
          _ = q' := Quotient.out_eq q',
      fun q q' hqq => g.2.2 _ _ (quotRel_bot_out r hrefl htrans hqq)⟩⟩
  left_inv g := by
    classical
    refine Subtype.ext (funext fun q => ?_)
    show g.1 (Quotient.mk (⊥ : Setoid W) q.out) = g.1 q
    rw [Quotient.out_eq q]
  right_inv g := by
    classical
    refine Subtype.ext (funext fun a => ?_)
    show g.1 ((Quotient.mk (⊥ : Setoid W) a).out) = g.1 a
    rw [show (Quotient.mk (⊥ : Setoid W) a).out = a from
      Quotient.exact (Quotient.out_eq (Quotient.mk (⊥ : Setoid W) a))]

/-- The bottom-setoid term of the fibre sum is the number of injective maps. -/
theorem poset_inj_count_eq_bot_term {W X : Type*} [Fintype W] [Fintype X] [Preorder X]
    (r : W → W → Prop) (hrefl : ∀ a, r a a) (htrans : ∀ a b c, r a b → r b c → r a c) :
    PosetInjCount W X r (·≤·) = PosetInjCount (Quotient (⊥ : Setoid W)) X (quotRel r ⊥) (·≤·) :=
  (Nat.card_congr (poset_inj_count_botEquiv r hrefl htrans)).symm

/-- Splitting off the injective part: `Hom = Inj + ∑_{π ≠ ⊥} Inj(W/π)`. -/
theorem poset_hom_count_eq_inj_count_add {W X : Type*} [Fintype W] [Fintype X] [Preorder X]
    (r : W → W → Prop) (hr : IsPosetRel r) :
    PosetHomCount W X r (·≤·) = PosetInjCount W X r (·≤·) +
      ∑ π ∈ Finset.univ.erase (⊥ : Setoid W), PosetInjCount (Quotient π) X (quotRel r π) (·≤·) := by
  classical
  rw [poset_hom_count_eq_sum r,
    show (∑ π : Setoid W, PosetInjCount (Quotient π) X (quotRel r π) (·≤·))
      = PosetInjCount (Quotient (⊥ : Setoid W)) X (quotRel r ⊥) (·≤·)
        + ∑ π ∈ Finset.univ.erase (⊥ : Setoid W), PosetInjCount (Quotient π) X (quotRel r π) (·≤·) from
      (Finset.add_sum_erase _ _ (Finset.mem_univ _)).symm,
    ← poset_inj_count_eq_bot_term (X := X) r hr.1 hr.2.1]

/-- A split of the vertex set with no comparability across it multiplies the counts. -/
def poset_hom_count_splitEquiv {W X : Type*} [Preorder X] (r : W → W → Prop) (S : Set W)
    (hcross : ∀ a ∈ S, ∀ b, b ∉ S → ¬ r a b ∧ ¬ r b a) :
    {f : W → X // ∀ a b, r a b → f a ≤ f b} ≃
      ({g : {a // a ∈ S} → X // ∀ a b, r a.1 b.1 → g a ≤ g b} ×
       {g : {b // b ∉ S} → X // ∀ a b, r a.1 b.1 → g a ≤ g b}) := by
  classical
  exact
    { toFun := fun f =>
        ⟨⟨fun a => f.1 a.1, fun a b hab => f.2 a.1 b.1 hab⟩,
         ⟨fun a => f.1 a.1, fun a b hab => f.2 a.1 b.1 hab⟩⟩
      invFun := fun p =>
        ⟨fun w => if hw : w ∈ S then p.1.1 ⟨w, hw⟩ else p.2.1 ⟨w, hw⟩, by
          intro a b hab
          by_cases ha : a ∈ S
          · by_cases hb : b ∈ S
            · simp only [dif_pos ha, dif_pos hb]
              exact p.1.2 ⟨a, ha⟩ ⟨b, hb⟩ hab
            · exact absurd hab (hcross a ha b hb).1
          · by_cases hb : b ∈ S
            · exact absurd hab (hcross b hb a ha).2
            · simp only [dif_neg ha, dif_neg hb]
              exact p.2.2 ⟨a, ha⟩ ⟨b, hb⟩ hab⟩
      left_inv := fun f => by
        refine Subtype.ext (funext fun w => ?_)
        by_cases hw : w ∈ S
        · simp only [dif_pos hw]
        · simp only [dif_neg hw]
      right_inv := fun p => by
        refine Prod.ext ?_ ?_
        · refine Subtype.ext (funext fun a => ?_)
          simp only [dif_pos a.2]
        · refine Subtype.ext (funext fun b => ?_)
          simp only [dif_neg b.2] }

/-- Multiplicativity of the homomorphism count across a split with no cross relations. -/
theorem poset_hom_count_mul_of_split {W X : Type*} [Fintype W] [Preorder X] (r : W → W → Prop)
    (S : Set W) (hcross : ∀ a ∈ S, ∀ b, b ∉ S → ¬ r a b ∧ ¬ r b a) :
    PosetHomCount W X r (·≤·) =
      PosetHomCount {a // a ∈ S} X (fun a b => r a.1 b.1) (·≤·) *
      PosetHomCount {b // b ∉ S} X (fun a b => r a.1 b.1) (·≤·) := by
  refine (Nat.card_congr (poset_hom_count_splitEquiv r S hcross)).trans ?_
  rw [Nat.card_prod]
  rfl

/-- A non-antisymmetric relation on the source forces the injective count to vanish. -/
theorem poset_inj_count_eq_zero_of_not_antisymm {Q X : Type*} [PartialOrder X]
    (s : Q → Q → Prop) (h : ¬ ∀ a b : Q, s a b → s b a → a = b) :
    PosetInjCount Q X s (·≤·) = 0 := by
  unfold PosetInjCount
  rw [Nat.card_eq_zero]
  left
  push Not at h
  obtain ⟨a, b, hab, hba, hne⟩ := h
  refine ⟨fun g => ?_⟩
  have h1 : g.1 a ≤ g.1 b := g.2.2 a b hab
  have h2 : g.1 b ≤ g.1 a := g.2.2 b a hba
  exact hne (g.2.1 (le_antisymm h1 h2))

/-- A quotient by a setoid other than the discrete one has strictly fewer elements. -/
theorem poset_card_quotient_lt {W : Type*} [Fintype W] (π : Setoid W) (hπ : π ≠ ⊥) :
    Nat.card (Quotient π) < Nat.card W := by
  classical
  have hsurj : Function.Surjective (Quotient.mk π) := fun x => by
    obtain ⟨a, ha⟩ := Quotient.exists_rep x
    exact ⟨a, ha⟩
  have hle : Nat.card (Quotient π) ≤ Nat.card W := Nat.card_le_card_of_surjective _ hsurj
  rcases lt_or_eq_of_le hle with h | h
  · exact h
  · exfalso
    apply hπ
    have hcard : Fintype.card W = Fintype.card (Quotient π) := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, h]
    have hinj : Function.Injective (Quotient.mk π) :=
      ((Fintype.bijective_iff_surjective_and_card _).mpr ⟨hsurj, hcard⟩).1
    refine Setoid.ext (fun a b => ⟨fun hab => ?_, fun hab => ?_⟩)
    · exact hinj (Quotient.sound hab)
    · exact Quotient.exact (by rw [hab])

end

theorem poset_nonempty_order_iso_of_card_order_hom_eq_of_connected {X Y : Type}
    [Fintype X] [PartialOrder X] [Fintype Y] [PartialOrder Y]
    (h : ∀ (Z : Type) [Fintype Z] [Nonempty Z] [PartialOrder Z],
      (SimpleGraph.fromRel fun a b : Z => a ≤ b).Connected →
        Nat.card (Z →o X) = Nat.card (Z →o Y)) :
    Nonempty (X ≃o Y) := by
  classical
  have key : ∀ n, ∀ (W : Type) [Fintype W] (r : W → W → Prop), IsPosetRel r → Nat.card W = n →
      (PosetHomCount W X r (·≤·) = PosetHomCount W Y r (·≤·) ∧
       PosetInjCount W X r (·≤·) = PosetInjCount W Y r (·≤·)) := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro W _ r hr hW
      have hhom : PosetHomCount W X r (·≤·) = PosetHomCount W Y r (·≤·) := by
        by_cases hempty : IsEmpty W
        · haveI : IsEmpty W := hempty
          rw [poset_hom_count_eq_one_of_isEmpty r (·≤·), poset_hom_count_eq_one_of_isEmpty r (·≤·)]
        · haveI : Nonempty W := not_isEmpty_iff.mp hempty
          by_cases hconn : (SimpleGraph.fromRel (fun a b : W => r a b)).Connected
          · letI : Preorder W :=
              { le := r
                lt := fun a b => r a b ∧ ¬ r b a
                le_refl := hr.1
                le_trans := hr.2.1
                lt_iff_le_not_ge := fun a b => Iff.rfl }
            letI : PartialOrder W := PartialOrder.mk hr.2.2
            calc PosetHomCount W X r (·≤·) = Nat.card (W →o X) := poset_hom_count_eq_orderHom_card
              _ = Nat.card (W →o Y) := h W hconn
              _ = PosetHomCount W Y r (·≤·) := poset_hom_count_eq_orderHom_card.symm
          · have hpre : ¬ ∀ u v : W, (SimpleGraph.fromRel (fun a b : W => r a b)).Reachable u v :=
              fun hpp => hconn (SimpleGraph.Connected.mk hpp)
            obtain ⟨u, huu⟩ := not_forall.mp hpre
            obtain ⟨v, huv⟩ := not_forall.mp huu
            let S : Set W := {x | (SimpleGraph.fromRel (fun a b : W => r a b)).Reachable u x}
            haveI hdec : DecidablePred S := fun x => Classical.propDecidable (x ∈ S)
            have huS : u ∈ S := ⟨SimpleGraph.Walk.nil⟩
            have hvS : v ∉ S := huv
            have hcross : ∀ a ∈ S, ∀ b, b ∉ S → ¬ r a b ∧ ¬ r b a := by
              intro a ha b hb
              have hane : a ≠ b := fun he => hb (he ▸ ha)
              exact ⟨fun hrab => hb (ha.trans (SimpleGraph.Adj.reachable ⟨hane, Or.inl hrab⟩)),
                fun hrba => hb (ha.trans (SimpleGraph.Adj.reachable ⟨hane, Or.inr hrba⟩))⟩
            have hsum : Nat.card {a // a ∈ S} + Nat.card {b // b ∉ S} = n := by
              rw [← hW]
              exact (Nat.card_sum (α := {a // a ∈ S}) (β := {b // b ∉ S})).symm.trans
                (Nat.card_congr (Equiv.sumCompl S))
            have hposB : 0 < Nat.card {b // b ∉ S} := by
              haveI : Nonempty {b // b ∉ S} := ⟨⟨v, hvS⟩⟩
              exact Nat.card_pos
            have hposA : 0 < Nat.card {a // a ∈ S} := by
              haveI : Nonempty {a // a ∈ S} := ⟨⟨u, huS⟩⟩
              exact Nat.card_pos
            have hcardA : Nat.card {a // a ∈ S} < n := by
              have h2 := Nat.lt_add_of_pos_right hposB (n := Nat.card {a // a ∈ S})
              rwa [hsum] at h2
            have hcardB : Nat.card {b // b ∉ S} < n := by
              have h2 := Nat.lt_add_of_pos_right hposA (n := Nat.card {b // b ∉ S})
              rw [Nat.add_comm] at h2
              rwa [hsum] at h2
            refine (poset_hom_count_mul_of_split (X := X) r S hcross).trans ?_
            rw [poset_hom_count_mul_of_split (X := Y) r S hcross]
            congr 1
            · exact (ih _ hcardA {a // a ∈ S} (fun a b => r a.1 b.1)
                ⟨fun a => hr.1 a.1, fun a b c hab hbc => hr.2.1 _ _ _ hab hbc,
                 fun a b hab hba => Subtype.ext (hr.2.2 _ _ hab hba)⟩ rfl).1
            · exact (ih _ hcardB {b // b ∉ S} (fun a b => r a.1 b.1)
                ⟨fun a => hr.1 a.1, fun a b c hab hbc => hr.2.1 _ _ _ hab hbc,
                 fun a b hab hba => Subtype.ext (hr.2.2 _ _ hab hba)⟩ rfl).1
      have hinj : PosetInjCount W X r (·≤·) = PosetInjCount W Y r (·≤·) := by
        have hX := poset_hom_count_eq_inj_count_add (X := X) r hr
        have hY := poset_hom_count_eq_inj_count_add (X := Y) r hr
        have hrest : ∑ π ∈ Finset.univ.erase (⊥ : Setoid W),
              PosetInjCount (Quotient π) X (quotRel r π) (·≤·)
            = ∑ π ∈ Finset.univ.erase (⊥ : Setoid W),
              PosetInjCount (Quotient π) Y (quotRel r π) (·≤·) := by
          refine Finset.sum_congr rfl (fun π hπ => ?_)
          have hne : π ≠ ⊥ := Finset.ne_of_mem_erase hπ
          have hlt : Nat.card (Quotient π) < n := by
            rw [← hW]
            exact poset_card_quotient_lt π hne
          by_cases hanti : ∀ a b : Quotient π, quotRel r π a b → quotRel r π b a → a = b
          · exact (ih (Nat.card (Quotient π)) hlt (Quotient π) (quotRel r π)
              ⟨quotRel_refl r π, quotRel_trans r π, hanti⟩ rfl).2
          · rw [poset_inj_count_eq_zero_of_not_antisymm (X := X) (quotRel r π) hanti,
                poset_inj_count_eq_zero_of_not_antisymm (X := Y) (quotRel r π) hanti]
        rw [hX, hY] at hhom
        rw [hrest] at hhom
        exact Nat.add_right_cancel hhom
      exact ⟨hhom, hinj⟩
  have hposX : IsPosetRel (α := X) (·≤·) :=
    ⟨fun a => le_refl a, fun a b c hab hbc => le_trans hab hbc, fun a b hab hba => le_antisymm hab hba⟩
  have hposY : IsPosetRel (α := Y) (·≤·) :=
    ⟨fun a => le_refl a, fun a b c hab hbc => le_trans hab hbc, fun a b hab hba => le_antisymm hab hba⟩
  have hXX : PosetInjCount X X (·≤·) (·≤·) = PosetInjCount X Y (·≤·) (·≤·) :=
    (key (Nat.card X) X (·≤·) hposX rfl).2
  have hYY : PosetInjCount Y Y (·≤·) (·≤·) = PosetInjCount Y X (·≤·) (·≤·) :=
    (key (Nat.card Y) Y (·≤·) hposY rfl).2.symm
  have hidX : 0 < PosetInjCount X X (·≤·) (·≤·) := by
    rw [PosetInjCount, Nat.card_eq_fintype_card, Fintype.card_pos_iff]
    exact ⟨⟨id, fun a b h => h, fun a b h => h⟩⟩
  have hidY : 0 < PosetInjCount Y Y (·≤·) (·≤·) := by
    rw [PosetInjCount, Nat.card_eq_fintype_card, Fintype.card_pos_iff]
    exact ⟨⟨id, fun a b h => h, fun a b h => h⟩⟩
  have h1 : 0 < PosetInjCount X Y (·≤·) (·≤·) := hXX ▸ hidX
  have h2 : 0 < PosetInjCount Y X (·≤·) (·≤·) := hYY ▸ hidY
  unfold PosetInjCount at h1 h2
  obtain ⟨⟨f, hfinj, hfmono⟩⟩ := (Nat.card_pos_iff.mp h1).1
  obtain ⟨⟨g, hginj, hgmono⟩⟩ := (Nat.card_pos_iff.mp h2).1
  exact poset_order_iso_of_injective_order_homs ⟨f, hfmono⟩ ⟨g, hgmono⟩ hfinj hginj

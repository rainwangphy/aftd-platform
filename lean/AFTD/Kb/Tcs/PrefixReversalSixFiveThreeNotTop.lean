import AFTD.Prelude
import AFTD.Kb.Tcs.PrefixReversal

/-!
# prefix_reversal_six_five_three_not_top

Topic: combinatorics   Node: 719cb9125a73

Provenance: helper lemma. arXiv:2610.30892

In the symmetric group Equiv.Perm (Fin 6), the subgroup generated by the three prefix reversals of lengths 3, 5, and 6 does not equal the full symmetric group.
-/

/-- The subgroup of `Equiv.Perm (Fin 6)` consisting of the permutations that change the parity
of every index by one fixed constant `c` (a homomorphism to `ZMod 2`). -/
def prefix_reversal_six_five_three_not_top_K : Subgroup (Equiv.Perm (Fin 6)) where
  carrier := {σ | ∃ c : ZMod 2, ∀ x : Fin 6, ((σ x).val : ZMod 2) = (x.val : ZMod 2) + c}
  one_mem' := by
    refine ⟨0, ?_⟩
    intro x
    simp
  mul_mem' := by
    rintro σ τ ⟨c, hc⟩ ⟨d, hd⟩
    refine ⟨c + d, ?_⟩
    intro x
    show (((σ * τ) x).val : ZMod 2) = (x.val : ZMod 2) + (c + d)
    rw [show (σ * τ) x = σ (τ x) from rfl, hc, hd]
    ring
  inv_mem' := by
    rintro σ ⟨c, hc⟩
    refine ⟨-c, ?_⟩
    intro x
    have h : ((x.val : ZMod 2)) = ((σ⁻¹ x).val : ZMod 2) + c := by simpa using hc (σ⁻¹ x)
    rw [h]
    ring

/-- The subgroup of Equiv.Perm (Fin 6) generated by prefix reversals of lengths 3, 5, 6 is a proper subgroup. -/
theorem prefix_reversal_six_five_three_not_top :
    Subgroup.closure {prefixReversal 6 3, prefixReversal 6 5, prefixReversal 6 6} ≠ (⊤ : Subgroup (Equiv.Perm (Fin 6))) := by
  intro htop
  have hgen : {prefixReversal 6 3, prefixReversal 6 5, prefixReversal 6 6} ⊆
      (prefix_reversal_six_five_three_not_top_K : Set (Equiv.Perm (Fin 6))) := by
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · change ∃ c : ZMod 2, ∀ x : Fin 6, ((prefixReversal 6 3 x).val : ZMod 2) = (x.val : ZMod 2) + c
      decide
    · change ∃ c : ZMod 2, ∀ x : Fin 6, ((prefixReversal 6 5 x).val : ZMod 2) = (x.val : ZMod 2) + c
      decide
    · change ∃ c : ZMod 2, ∀ x : Fin 6, ((prefixReversal 6 6 x).val : ZMod 2) = (x.val : ZMod 2) + c
      decide
  have hle : Subgroup.closure {prefixReversal 6 3, prefixReversal 6 5, prefixReversal 6 6} ≤
      prefix_reversal_six_five_three_not_top_K := by
    rw [Subgroup.closure_le]
    exact hgen
  have htopK : prefix_reversal_six_five_three_not_top_K = ⊤ := by
    rw [htop] at hle
    exact le_antisymm le_top hle
  have hswap : (Equiv.swap (0 : Fin 6) 1) ∉ prefix_reversal_six_five_three_not_top_K := by
    change ¬ (∃ c : ZMod 2, ∀ x : Fin 6, (((Equiv.swap (0 : Fin 6) 1) x).val : ZMod 2) = (x.val : ZMod 2) + c)
    decide
  have hmem : (Equiv.swap (0 : Fin 6) 1) ∈ prefix_reversal_six_five_three_not_top_K := by
    rw [htopK]
    exact Subgroup.mem_top _
  exact hswap hmem

import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphIsHopClosed
import AFTD.Kb.Tcs.SimpleGraphIsLeapClosed
import AFTD.Kb.Tcs.MatroidIsFlatInter
import AFTD.Kb.Tcs.SimpleGraphCompleteGraphThreeHopClosedNotIntersectionClosed
import AFTD.Kb.Tcs.SimpleGraphCompleteGraphThreeLeapClosedNotIntersectionClosed

/-!
# simple_graph_hop_or_leap_maximal_not_matroid_flats

Topic: graphs   Node: 7ffca175a38d

Provenance: formalization of a published result. Source: arXiv:2610.18463 Question 5.9: The group generated by a graph's derangements

Neither the collection of hop-closed edge subsets nor the collection of leap-closed edge subsets forms the set of flats of a matroid for every finite simple graph G.
-/

/-- Refutation of OP-302: neither hop-maximal nor leap-maximal edge sets generally form the flats of a matroid. -/
theorem simple_graph_hop_or_leap_maximal_not_matroid_flats :
    (¬ ∀ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V),
      ∃ (M : Matroid (Sym2 V)), M.E = G.edgeSet ∧ ∀ F, M.IsFlat F ↔ simple_graph_is_hop_closed G F) ∧
    (¬ ∀ {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V),
      ∃ (M : Matroid (Sym2 V)), M.E = G.edgeSet ∧ ∀ F, M.IsFlat F ↔ simple_graph_is_leap_closed G F) := by
  constructor
  · intro h
    rcases simple_graph_completeGraph_three_hop_closed_not_intersection_closed with
      ⟨F₁, F₂, h₁, h₂, hnot⟩
    rcases h (⊤ : SimpleGraph (Fin 3)) with ⟨M, _hE, hflat⟩
    have hf₁ : M.IsFlat F₁ := (hflat F₁).2 h₁
    have hf₂ : M.IsFlat F₂ := (hflat F₂).2 h₂
    have hfint : M.IsFlat (F₁ ∩ F₂) := matroid_isFlat_inter M hf₁ hf₂
    exact hnot ((hflat (F₁ ∩ F₂)).1 hfint)
  · intro h
    rcases simple_graph_completeGraph_three_leap_closed_not_intersection_closed with
      ⟨F₁, F₂, h₁, h₂, hnot⟩
    rcases h (⊤ : SimpleGraph (Fin 3)) with ⟨M, _hE, hflat⟩
    have hf₁ : M.IsFlat F₁ := (hflat F₁).2 h₁
    have hf₂ : M.IsFlat F₂ := (hflat F₂).2 h₂
    have hfint : M.IsFlat (F₁ ∩ F₂) := matroid_isFlat_inter M hf₁ hf₂
    exact hnot ((hflat (F₁ ∩ F₂)).1 hfint)

import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphIsHop

/-!
# simple_graph_is_hop_inv

Topic: graphs   Node: 1488a52b7b38

Provenance: helper lemma. Sanity lemma for hops, arXiv:2610.18463 (The group generated by a graph's derangements), Sec. 2.1 (the inverse of a hop is a hop, so Λ₃ = Λ₁).

The inverse of a hop is a hop (the graph is undirected).
-/

theorem simple_graph_is_hop_inv {V : Type*} (G : SimpleGraph V) (h : Equiv.Perm V)
    (hh : simple_graph_is_hop G h) : simple_graph_is_hop G h⁻¹ := by
  intro v
  simpa using (hh (h⁻¹ v)).symm

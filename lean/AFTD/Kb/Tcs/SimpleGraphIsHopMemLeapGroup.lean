import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphIsHop
import AFTD.Kb.Tcs.SimpleGraphLeapGroup

/-!
# simple_graph_is_hop_mem_leap_group

Topic: graphs   Node: 9bdee077cae9

Provenance: helper lemma. Sanity lemma for the leap group, arXiv:2610.18463 (The group generated by a graph's derangements), Definition 2.1.

Every hop lies in the leap group.
-/

theorem simple_graph_is_hop_mem_leap_group {V : Type*} (G : SimpleGraph V) (h : Equiv.Perm V)
    (hh : simple_graph_is_hop G h) : h ∈ simple_graph_leap_group G :=
  Subgroup.subset_closure hh

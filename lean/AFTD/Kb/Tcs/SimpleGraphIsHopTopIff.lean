import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphIsHop

/-!
# simple_graph_is_hop_top_iff

Topic: graphs   Node: 06243b6bec5e

Provenance: helper lemma. Sanity lemma for hops, arXiv:2610.18463 (The group generated by a graph's derangements), Sec. 1 (in a complete graph every derangement is a hop).

In a complete graph, the hops are exactly the derangements (fixed-point-free permutations).
-/

theorem simple_graph_is_hop_top_iff {V : Type*} (h : Equiv.Perm V) :
    simple_graph_is_hop (⊤ : SimpleGraph V) h ↔ ∀ v, h v ≠ v := by
  simp only [simple_graph_is_hop, SimpleGraph.top_adj]
  exact forall_congr' fun v => ne_comm

import AFTD.Prelude
import AFTD.Kb.Tcs.SimpleGraphKayakPaddle

/-!
# simple_graph_kayak_paddle_adj_zero_k

Topic: graphs   Node: e21118d8f23d

Provenance: helper lemma. Sanity lemma for the kayak paddle graph, arXiv:2610.18463 (The group generated by a graph's derangements), Sec. 2.4.

In KP(k, m, l), vertex 0 of the first cycle is adjacent to vertex k, the first vertex after it on the connecting path.
-/

theorem simple_graph_kayak_paddle_adj_zero_k (k m l : ℕ) (hk : 3 ≤ k) (hm : 3 ≤ m) (hl : 1 ≤ l) :
    (simple_graph_kayak_paddle k m l).Adj ⟨0, by omega⟩ ⟨k, by omega⟩ := by
  simp [simple_graph_kayak_paddle]
  omega

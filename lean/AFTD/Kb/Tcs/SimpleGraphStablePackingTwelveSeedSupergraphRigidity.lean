def sp12_triF (t : ℕ × ℕ × ℕ) : Fin 20 × Fin 20 × Fin 20 :=
  (⟨t.1 % 20, Nat.mod_lt _ (by decide)⟩, ⟨t.2.1 % 20, Nat.mod_lt _ (by decide)⟩,
    ⟨t.2.2 % 20, Nat.mod_lt _ (by decide)⟩)

def sp12_cert (a b c : Fin 20) : List (Fin 20 × Fin 20 × Fin 20) :=
  let i := ((sp12_idx.getD a.val []).getD b.val []).getD c.val 0
  if i = 999 then sp12_P0.map sp12_triF ++ [(a, b, c)] else ((sp12_certs.getD (i / 20) []).getD (i % 20) []).map sp12_triF

def sp12_inS (a b c : Fin 20) (k : ℕ) : Bool :=
  sp12_E0mask.testBit k || k == sp12_ec a.val b.val || k == sp12_ec a.val c.val ||
    k == sp12_ec b.val c.val

def sp12_triCodes (t : Fin 20 × Fin 20 × Fin 20) : List ℕ :=
  [sp12_ec t.1.val t.2.1.val, sp12_ec t.1.val t.2.2.val, sp12_ec t.2.1.val t.2.2.val]

def sp12_nodupB : List ℕ → ℕ → Bool
  | [], _ => true
  | k :: l, acc => !acc.testBit k && sp12_nodupB l (acc ||| 2 ^ k)

def sp12_check (a b c : Fin 20) (M : List (Fin 20 × Fin 20 × Fin 20)) : Bool :=
  M.length == 13 && M.all (fun t => (sp12_triCodes t).all (sp12_inS a b c)) &&
    sp12_nodupB (M.flatMap sp12_triCodes) 0

set_option maxRecDepth 100000 in
theorem sp12_all : ∀ a b c : Fin 20, sp12_E0mask.testBit (sp12_ec a.val b.val) = false →
    a ≠ b → c ≠ a → c ≠ b → sp12_check a b c (sp12_cert a b c) = true := by
  decide +kernel

theorem sp12_nodupB_spec : ∀ (l : List ℕ) (acc : ℕ), sp12_nodupB l acc = true →
    l.Nodup ∧ ∀ k ∈ l, acc.testBit k = false := by
  intro l
  induction l with
  | nil => intro acc _; exact ⟨List.nodup_nil, by simp⟩
  | cons k l ih =>
    intro acc h
    simp only [sp12_nodupB, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨h1, h2⟩ := ih _ h.2
    refine ⟨List.nodup_cons.2 ⟨fun hk => ?_, h1⟩, ?_⟩
    · have := h2 k hk
      rw [Nat.testBit_or, Nat.testBit_two_pow_self, Bool.or_true] at this
      exact absurd this (by decide)
    · intro k' hk'
      rcases List.mem_cons.1 hk' with rfl | hk'
      · exact h.1
      · have := h2 k' hk'
        rw [Nat.testBit_or, Bool.or_eq_false_iff] at this
        exact this.1

def sp12_secode : Sym2 (Fin 20) → ℕ :=
  Sym2.lift ⟨fun x y => sp12_ec x.val y.val, fun x y => by
    show sp12_ec x.val y.val = sp12_ec y.val x.val
    unfold sp12_ec; split_ifs <;> omega⟩

theorem sp12_ec_inj (x y u v : Fin 20) (h : sp12_ec x.val y.val = sp12_ec u.val v.val) :
    s(x, y) = s(u, v) := by
  have hx := x.isLt; have hy := y.isLt; have hu := u.isLt; have hv := v.isLt
  unfold sp12_ec at h
  rw [Sym2.eq_iff]
  split_ifs at h with h1 h2 h2
  · left; constructor <;> (apply Fin.ext; omega)
  · right; constructor <;> (apply Fin.ext; omega)
  · right; constructor <;> (apply Fin.ext; omega)
  · left; constructor <;> (apply Fin.ext; omega)

theorem sp12_enc3_sub (x y z : Fin 20) (e : Sym2 (Fin 20))
    (he : e ∈ finite_vertex_set_edge_encoding ({x, y, z} : Finset (Fin 20))) :
    sp12_secode e ∈ sp12_triCodes (x, y, z) := by
  induction e using Sym2.ind with
  | h u v =>
    simp only [finite_vertex_set_edge_encoding, Finset.mem_filter, Finset.mk_mem_sym2_iff,
      Finset.mem_insert, Finset.mem_singleton, Sym2.mk_isDiag_iff] at he
    obtain ⟨⟨hu, hv⟩, huv⟩ := he
    have hsym : ∀ p q : Fin 20, sp12_ec p.val q.val = sp12_ec q.val p.val := by
      intro p q; unfold sp12_ec; split_ifs <;> omega
    show sp12_ec u.val v.val ∈ [sp12_ec x.val y.val, sp12_ec x.val z.val, sp12_ec y.val z.val]
    rcases hu with rfl | rfl | rfl <;> rcases hv with rfl | rfl | rfl <;>
      first | exact absurd rfl huv | simp [hsym]

theorem sp12_glue (G : SimpleGraph (Fin 20)) (a b c : Fin 20) (hab : G.Adj a b)
    (hac : G.Adj a c) (hbc : G.Adj b c)
    (hE : ∀ x y : Fin 20, sp12_E0mask.testBit (sp12_ec x.val y.val) = true → G.Adj x y)
    (M : List (Fin 20 × Fin 20 × Fin 20)) (hM : sp12_check a b c M = true)
    (h3 : ∀ Q : Finset (Finset (Sym2 (Fin 20))), Q ⊆ simple_graph_triangle_edge_family G →
        (Q : Set (Finset (Sym2 (Fin 20)))).Pairwise Disjoint → Q.card ≤ 12) : False := by
  simp only [sp12_check, Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at hM
  obtain ⟨⟨hlen, hall⟩, hnd⟩ := hM
  have hnd' := (sp12_nodupB_spec _ _ hnd).1
  rw [List.nodup_flatMap] at hnd'
  have hadj : ∀ x y : Fin 20, sp12_inS a b c (sp12_ec x.val y.val) = true → G.Adj x y := by
    intro x y h
    simp only [sp12_inS, Bool.or_eq_true, beq_iff_eq] at h
    rcases h with ((h | h) | h) | h
    · exact hE x y h
    · rw [← SimpleGraph.mem_edgeSet, sp12_ec_inj _ _ _ _ h]; exact hab
    · rw [← SimpleGraph.mem_edgeSet, sp12_ec_inj _ _ _ _ h]; exact hac
    · rw [← SimpleGraph.mem_edgeSet, sp12_ec_inj _ _ _ _ h]; exact hbc
  have htadj : ∀ t ∈ M, G.Adj t.1 t.2.1 ∧ G.Adj t.1 t.2.2 ∧ G.Adj t.2.1 t.2.2 := by
    intro t ht
    have := hall t ht
    exact ⟨hadj _ _ (this _ (by simp [sp12_triCodes])), hadj _ _ (this _ (by simp [sp12_triCodes])),
      hadj _ _ (this _ (by simp [sp12_triCodes]))⟩
  let T : Fin 20 × Fin 20 × Fin 20 → Finset (Sym2 (Fin 20)) := fun t =>
    finite_vertex_set_edge_encoding ({t.1, t.2.1, t.2.2} : Finset (Fin 20))
  have hmemT : ∀ t e, e ∈ T t → sp12_secode e ∈ sp12_triCodes t := by
    intro t e he
    exact sp12_enc3_sub t.1 t.2.1 t.2.2 e he
  have hpw : M.Pairwise (fun t u => Disjoint (T t) (T u)) :=
    hnd'.2.imp (fun {t u} h => Finset.disjoint_left.2 (fun e he1 he2 =>
      h (hmemT t e he1) (hmemT u e he2)))
  have hne : ∀ t ∈ M, (T t).Nonempty := by
    intro t ht
    refine ⟨s(t.1, t.2.1), ?_⟩
    simp only [T, finite_vertex_set_edge_encoding, Finset.mem_filter, Finset.mk_mem_sym2_iff,
      Finset.mem_insert, Finset.mem_singleton, Sym2.mk_isDiag_iff]
    exact ⟨by simp, G.ne_of_adj (htadj t ht).1⟩
  have hnodup : (M.map T).Nodup := by
    rw [List.Nodup, List.pairwise_map]
    refine hpw.imp_of_mem (fun {t u} ht _ h heq => ?_)
    rw [heq, Finset.disjoint_self_iff_empty] at h
    exact (hne u (by assumption)).ne_empty h
  have hsub : (M.map T).toFinset ⊆ simple_graph_triangle_edge_family G := by
    intro X hX
    rw [List.mem_toFinset, List.mem_map] at hX
    obtain ⟨t, ht, rfl⟩ := hX
    obtain ⟨h1, h2, h3'⟩ := htadj t ht
    unfold simple_graph_triangle_edge_family
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨_, SimpleGraph.is3Clique_triple_iff.2 ⟨h1, h2, h3'⟩, rfl⟩
  have hpd : (((M.map T).toFinset : Finset _) : Set (Finset (Sym2 (Fin 20)))).Pairwise Disjoint := by
    intro X hX Y hY hXY
    simp only [Finset.mem_coe, List.mem_toFinset, List.mem_map] at hX hY
    obtain ⟨t, ht, rfl⟩ := hX
    obtain ⟨u, hu, rfl⟩ := hY
    haveI : Std.Symm (fun t u => Disjoint (T t) (T u)) := ⟨fun _ _ h => h.symm⟩
    exact hpw.forall ht hu (fun h => hXY (h ▸ rfl))
  have hcard := h3 _ hsub hpd
  rw [List.toFinset_card_of_nodup hnodup, List.length_map, hlen] at hcard
  omega

theorem sp12_mask_mem : ∀ x y : Fin 20, sp12_E0mask.testBit (sp12_ec x.val y.val) = true →
    s(x, y) ∈ sp12_E0 := by
  decide +kernel

open scoped Sym2

theorem simple_graph_stable_packing_twelve_seed_supergraph_rigidity :
    let E₀ : Finset (Sym2 (Fin 20)) := {s(0, 1), s(0, 6), s(0, 12), s(0, 13), s(0, 14), s(0, 19), s(1, 3), s(1, 6), s(1, 7), s(1, 18), s(1, 19), s(2, 3), s(2, 5), s(2, 9), s(2, 11), s(2, 13), s(2, 16), s(3, 7), s(3, 11), s(3, 13), s(3, 18), s(4, 5), s(4, 8), s(4, 10), s(4, 14), s(4, 17), s(4, 18), s(5, 8), s(5, 9), s(5, 14), s(5, 16), s(6, 7), s(6, 8), s(6, 9), s(6, 19), s(7, 8), s(7, 9), s(7, 18), s(8, 9), s(8, 14), s(9, 16), s(10, 11), s(10, 15), s(10, 16), s(10, 17), s(10, 18), s(11, 13), s(11, 15), s(11, 16), s(12, 13), s(12, 14), s(12, 15), s(12, 17), s(12, 19), s(13, 14), s(15, 16), s(15, 17), s(15, 19), s(17, 18), s(17, 19)}
    ∀ (G : SimpleGraph (Fin 20)),
      (↑E₀ : Set (Sym2 (Fin 20))) ⊆ G.edgeSet →
      (∀ e ∈ G.edgeSet, 2 ≤ ((simple_graph_triangle_edge_family G).filter (fun t => e ∈ t)).card) →
      (∀ Q : Finset (Finset (Sym2 (Fin 20))), Q ⊆ simple_graph_triangle_edge_family G →
        (Q : Set (Finset (Sym2 (Fin 20)))).Pairwise Disjoint → Q.card ≤ 12) →
      G.edgeSet = (↑E₀ : Set (Sym2 (Fin 20))) := by
  intro E₀ G hsub h2 h3
  have hsub' : (↑sp12_E0 : Set (Sym2 (Fin 20))) ⊆ G.edgeSet := hsub
  show G.edgeSet = ↑sp12_E0
  have hE : ∀ x y : Fin 20, sp12_E0mask.testBit (sp12_ec x.val y.val) = true → G.Adj x y :=
    fun x y h => hsub' (Finset.mem_coe.2 (sp12_mask_mem x y h))
  refine Set.Subset.antisymm ?_ hsub'
  intro e he
  by_contra heE
  revert he heE
  refine Sym2.ind (fun a b => ?_) e
  intro he heE
  have hab : G.Adj a b := he
  have hpos := h2 s(a, b) he
  obtain ⟨t, ht⟩ := Finset.card_pos.1 (by omega : 0 < ((simple_graph_triangle_edge_family G).filter
    (fun t => s(a, b) ∈ t)).card)
  rw [Finset.mem_filter] at ht
  obtain ⟨htF, hmem⟩ := ht
  unfold simple_graph_triangle_edge_family at htF
  simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and] at htF
  obtain ⟨S, hcl, rfl⟩ := htF
  simp only [finite_vertex_set_edge_encoding, Finset.mem_filter, Finset.mk_mem_sym2_iff,
    Sym2.mk_isDiag_iff] at hmem
  obtain ⟨⟨ha, hb⟩, hne⟩ := hmem
  obtain ⟨c, hc, hca, hcb⟩ : ∃ c ∈ S, c ≠ a ∧ c ≠ b := by
    by_contra hcon
    push_neg at hcon
    have hsub2 : S ⊆ {a, b} := by
      intro x hx
      by_cases hxa : x = a
      · simp [hxa]
      · simp [hcon x hx hxa]
    have := Finset.card_le_card hsub2
    have h22 := Finset.card_le_two (a := a) (b := b)
    rw [hcl.card_eq] at this
    omega
  have hac : G.Adj a c := hcl.isClique (Finset.mem_coe.2 ha) (Finset.mem_coe.2 hc) (Ne.symm hca)
  have hbc : G.Adj b c := hcl.isClique (Finset.mem_coe.2 hb) (Finset.mem_coe.2 hc) (Ne.symm hcb)
  have hbit : sp12_E0mask.testBit (sp12_ec a.val b.val) = false := by
    cases h : sp12_E0mask.testBit (sp12_ec a.val b.val)
    · rfl
    · exact absurd (Finset.mem_coe.2 (sp12_mask_mem a b h)) heE
  exact sp12_glue G a b c hab hac hbc hE _ (sp12_all a b c hbit hne hca hcb) h3

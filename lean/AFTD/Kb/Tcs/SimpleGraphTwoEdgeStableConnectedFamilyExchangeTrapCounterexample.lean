def ts18_F : Finset (Finset (Sym2 (Fin 18))) := (ts18_L.map ts18_enc).toFinset

def ts18_sort3 (a b c : Fin 18) : Fin 18 × Fin 18 × Fin 18 :=
  if a < b then (if b < c then (a, b, c) else if a < c then (a, c, b) else (c, a, b))
  else (if a < c then (b, a, c) else if b < c then (b, c, a) else (c, b, a))

theorem ts18_enc_sort3 (a b c : Fin 18) :
    ts18_enc (ts18_sort3 a b c) = {s(a, b), s(a, c), s(b, c)} := by
  unfold ts18_sort3 ts18_enc
  split_ifs <;> ext e <;> simp only [Finset.mem_insert, Finset.mem_singleton] <;> constructor <;> rintro (h | h | h) <;> subst h <;> simp [Sym2.eq_swap]

set_option maxRecDepth 100000 in
theorem ts18_sort3_mem : ∀ a b c : Fin 18, ts18_G.Adj a b → ts18_G.Adj a c → ts18_G.Adj b c →
    ts18_sort3 a b c ∈ ts18_L := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_L_tri : ∀ x ∈ ts18_L, x.1 < x.2.1 ∧ x.2.1 < x.2.2 ∧ ts18_G.Adj x.1 x.2.1 ∧
    ts18_G.Adj x.1 x.2.2 ∧ ts18_G.Adj x.2.1 x.2.2 := by
  decide +kernel

theorem ts18_fvsee_triple {V : Type*} [DecidableEq V] (a b c : V) (hab : a ≠ b) (hac : a ≠ c)
    (hbc : b ≠ c) :
    finite_vertex_set_edge_encoding ({a, b, c} : Finset V) = {s(a, b), s(a, c), s(b, c)} := by
  unfold finite_vertex_set_edge_encoding
  ext e
  induction e using Sym2.ind with
  | _ x y =>
    simp only [Finset.mem_filter, Finset.mem_sym2_iff, Sym2.mem_iff, Sym2.mk_isDiag_iff,
      Finset.mem_insert, Finset.mem_singleton, Sym2.eq_iff]
    constructor
    · rintro ⟨h, hxy⟩
      have hx := h x (Or.inl rfl)
      have hy := h y (Or.inr rfl)
      rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;> simp_all
    · rintro (h | h | h) <;> rcases h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ <;> aesop

theorem ts18_F_eq : simple_graph_triangle_edge_family ts18_G = ts18_F := by
  classical
  unfold simple_graph_triangle_edge_family ts18_F
  ext t
  simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and, List.mem_toFinset,
    List.mem_map]
  constructor
  · rintro ⟨s, hs, rfl⟩
    obtain ⟨a, b, c, hab, hac, hbc, rfl⟩ := Finset.card_eq_three.mp hs.card_eq
    obtain ⟨h1, h2, h3⟩ := (SimpleGraph.is3Clique_triple_iff).mp hs
    exact ⟨_, ts18_sort3_mem a b c h1 h2 h3, by
      rw [ts18_enc_sort3, ts18_fvsee_triple a b c hab hac hbc]⟩
  · rintro ⟨x, hx, rfl⟩
    obtain ⟨l1, l2, h1, h2, h3⟩ := ts18_L_tri x hx
    refine ⟨{x.1, x.2.1, x.2.2}, (SimpleGraph.is3Clique_triple_iff).mpr ⟨h1, h2, h3⟩, ?_⟩
    rw [ts18_fvsee_triple _ _ _ (ne_of_lt l1) (ne_of_lt (l1.trans l2)) (ne_of_lt l2)]
    rfl

abbrev T18 := Fin 18 × Fin 18 × Fin 18

def ts18_sc (a b : Fin 18) : ℕ := if a.val ≤ b.val then a.val * 18 + b.val else b.val * 18 + a.val

theorem ts18_sc_comm (a b : Fin 18) : ts18_sc a b = ts18_sc b a := by
  unfold ts18_sc; split_ifs <;> omega

theorem ts18_sc_eq_iff (a b c d : Fin 18) : ts18_sc a b = ts18_sc c d ↔ s(a, b) = s(c, d) := by
  have := a.isLt; have := b.isLt; have := c.isLt; have := d.isLt
  rw [Sym2.eq_iff]; simp only [Fin.ext_iff]; unfold ts18_sc
  constructor <;> intro h <;> split_ifs at * <;> omega

def ts18_scS : Sym2 (Fin 18) → ℕ := Sym2.lift ⟨ts18_sc, ts18_sc_comm⟩

theorem ts18_scS_mk (a b : Fin 18) : ts18_scS s(a, b) = ts18_sc a b := rfl

def ts18_msk (x : T18) : ℕ :=
  2 ^ ts18_sc x.1 x.2.1 ||| 2 ^ ts18_sc x.1 x.2.2 ||| 2 ^ ts18_sc x.2.1 x.2.2

theorem ts18_tb_msk (x : T18) (k : ℕ) : (ts18_msk x).testBit k = true ↔
    (ts18_sc x.1 x.2.1 = k ∨ ts18_sc x.1 x.2.2 = k ∨ ts18_sc x.2.1 x.2.2 = k) := by
  simp [ts18_msk, Nat.testBit_or, Nat.testBit_two_pow, or_assoc]

theorem ts18_mem_enc (x : T18) (e : Sym2 (Fin 18)) :
    e ∈ ts18_enc x ↔ (ts18_msk x).testBit (ts18_scS e) = true := by
  induction e using Sym2.ind with
  | _ a b =>
    rw [ts18_tb_msk, ts18_scS_mk, ts18_sc_eq_iff, ts18_sc_eq_iff, ts18_sc_eq_iff]
    simp only [ts18_enc, Finset.mem_insert, Finset.mem_singleton]
    constructor <;> rintro (h | h | h) <;> simp [h]

theorem ts18_mem_enc_of_tb (x : T18) (i : ℕ) (h : (ts18_msk x).testBit i = true) :
    ∃ e ∈ ts18_enc x, ts18_scS e = i := by
  rw [ts18_tb_msk] at h
  rcases h with h | h | h
  · exact ⟨s(x.1, x.2.1), by simp [ts18_enc], h⟩
  · exact ⟨s(x.1, x.2.2), by simp [ts18_enc], h⟩
  · exact ⟨s(x.2.1, x.2.2), by simp [ts18_enc], h⟩

theorem ts18_not_disj (x y : T18) (h : ts18_msk x &&& ts18_msk y ≠ 0) :
    ¬ Disjoint (ts18_enc x) (ts18_enc y) := by
  obtain ⟨k, hk⟩ := Nat.exists_testBit_of_ne_zero h
  rw [Nat.testBit_land, Bool.and_eq_true] at hk
  obtain ⟨e, he, rfl⟩ := ts18_mem_enc_of_tb x k hk.1
  rw [Finset.not_disjoint_iff]
  exact ⟨e, he, (ts18_mem_enc y e).mpr hk.2⟩

theorem ts18_disj (x y : T18) (h : ts18_msk x &&& ts18_msk y = 0) :
    Disjoint (ts18_enc x) (ts18_enc y) := by
  rw [Finset.disjoint_left]
  intro e h1 h2
  rw [ts18_mem_enc] at h1 h2
  have : (ts18_msk x &&& ts18_msk y).testBit (ts18_scS e) = true := by
    rw [Nat.testBit_land, h1, h2]; rfl
  rw [h, Nat.zero_testBit] at this
  exact absurd this (by decide)

theorem ts18_land_of_disj (x y : T18) (h : Disjoint (ts18_enc x) (ts18_enc y)) :
    ts18_msk x &&& ts18_msk y = 0 := by
  by_contra h'
  exact ts18_not_disj x y h' h

theorem ts18_enc_msk (x y : T18) (h : ts18_enc x = ts18_enc y) : ts18_msk x = ts18_msk y := by
  apply Nat.eq_of_testBit_eq
  intro i
  apply Bool.eq_iff_iff.mpr
  constructor
  · intro hi
    obtain ⟨e, he, rfl⟩ := ts18_mem_enc_of_tb x i hi
    rw [h] at he; exact (ts18_mem_enc y e).mp he
  · intro hi
    obtain ⟨e, he, rfl⟩ := ts18_mem_enc_of_tb y i hi
    rw [← h] at he; exact (ts18_mem_enc x e).mp he

theorem ts18_msk_ne (x : T18) : ts18_msk x ≠ 0 := by
  intro h
  have := (ts18_tb_msk x (ts18_sc x.1 x.2.1)).mpr (Or.inl rfl)
  rw [h, Nat.zero_testBit] at this
  exact absurd this (by decide)

theorem ts18_enc_mem (x : T18) : s(x.1, x.2.1) ∈ ts18_enc x := by simp [ts18_enc]

def ts18_um : List T18 → ℕ
  | [] => 0
  | x :: S => ts18_msk x ||| ts18_um S

def ts18_pk (S : List T18) : Finset (Finset (Sym2 (Fin 18))) := (S.map ts18_enc).toFinset

theorem ts18_mem_U (S : List T18) (e : Sym2 (Fin 18)) :
    e ∈ (ts18_pk S).biUnion id ↔ (ts18_um S).testBit (ts18_scS e) = true := by
  induction S with
  | nil => simp [ts18_pk, ts18_um]
  | cons x S ih =>
    simp only [ts18_pk] at ih ⊢
    simp only [List.map_cons, List.toFinset_cons, Finset.biUnion_insert, Finset.mem_union, id,
      ih, ts18_mem_enc, ts18_um, Nat.testBit_or, Bool.or_eq_true]

theorem ts18_tb_um (S : List T18) (y : T18) (hy : y ∈ S) (i : ℕ)
    (h : (ts18_msk y).testBit i = true) : (ts18_um S).testBit i = true := by
  induction S with
  | nil => simp at hy
  | cons z S ih =>
    simp only [ts18_um, Nat.testBit_or, Bool.or_eq_true]
    rcases List.mem_cons.mp hy with rfl | hy
    · exact Or.inl h
    · exact Or.inr (ih hy)

theorem ts18_land_um (x : T18) (S : List T18) (h : ts18_msk x &&& ts18_um S = 0) (y : T18)
    (hy : y ∈ S) : ts18_msk x &&& ts18_msk y = 0 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_land, Nat.zero_testBit]
  cases h1 : (ts18_msk x).testBit i
  · rfl
  cases h2 : (ts18_msk y).testBit i
  · rfl
  have := congrArg (fun m => m.testBit i) h
  simp only [Nat.testBit_land, h1, ts18_tb_um S y hy i h2, Nat.zero_testBit] at this
  exact absurd this (by decide)

def ts18_pd : List T18 → Bool
  | [] => true
  | x :: S => (ts18_msk x &&& ts18_um S == 0) && ts18_pd S

theorem ts18_pd_forall (S : List T18) (h : ts18_pd S = true) :
    ∀ x ∈ S, ∀ y ∈ S, x ≠ y → ts18_msk x &&& ts18_msk y = 0 := by
  induction S with
  | nil => simp
  | cons z S ih =>
    simp only [ts18_pd, Bool.and_eq_true, beq_iff_eq] at h
    intro x hx y hy hxy
    rcases List.mem_cons.mp hx with hx' | hx' <;> rcases List.mem_cons.mp hy with hy' | hy'
    · exact absurd (hx'.trans hy'.symm) hxy
    · rw [hx']; exact ts18_land_um z S h.1 y hy'
    · rw [hy', Nat.land_comm]; exact ts18_land_um z S h.1 x hx'
    · exact ih h.2 x hx' y hy' hxy

theorem ts18_pd_nodup (S : List T18) (h : ts18_pd S = true) : S.Nodup := by
  induction S with
  | nil => exact List.nodup_nil
  | cons z S ih =>
    simp only [ts18_pd, Bool.and_eq_true, beq_iff_eq] at h
    refine List.nodup_cons.mpr ⟨fun hz => ?_, ih h.2⟩
    have := ts18_land_um z S h.1 z hz
    rw [Nat.and_self] at this
    exact ts18_msk_ne z this

theorem ts18_pd_inj (S : List T18) (h : ts18_pd S = true) :
    ∀ x ∈ S, ∀ y ∈ S, ts18_enc x = ts18_enc y → x = y := by
  intro x hx y hy he
  by_contra hne
  have hd := ts18_disj x y (ts18_pd_forall S h x hx y hy hne)
  rw [he] at hd
  exact Finset.disjoint_left.mp hd (ts18_enc_mem y) (ts18_enc_mem y)

theorem ts18_pk_card (S : List T18) (h : ts18_pd S = true) : (ts18_pk S).card = S.length := by
  unfold ts18_pk
  rw [List.toFinset_card_of_nodup (List.Nodup.map_on (ts18_pd_inj S h) (ts18_pd_nodup S h)),
    List.length_map]

theorem ts18_pk_disj (S : List T18) (h : ts18_pd S = true) :
    (ts18_pk S : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint := by
  intro t ht t' ht' hne
  simp only [ts18_pk, Finset.mem_coe, List.mem_toFinset, List.mem_map] at ht ht'
  obtain ⟨x, hx, rfl⟩ := ht
  obtain ⟨y, hy, rfl⟩ := ht'
  exact ts18_disj x y (ts18_pd_forall S h x hx y hy (fun e => hne (by rw [e])))

theorem ts18_pk_sub (S : List T18) (h : ∀ x ∈ S, x ∈ ts18_L) : ts18_pk S ⊆ ts18_F := by
  intro t ht
  simp only [ts18_pk, ts18_F, List.mem_toFinset, List.mem_map] at ht ⊢
  obtain ⟨x, hx, rfl⟩ := ht
  exact ⟨x, h x hx, rfl⟩

theorem ts18_mem_F (t : Finset (Sym2 (Fin 18))) : t ∈ ts18_F ↔ ∃ x ∈ ts18_L, ts18_enc x = t := by
  simp [ts18_F]

theorem ts18_card_inter (a b c : Fin 18) (hab : a < b) (hbc : b < c)
    (U : Finset (Sym2 (Fin 18))) :
    (ts18_enc (a, b, c) ∩ U).card = (if s(a, b) ∈ U then 1 else 0) +
      (if s(a, c) ∈ U then 1 else 0) + (if s(b, c) ∈ U then 1 else 0) := by
  have hab' := Fin.ne_of_lt hab
  have hbc' := Fin.ne_of_lt hbc
  have hac' := Fin.ne_of_lt (hab.trans hbc)
  have e12 : s(a, b) ≠ s(a, c) := by
    rw [Ne, Sym2.eq_iff]; rintro (⟨-, h⟩ | ⟨h, -⟩)
    · exact hbc' h
    · exact hac' h
  have e13 : s(a, b) ≠ s(b, c) := by
    rw [Ne, Sym2.eq_iff]; rintro (⟨h, -⟩ | ⟨h, -⟩)
    · exact hab' h
    · exact hac' h
  have e23 : s(a, c) ≠ s(b, c) := by
    rw [Ne, Sym2.eq_iff]; rintro (⟨h, -⟩ | ⟨-, h⟩)
    · exact hab' h
    · exact hbc' h.symm
  unfold ts18_enc
  dsimp only
  split_ifs with h1 h2 h3 h3 h2 h3 h3 <;>
    simp [Finset.insert_inter_of_mem, Finset.insert_inter_of_notMem, h1, h2, h3,
      Finset.card_insert_of_notMem, e12, e13, e23]


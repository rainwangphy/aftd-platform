def ts18_cnt (y : T18) (m : ℕ) : ℕ :=
  (if m.testBit (ts18_sc y.1 y.2.1) = true then 1 else 0) +
    (if m.testBit (ts18_sc y.1 y.2.2) = true then 1 else 0) +
    (if m.testBit (ts18_sc y.2.1 y.2.2) = true then 1 else 0)

theorem ts18_card_inter_U (S : List T18) (y : T18) (hy : y ∈ ts18_L) :
    (ts18_enc y ∩ (ts18_pk S).biUnion id).card = ts18_cnt y (ts18_um S) := by
  obtain ⟨l1, l2, -⟩ := ts18_L_tri y hy
  rcases y with ⟨a, b, c⟩
  rw [ts18_card_inter a b c l1 l2]
  simp only [ts18_mem_U, ts18_scS_mk, ts18_cnt]

def ts18_frc (S : List T18) (x : T18) : Bool :=
  [ts18_sc x.1 x.2.1, ts18_sc x.1 x.2.2, ts18_sc x.2.1 x.2.2].all
    (fun k => ts18_L.any (fun y => (ts18_msk y).testBit k && ts18_cnt y (ts18_um S) == 1))

set_option maxRecDepth 100000 in
theorem ts18_frc_spec (S : List T18) (x : T18) (h : ts18_frc S x = true) :
    ts18_enc x ⊆ ((ts18_F.filter (fun t => (t ∩ (ts18_pk S).biUnion id).card = 1)).biUnion id) := by
  intro e he
  rw [ts18_mem_enc, ts18_tb_msk] at he
  have hk : ts18_scS e ∈ [ts18_sc x.1 x.2.1, ts18_sc x.1 x.2.2, ts18_sc x.2.1 x.2.2] := by
    rcases he with h | h | h <;> simp [h]
  unfold ts18_frc at h
  rw [List.all_eq_true] at h
  have h' := h _ hk
  rw [List.any_eq_true] at h'
  obtain ⟨y, hy, h''⟩ := h'
  rw [Bool.and_eq_true, beq_iff_eq] at h''
  obtain ⟨h1, h2⟩ := h''
  rw [Finset.mem_biUnion]
  refine ⟨ts18_enc y, ?_, (ts18_mem_enc y e).mpr h1⟩
  rw [Finset.mem_filter, ts18_mem_F, ts18_card_inter_U S y hy]
  exact ⟨⟨y, hy, rfl⟩, h2⟩


/-!
# simple_graph_two_edge_stable_connected_family_exchange_trap_counterexample

Topic: graphs   Node: 29c60d7f9762

Provenance: helper lemma. Finite edge-sum construction audited by experiments 17301, 17325 and 17337; no claim of novelty.

There is a connected 18-vertex graph with 57 edges, packing number 14, all edge pairs avoidable by maximum packings, at least three triangles per edge, a connected triangle family, and a vertex of degree at least 17, together with a maximum packing containing a fully forced triangle such that every one-triangle replacement remains forced.
-/

open scoped Sym2

def ts18_adjB (a b : ℕ) : Bool :=
  decide (a ≠ b ∧ ((a < 9 ∧ b < 9 ∧ (4 ≤ a ∨ 4 ≤ b)) ∨ (9 ≤ a ∧ 9 ≤ b ∧ (a - 9) / 3 = (b - 9) / 3) ∨
    (9 ≤ a ∧ (b = 0 ∨ b = 7)) ∨ (9 ≤ b ∧ (a = 0 ∨ a = 7))))

theorem ts18_adjB_symm (a b : ℕ) (h : ts18_adjB a b = true) : ts18_adjB b a = true := by
  unfold ts18_adjB at *
  simp only [decide_eq_true_eq] at *
  omega

theorem ts18_adjB_irrefl (a : ℕ) : ¬ ts18_adjB a a = true := by
  unfold ts18_adjB
  simp

def ts18_G : SimpleGraph (Fin 18) where
  Adj a b := ts18_adjB a.val b.val = true
  symm := ⟨fun a b h => ts18_adjB_symm _ _ h⟩
  loopless := ⟨fun a h => ts18_adjB_irrefl _ h⟩

instance ts18_G_dec : DecidableRel ts18_G.Adj := fun a b =>
  inferInstanceAs (Decidable (ts18_adjB a.val b.val = true))


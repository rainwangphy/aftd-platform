theorem ts18_adj7 : ∀ w : Fin 18, w ≠ 7 → ts18_G.Adj 7 w := by decide +kernel

theorem ts18_connected : ts18_G.Connected := by
  have hr : ∀ w : Fin 18, ts18_G.Reachable 7 w := by
    intro w
    by_cases h : w = 7
    · subst h; rfl
    · exact (ts18_adj7 w h).reachable
  exact ⟨fun u v => (hr u).symm.trans (hr v)⟩

theorem ts18_deg : ∃ v : Fin 18, ∃ N : Finset (Fin 18), N.card = 17 ∧ ∀ w ∈ N, ts18_G.Adj v w :=
  ⟨7, Finset.univ.erase 7, by simp, fun w hw => ts18_adj7 w (Finset.ne_of_mem_erase hw)⟩

set_option maxRecDepth 100000 in
theorem ts18_deg_sum : ∑ v, ts18_G.degree v = 114 := by decide +kernel

theorem ts18_E_card : ts18_G.edgeFinset.card = 57 := by
  have h := ts18_G.sum_degrees_eq_twice_card_edges
  rw [ts18_deg_sum] at h
  omega

set_option maxRecDepth 100000 in
theorem ts18_LM_nodup : (ts18_L.map ts18_msk).Nodup := by decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_codeg_chk : ∀ a b : Fin 18, ts18_G.Adj a b →
    3 ≤ (ts18_L.filter (fun y => (ts18_msk y).testBit (ts18_sc a b))).length := by decide +kernel

theorem ts18_codeg : ∀ e ∈ ts18_G.edgeSet, 3 ≤ (ts18_F.filter (fun t => e ∈ t)).card := by
  intro e he
  induction e using Sym2.ind with
  | _ a b =>
    have hc := ts18_codeg_chk a b he
    have hinj : ∀ x ∈ ts18_L.filter (fun y => (ts18_msk y).testBit (ts18_sc a b)),
        ∀ y ∈ ts18_L.filter (fun y => (ts18_msk y).testBit (ts18_sc a b)),
        ts18_enc x = ts18_enc y → x = y := by
      intro x hx y hy h
      exact List.inj_on_of_nodup_map ts18_LM_nodup (List.mem_of_mem_filter hx)
        (List.mem_of_mem_filter hy) (ts18_enc_msk x y h)
    have hnd := (List.Nodup.of_map _ ts18_LM_nodup).filter
      (fun y => (ts18_msk y).testBit (ts18_sc a b))
    have hcard := List.toFinset_card_of_nodup (List.Nodup.map_on hinj hnd)
    rw [List.length_map] at hcard
    refine hc.trans (hcard.symm.le.trans (Finset.card_le_card ?_))
    intro t ht
    simp only [List.mem_toFinset, List.mem_map, List.mem_filter] at ht
    obtain ⟨y, ⟨hy1, hy2⟩, rfl⟩ := ht
    rw [Finset.mem_filter, ts18_mem_F]
    exact ⟨⟨y, hy1, rfl⟩, (ts18_mem_enc y _).mpr (by rw [ts18_scS_mk]; exact hy2)⟩

set_option maxRecDepth 100000 in
theorem ts18_Wm_ok : ts18_Wm.all (fun p => ts18_um p.1 == p.2 && ts18_pd p.1 &&
    p.1.length == 14 && p.1.all (fun x => decide (x ∈ ts18_L))) = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_EC_spec : ∀ a b : Fin 18, ts18_G.Adj a b → ts18_sc a b ∈ ts18_EC := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_EC_pairs : ts18_EC.all (fun k1 => ts18_EC.all (fun k2 => k1 == k2 ||
    ts18_Wm.any (fun p => !p.2.testBit k1 && !p.2.testBit k2))) = true := by decide +kernel

theorem ts18_pair_stable : ∀ e ∈ ts18_G.edgeSet, ∀ f ∈ ts18_G.edgeSet, e ≠ f →
    ∃ Q : Finset (Finset (Sym2 (Fin 18))), Q ⊆ ts18_F ∧ Q.card = 14 ∧
      (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint ∧
      e ∉ Q.biUnion id ∧ f ∉ Q.biUnion id := by
  intro e he f hf hef
  induction e using Sym2.ind with
  | _ a b =>
  induction f using Sym2.ind with
  | _ c d =>
    have h1 := ts18_EC_spec a b he
    have h2 := ts18_EC_spec c d hf
    have hne : ts18_sc a b ≠ ts18_sc c d := fun h => hef ((ts18_sc_eq_iff a b c d).mp h)
    have h3 := List.all_eq_true.mp (List.all_eq_true.mp ts18_EC_pairs _ h1) _ h2
    simp only [Bool.or_eq_true, beq_iff_eq, hne, false_or, List.any_eq_true, Bool.and_eq_true,
      Bool.not_eq_true'] at h3
    obtain ⟨p, hp, hp1, hp2⟩ := h3
    have h4 := List.all_eq_true.mp ts18_Wm_ok p hp
    simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq] at h4
    obtain ⟨⟨⟨hum, hpd⟩, hlen⟩, hsub⟩ := h4
    refine ⟨ts18_pk p.1, ts18_pk_sub _ hsub, by rw [ts18_pk_card _ hpd, hlen],
      ts18_pk_disj _ hpd, ?_, ?_⟩
    · rw [ts18_mem_U, ts18_scS_mk, hum, hp1]; decide
    · rw [ts18_mem_U, ts18_scS_mk, hum, hp2]; decide


set_option maxRecDepth 100000 in
theorem ts18_PL_ok : (ts18_pd ts18_PL && ts18_PL.length == 14 &&
    ts18_PL.all (fun x => decide (x ∈ ts18_L)) && ts18_PL.any (ts18_frc ts18_PL)) = true := by
  decide +kernel

theorem ts18_PL_facts : ts18_pd ts18_PL = true ∧ ts18_PL.length = 14 ∧
    (∀ x ∈ ts18_PL, x ∈ ts18_L) ∧ ∃ x ∈ ts18_PL, ts18_frc ts18_PL x = true := by
  have h := ts18_PL_ok
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true, decide_eq_true_eq,
    List.any_eq_true] at h
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2⟩

theorem ts18_P_forced : ∃ p ∈ ts18_P,
    p ⊆ ((ts18_F.filter (fun t => (t ∩ ts18_P.biUnion id).card = 1)).biUnion id) := by
  obtain ⟨x, hx, hf⟩ := ts18_PL_facts.2.2.2
  refine ⟨ts18_enc x, ?_, ts18_frc_spec _ x hf⟩
  simp only [ts18_P, ts18_pk, List.mem_toFinset, List.mem_map]
  exact ⟨x, hx, rfl⟩

def ts18_rest (x : T18) : List T18 := ts18_PL.filter (fun z => z != x)

set_option maxRecDepth 100000 in
theorem ts18_trap_chk : ts18_PL.all (fun x => ts18_L.all (fun y =>
    !(ts18_rest x).all (fun z => ts18_msk y &&& ts18_msk z == 0) ||
    (y :: ts18_rest x).any (ts18_frc (y :: ts18_rest x)))) = true := by decide +kernel

theorem ts18_trap (Q : Finset (Finset (Sym2 (Fin 18)))) (hQF : Q ⊆ ts18_F) (hQc : Q.card = 14)
    (hQd : (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint) (hPQ : (ts18_P \ Q).card = 1) :
    ∃ q ∈ Q, q ⊆ ((ts18_F.filter (fun t => (t ∩ Q.biUnion id).card = 1)).biUnion id) := by
  obtain ⟨hPLpd, hPLlen, -, -⟩ := ts18_PL_facts
  obtain ⟨p, hp⟩ := Finset.card_eq_one.mp hPQ
  have hpPQ : p ∈ ts18_P \ Q := by rw [hp]; exact Finset.mem_singleton_self p
  have hpP : p ∈ ts18_P := (Finset.mem_sdiff.mp hpPQ).1
  have hsub : ts18_P.erase p ⊆ Q := by
    intro t ht
    by_contra htQ
    have : t ∈ ts18_P \ Q := Finset.mem_sdiff.mpr ⟨Finset.mem_of_mem_erase ht, htQ⟩
    rw [hp, Finset.mem_singleton] at this
    exact Finset.ne_of_mem_erase ht this
  have hPc : ts18_P.card = 14 := by rw [ts18_P, ts18_pk_card _ hPLpd, hPLlen]
  have hEc : (ts18_P.erase p).card = 13 := by rw [Finset.card_erase_of_mem hpP, hPc]
  obtain ⟨q, hqQ, hqn⟩ : ∃ q ∈ Q, q ∉ ts18_P.erase p := by
    by_contra hcon
    push Not at hcon
    have := Finset.card_le_card (show Q ⊆ ts18_P.erase p from hcon)
    omega
  have hQeq : Q = insert q (ts18_P.erase p) := by
    symm
    apply Finset.eq_of_subset_of_card_le (Finset.insert_subset hqQ hsub)
    rw [Finset.card_insert_of_notMem hqn, hEc, hQc]
  obtain ⟨x, hx, rfl⟩ : ∃ x ∈ ts18_PL, ts18_enc x = p := by
    simpa [ts18_P, ts18_pk] using hpP
  obtain ⟨y, hy, rfl⟩ := (ts18_mem_F q).mp (hQF hqQ)
  have herase : ts18_P.erase (ts18_enc x) = ts18_pk (ts18_rest x) := by
    ext t
    simp only [Finset.mem_erase, ts18_P, ts18_pk, ts18_rest, List.mem_toFinset, List.mem_map,
      List.mem_filter, bne_iff_ne, ne_eq]
    constructor
    · rintro ⟨hne, z, hz, rfl⟩
      exact ⟨z, ⟨hz, fun h => hne (by rw [h])⟩, rfl⟩
    · rintro ⟨z, ⟨hz, hzx⟩, rfl⟩
      exact ⟨fun h => hzx (ts18_pd_inj _ hPLpd z hz x hx h), z, hz, rfl⟩
  have hmr : ∀ z ∈ ts18_rest x, ts18_enc z ∈ ts18_P.erase (ts18_enc x) := by
    intro z hz
    rw [herase]
    simp only [ts18_pk, List.mem_toFinset, List.mem_map]
    exact ⟨z, hz, rfl⟩
  have hQS : Q = ts18_pk (y :: ts18_rest x) := by
    rw [hQeq, herase]
    simp only [ts18_pk, List.map_cons, List.toFinset_cons]
  have hdisj : (ts18_rest x).all (fun z => ts18_msk y &&& ts18_msk z == 0) = true := by
    rw [List.all_eq_true]
    intro z hz
    have hne : ts18_enc y ≠ ts18_enc z := by
      intro h
      apply hqn
      rw [h]
      exact hmr z hz
    simpa using ts18_land_of_disj y z (hQd hqQ (hsub (hmr z hz)) hne)
  have hc := List.all_eq_true.mp (List.all_eq_true.mp ts18_trap_chk x hx) y hy
  simp only [hdisj, Bool.not_true, Bool.false_or, List.any_eq_true] at hc
  obtain ⟨z, hz, hfz⟩ := hc
  refine ⟨ts18_enc z, ?_, ?_⟩
  · rw [hQS]
    simp only [ts18_pk, List.mem_toFinset, List.mem_map]
    exact ⟨z, hz, rfl⟩
  · rw [hQS]
    exact ts18_frc_spec _ z hfz

def ts18_hub : T18 := (0, 4, 7)

set_option maxRecDepth 100000 in
theorem ts18_CH_ok : (ts18_CH.all (fun c => decide (c.2.1 ∈ ts18_L) && decide (c.2.2 ∈ ts18_L) &&
    ts18_msk c.1 &&& ts18_msk c.2.1 != 0 && ts18_msk c.2.1 &&& ts18_msk c.2.2 != 0 &&
    ts18_msk c.2.2 &&& ts18_msk ts18_hub != 0) &&
    ts18_L.all (fun x => ts18_CH.any (fun c => c.1 == x)) && decide (ts18_hub ∈ ts18_L)) = true := by
  decide +kernel

def ts18_R (x y : Finset (Sym2 (Fin 18))) : Prop := x ∈ ts18_F ∧ y ∈ ts18_F ∧ ¬ Disjoint x y

theorem ts18_family_conn : ∀ a ∈ ts18_F, ∀ b ∈ ts18_F, Relation.ReflTransGen
    (fun x y : Finset (Sym2 (Fin 18)) => x ∈ ts18_F ∧ y ∈ ts18_F ∧ ¬ Disjoint x y) a b := by
  have h := ts18_CH_ok
  simp only [Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq,
    List.any_eq_true, beq_iff_eq] at h
  obtain ⟨⟨hc, hcov⟩, hhub⟩ := h
  have hF : ∀ x ∈ ts18_L, ts18_enc x ∈ ts18_F := fun x hx => (ts18_mem_F _).mpr ⟨x, hx, rfl⟩
  have step : ∀ x ∈ ts18_L, ∀ y ∈ ts18_L, ts18_msk x &&& ts18_msk y ≠ 0 →
      ts18_R (ts18_enc x) (ts18_enc y) :=
    fun x hx y hy h => ⟨hF x hx, hF y hy, ts18_not_disj x y h⟩
  have tohub : ∀ x ∈ ts18_L, Relation.ReflTransGen ts18_R (ts18_enc x) (ts18_enc ts18_hub) := by
    intro x hx
    obtain ⟨c, hcm, rfl⟩ := hcov x hx
    obtain ⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩ := hc c hcm
    exact ((Relation.ReflTransGen.single (step _ hx _ h1 h3)).tail (step _ h1 _ h2 h4)).tail
      (step _ h2 _ hhub h5)
  have rev : ∀ a b, Relation.ReflTransGen ts18_R a b → Relation.ReflTransGen ts18_R b a := by
    intro a b hab
    induction hab with
    | refl => exact .refl
    | tail _ hbc ih => exact .head ⟨hbc.2.1, hbc.1, fun hd => hbc.2.2 hd.symm⟩ ih
  intro a ha b hb
  obtain ⟨x, hx, rfl⟩ := (ts18_mem_F a).mp ha
  obtain ⟨y, hy, rfl⟩ := (ts18_mem_F b).mp hb
  exact (tohub x hx).trans (rev _ _ (tohub y hy))

def ts18_ty (x : T18) : ℕ :=
  if x.2.2.val < 9 then (if x.1.val < 4 then x.1.val else 4) else 5 + (x.2.2.val - 9) / 3

def ts18_w (k : ℕ) : ℕ := (if k < 4 then 1 else 0) + (if k = 4 then 3 else 0)

def ts18_SKT : List T18 := [(4, 5, 6), (4, 7, 8), (5, 6, 7), (5, 6, 8)]

def ts18_SK : Finset (Sym2 (Fin 18)) := (ts18_pk ts18_SKT).biUnion id

set_option maxRecDepth 100000 in
theorem ts18_SK_card : ts18_SK.card = 10 := by decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_L_cls : ts18_L.all (fun x => decide (ts18_ty x < 8) &&
    (ts18_ty x == 4 || decide (x ∈ ts18_C (ts18_ty x))) &&
    decide (ts18_w (ts18_ty x) ≤ ts18_cnt x (ts18_um ts18_SKT))) = true := by decide +kernel

set_option maxRecDepth 100000 in
theorem ts18_no_three : [0, 1, 2, 3, 5, 6, 7].all (fun k => (ts18_C k).all (fun x1 =>
    (ts18_C k).all (fun x2 => (ts18_C k).all (fun x3 =>
    ts18_msk x1 &&& ts18_msk x2 != 0 || ts18_msk x1 &&& ts18_msk x3 != 0 ||
    ts18_msk x2 &&& ts18_msk x3 != 0)))) = true := by decide +kernel

theorem ts18_sum_inter_le (Q : Finset (Finset (Sym2 (Fin 18))))
    (hQ : (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint) (S : Finset (Sym2 (Fin 18))) :
    ∑ t ∈ Q, (t ∩ S).card ≤ S.card := by
  rw [← Finset.card_biUnion]
  · exact Finset.card_le_card (Finset.biUnion_subset.mpr (fun t _ => Finset.inter_subset_right))
  · intro t ht t' ht' hne
    exact Disjoint.mono Finset.inter_subset_left Finset.inter_subset_left (hQ ht ht' hne)

theorem ts18_nu_le (Q : Finset (Finset (Sym2 (Fin 18)))) (hQF : Q ⊆ ts18_F)
    (hQ : (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint) : Q.card ≤ 14 := by
  have hmem : ∀ t ∈ Q, ∃ x ∈ ts18_L, ts18_enc x = t := fun t ht => (ts18_mem_F t).mp (hQF ht)
  choose! rep hrepL hrep using hmem
  have hcls : ∀ x ∈ ts18_L, ts18_ty x < 8 ∧ (ts18_ty x = 4 ∨ x ∈ ts18_C (ts18_ty x)) ∧
      ts18_w (ts18_ty x) ≤ ts18_cnt x (ts18_um ts18_SKT) := by
    intro x hx
    have := List.all_eq_true.mp ts18_L_cls x hx
    simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, beq_iff_eq] at this
    exact ⟨this.1.1, this.1.2, this.2⟩
  have hg8 : ∀ t ∈ Q, ts18_ty (rep t) ∈ Finset.range 8 := fun t ht =>
    Finset.mem_range.mpr (hcls _ (hrepL t ht)).1
  have hcard := Finset.card_eq_sum_card_fiberwise hg8
  have hfib : ∀ k ∈ [0, 1, 2, 3, 5, 6, 7],
      (Q.filter (fun t => ts18_ty (rep t) = k)).card ≤ 2 := by
    intro k hk
    by_contra hc
    push Not at hc
    obtain ⟨t1, t2, t3, h1, h2, h3, h12, h13, h23⟩ := Finset.two_lt_card_iff.mp hc
    simp only [Finset.mem_filter] at h1 h2 h3
    have hk4 : k ≠ 4 := by rintro rfl; simp at hk
    have mC : ∀ t, t ∈ Q ∧ ts18_ty (rep t) = k → rep t ∈ ts18_C k := by
      intro t ht
      rcases (hcls _ (hrepL t ht.1)).2.1 with h | h
      · exact absurd (ht.2 ▸ h) hk4
      · rwa [ht.2] at h
    have H := List.all_eq_true.mp (List.all_eq_true.mp (List.all_eq_true.mp
      (List.all_eq_true.mp ts18_no_three k hk) _ (mC t1 h1)) _ (mC t2 h2)) _ (mC t3 h3)
    simp only [Bool.or_eq_true, bne_iff_ne, ne_eq] at H
    rcases H with (H | H) | H
    · exact ts18_not_disj _ _ H (by rw [hrep t1 h1.1, hrep t2 h2.1]; exact hQ h1.1 h2.1 h12)
    · exact ts18_not_disj _ _ H (by rw [hrep t1 h1.1, hrep t3 h3.1]; exact hQ h1.1 h3.1 h13)
    · exact ts18_not_disj _ _ H (by rw [hrep t2 h2.1, hrep t3 h3.1]; exact hQ h2.1 h3.1 h23)
  have hw : ∑ t ∈ Q, ts18_w (ts18_ty (rep t)) ≤ ∑ t ∈ Q, (t ∩ ts18_SK).card := by
    apply Finset.sum_le_sum
    intro t ht
    have := (hcls _ (hrepL t ht)).2.2
    rw [← ts18_card_inter_U ts18_SKT _ (hrepL t ht), hrep t ht] at this
    exact this
  have hS := ts18_sum_inter_le Q hQ ts18_SK
  rw [ts18_SK_card] at hS
  rw [← Finset.sum_fiberwise_of_maps_to hg8] at hw
  have hw' : ∀ k ∈ Finset.range 8,
      ∑ t ∈ Q.filter (fun t => ts18_ty (rep t) = k), ts18_w (ts18_ty (rep t)) =
      ts18_w k * (Q.filter (fun t => ts18_ty (rep t) = k)).card := by
    intro k _
    rw [Finset.sum_congr rfl (fun t ht => by rw [(Finset.mem_filter.mp ht).2]), Finset.sum_const,
      smul_eq_mul, mul_comm]
  rw [Finset.sum_congr rfl hw'] at hw
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, ts18_w] at hw hcard
  have f0 := hfib 0 (by simp)
  have f1 := hfib 1 (by simp)
  have f2 := hfib 2 (by simp)
  have f3 := hfib 3 (by simp)
  have f5 := hfib 5 (by simp)
  have f6 := hfib 6 (by simp)
  have f7 := hfib 7 (by simp)
  norm_num at hw
  omega

theorem simple_graph_two_edge_stable_connected_family_exchange_trap_counterexample :
    ∃ (G : SimpleGraph (Fin 18)) (E : Finset (Sym2 (Fin 18)))
      (P : Finset (Finset (Sym2 (Fin 18)))),
      let F := simple_graph_triangle_edge_family G
      (↑E : Set (Sym2 (Fin 18))) = G.edgeSet ∧ E.card = 57 ∧
      G.Connected ∧
      (∀ a ∈ F, ∀ b ∈ F, Relation.ReflTransGen
        (fun x y : Finset (Sym2 (Fin 18)) => x ∈ F ∧ y ∈ F ∧ ¬ Disjoint x y) a b) ∧
      (∀ Q : Finset (Finset (Sym2 (Fin 18))), Q ⊆ F →
        (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint → Q.card ≤ 14) ∧
      P ⊆ F ∧ P.card = 14 ∧
      (P : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint ∧
      (∀ e ∈ G.edgeSet, ∀ f ∈ G.edgeSet, e ≠ f →
        ∃ Q : Finset (Finset (Sym2 (Fin 18))), Q ⊆ F ∧ Q.card = 14 ∧
          (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint ∧
          e ∉ Q.biUnion id ∧ f ∉ Q.biUnion id) ∧
      (∀ e ∈ G.edgeSet, 3 ≤ (F.filter (fun t => e ∈ t)).card) ∧
      (∃ v : Fin 18, ∃ N : Finset (Fin 18),
        N.card = 17 ∧ ∀ w ∈ N, G.Adj v w) ∧
      (∃ p ∈ P, p ⊆ ((F.filter (fun t => (t ∩ P.biUnion id).card = 1)).biUnion id)) ∧
      ∀ Q : Finset (Finset (Sym2 (Fin 18))), Q ⊆ F → Q.card = 14 →
        (Q : Set (Finset (Sym2 (Fin 18)))).Pairwise Disjoint →
        (P \ Q).card = 1 →
        ∃ q ∈ Q, q ⊆ ((F.filter (fun t => (t ∩ Q.biUnion id).card = 1)).biUnion id) := by
  obtain ⟨hPLpd, hPLlen, hPLsub, -⟩ := ts18_PL_facts
  refine ⟨ts18_G, ts18_G.edgeFinset, ts18_P, ?_⟩
  dsimp only
  rw [ts18_F_eq]
  exact ⟨SimpleGraph.coe_edgeFinset _, ts18_E_card, ts18_connected, ts18_family_conn,
    fun Q hQ hd => ts18_nu_le Q hQ hd, ts18_pk_sub _ hPLsub,
    by rw [ts18_P, ts18_pk_card _ hPLpd, hPLlen], ts18_pk_disj _ hPLpd, ts18_pair_stable,
    ts18_codeg, ts18_deg, ts18_P_forced, fun Q hQ hc hd hpq => ts18_trap Q hQ hc hd hpq⟩

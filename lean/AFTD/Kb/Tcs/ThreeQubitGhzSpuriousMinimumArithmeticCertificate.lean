theorem three_qubit_ghz_spurious_minimum_arithmetic_certificate :
    (∀ j k : Fin 9, GhzMinCert.h j k = GhzMinCert.hLit j k) ∧
    (∀ j k : Fin 9, GhzMinCert.transformed j k = GhzMinCert.cLit j k) ∧
    (∀ i : Fin 9, (∑ j : Fin 9, if i = j then (0 : ℤ) else |GhzMinCert.cLit i j|) < GhzMinCert.cLit i i) ∧
    (∀ j : Fin 9, |∑ i : Fin 8, GhzMinCert.d i * GhzMinCert.p j i| * 10^14 < 4*GhzMinCert.n*GhzMinCert.n) ∧
    64*GhzMinCert.n*GhzMinCert.n < 25000 * (∑ i : Fin 8, GhzMinCert.d i*GhzMinCert.d i) := by
  refine ⟨?_, ?_, GhzMinCert.diagonal_dominant, GhzMinCert.gradient_small, GhzMinCert.cost_positive⟩
  · intro j k
    fin_cases j <;> first | exact GhzMinCert.hrow0 k | exact GhzMinCert.hrow1 k | exact GhzMinCert.hrow2 k | exact GhzMinCert.hrow3 k | exact GhzMinCert.hrow4 k | exact GhzMinCert.hrow5 k | exact GhzMinCert.hrow6 k | exact GhzMinCert.hrow7 k | exact GhzMinCert.hrow8 k
  · intro j k
    fin_cases j <;> first | exact GhzMinCert.crow0 k | exact GhzMinCert.crow1 k | exact GhzMinCert.crow2 k | exact GhzMinCert.crow3 k | exact GhzMinCert.crow4 k | exact GhzMinCert.crow5 k | exact GhzMinCert.crow6 k | exact GhzMinCert.crow7 k | exact GhzMinCert.crow8 k

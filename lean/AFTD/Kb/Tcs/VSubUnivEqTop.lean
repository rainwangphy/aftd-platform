@[simp] lemma V_sub_univ_eq_top :
    V_sub (n:=n) (p:=p) (Finset.univ : Finset (Fin n))
      = (⊤ : Submodule (F p) (V n p)) := by
  classical
  ext v
  constructor
  · intro _; trivial
  · intro _ i hi
    exact (False.elim (hi (Finset.mem_univ i)))

import AFTD.Prelude
import AFTD.Kb.Tcs.ZeroSumW
import AFTD.Kb.Tcs.ZeroSumWGe
import AFTD.Kb.Tcs.ZeroSumGoodSubseq
import AFTD.Kb.GameTheoryEconomics.TotalPreorder
import AFTD.Kb.Tcs.ZeroSumAdmissible
import AFTD.Kb.GameTheoryEconomics.LinearOrderToTotalPreorder
import AFTD.Kb.Tcs.Weight
import AFTD.Kb.Tcs.Bit

/-!
# zero_sum_w_three_three

Topic: combinatorics   Node: b4208a00bb99

Provenance: original. Related work: Case r = 3, n = 3 of Question 3.1 of arXiv:2610.19965 (Proofs and disproofs of some conjectures on zero-sum problems of new types); the paper proves only the lower bound w_r(n) >= 2r(n-1)+1 (zero_sum_w_ge), and equality is known only for r = 1, n = 2, and r = 2 with n = 2^k 3^l p, so (3,3) is the smallest open case.

w_3(3) = 13: every admissible sequence (no term ≡ 0 mod 3) of 13 vectors in ℤ^3 has a nonempty subsequence whose sum is ≡ 0 (mod 3) but ≢ 0 (mod 9), and 13 is the least length with this property. This is the case r = 3, n = 3 of the equality w_r(n) = 2r(n-1)+1.
-/

namespace ZeroSumW33

abbrev Vec3 := Fin 3 → ℤ

def code (v : Vec3) : ℕ := (v 0 : ZMod 3).val + 3 * (v 1 : ZMod 3).val + 9 * (v 2 : ZMod 3).val

def dig (j c : ℕ) : ℕ := c / 3 ^ j % 3

lemma dig_code0 (v : Vec3) : dig 0 (code v) = (v 0 : ZMod 3).val := by
  have h0 := ZMod.val_lt (v 0 : ZMod 3)
  have h1 := ZMod.val_lt (v 1 : ZMod 3)
  have h2 := ZMod.val_lt (v 2 : ZMod 3)
  simp only [dig, code]; omega

lemma dig_code1 (v : Vec3) : dig 1 (code v) = (v 1 : ZMod 3).val := by
  have h0 := ZMod.val_lt (v 0 : ZMod 3)
  have h1 := ZMod.val_lt (v 1 : ZMod 3)
  have h2 := ZMod.val_lt (v 2 : ZMod 3)
  simp only [dig, code]; omega

lemma dig_code2 (v : Vec3) : dig 2 (code v) = (v 2 : ZMod 3).val := by
  have h0 := ZMod.val_lt (v 0 : ZMod 3)
  have h1 := ZMod.val_lt (v 1 : ZMod 3)
  have h2 := ZMod.val_lt (v 2 : ZMod 3)
  simp only [dig, code]; omega

lemma dig_code (v : Vec3) (j : Fin 3) : dig j (code v) = (v j : ZMod 3).val := by
  fin_cases j
  · exact dig_code0 v
  · exact dig_code1 v
  · exact dig_code2 v

lemma code_lt (v : Vec3) : code v < 27 := by
  have h0 := ZMod.val_lt (v 0 : ZMod 3)
  have h1 := ZMod.val_lt (v 1 : ZMod 3)
  have h2 := ZMod.val_lt (v 2 : ZMod 3)
  simp only [code]; omega

lemma int_sub_dig (v : Vec3) (j : Fin 3) : (3 : ℤ) ∣ v j - (dig j (code v) : ℤ) := by
  rw [dig_code, ZMod.val_intCast]
  exact ⟨v j / 3, by rw [Int.emod_def]; ring⟩

lemma code_eq_zero_iff (v : Vec3) : code v = 0 ↔ ∀ j, (3 : ℤ) ∣ v j := by
  have e : ∀ j, (3 : ℤ) ∣ v j ↔ (v j : ZMod 3).val = 0 := by
    intro j
    rw [ZMod.val_eq_zero, ZMod.intCast_zmod_eq_zero_iff_dvd]
    norm_num
  constructor
  · intro h j
    rw [e, ← dig_code]
    fin_cases j <;> simp only [dig] <;> omega
  · intro h
    have h0 := (e 0).1 (h 0)
    have h1 := (e 1).1 (h 1)
    have h2 := (e 2).1 (h 2)
    simp [code, h0, h1, h2]

def maskSub {α : Type} : List α → ℕ → List α
  | [], _ => []
  | a :: l, m => if m % 2 = 1 then a :: maskSub l (m / 2) else maskSub l (m / 2)

lemma maskSub_sublist {α : Type} (l : List α) (m : ℕ) : (maskSub l m).Sublist l := by
  induction l generalizing m with
  | nil => simp [maskSub]
  | cons a l ih =>
    unfold maskSub
    split_ifs
    · exact (ih _).cons_cons a
    · exact (ih _).cons a

lemma maskSub_map {α β : Type} (f : α → β) (l : List α) (m : ℕ) :
    maskSub (l.map f) m = (maskSub l m).map f := by
  induction l generalizing m with
  | nil => simp [maskSub]
  | cons a l ih =>
    simp only [List.map_cons, maskSub]
    split_ifs <;> simp [ih]

def mwt : List (ℕ × ℕ) → ℕ
  | [] => 0
  | p :: c => p.2 * (p.1 % 2) + mwt c

def mshift : List (ℕ × ℕ) → List (ℕ × ℕ)
  | [] => []
  | p :: c => (p.1 / 2, p.2) :: mshift c

/-- Σ over the masked positions of digit `j` (kernel-friendly recursor form). -/
def msum (j : ℕ) (s : List ℕ) : ℕ → ℕ :=
  List.rec (fun _ => 0) (fun x _ r m => (m % 2) * dig j x + r (m / 2)) s

lemma msum_nil (j m : ℕ) : msum j [] m = 0 := rfl
lemma msum_cons (j x : ℕ) (s : List ℕ) (m : ℕ) :
    msum j (x :: s) m = (m % 2) * dig j x + msum j s (m / 2) := rfl

/-- Some masked position exists. -/
def mnz (s : List ℕ) : ℕ → Bool :=
  List.rec (fun _ => false) (fun _ _ r m => Nat.beq (m % 2) 1 || r (m / 2)) s

lemma mnz_cons (x : ℕ) (s : List ℕ) (m : ℕ) : mnz (x :: s) m = (Nat.beq (m % 2) 1 || mnz s (m / 2)) := rfl

def wtR (c : List (ℕ × ℕ)) : ℕ := List.rec 0 (fun p _ r => p.2 * (p.1 % 2) + r) c
def shiftR (c : List (ℕ × ℕ)) : List (ℕ × ℕ) := List.rec [] (fun p _ r => (p.1 / 2, p.2) :: r) c

lemma wtR_eq (c : List (ℕ × ℕ)) : wtR c = mwt c := by
  induction c with
  | nil => rfl
  | cons p c ih => simp only [mwt, ← ih]; rfl
lemma shiftR_eq (c : List (ℕ × ℕ)) : shiftR c = mshift c := by
  induction c with
  | nil => rfl
  | cons p c ih => simp only [mshift, ← ih]; rfl

def shiftN (i : ℕ) (c : List (ℕ × ℕ)) : List (ℕ × ℕ) := c.map fun p => (p.1 / 2 ^ i, p.2)

lemma shift_eq_map (c : List (ℕ × ℕ)) : mshift c = c.map fun p => (p.1 / 2, p.2) := by
  induction c with
  | nil => rfl
  | cons p c ih => simp [mshift, ih]

lemma shift_shiftN (i : ℕ) (c : List (ℕ × ℕ)) : mshift (shiftN i c) = shiftN (i + 1) c := by
  rw [shift_eq_map, shiftN, shiftN, List.map_map]
  congr 1
  funext p
  simp [Nat.div_div_eq_div_mul, pow_succ]

lemma shiftN_zero (c : List (ℕ × ℕ)) : shiftN 0 c = c := by simp [shiftN]

/-- Weight of position `i`. -/
def wtI (i : ℕ) (c : List (ℕ × ℕ)) : ℕ := List.rec 0 (fun p _ r => p.2 * (p.1 / 2 ^ i % 2) + r) c

lemma wtI_eq (i : ℕ) (c : List (ℕ × ℕ)) : wtI i c = mwt (shiftN i c) := by
  induction c with
  | nil => rfl
  | cons p c ih =>
    show p.2 * (p.1 / 2 ^ i % 2) + wtI i c = mwt (shiftN i (p :: c))
    rw [ih]; simp [shiftN, mwt]

/-- One pass: every position weight is ≡ 0 (mod 3), and the weighted digit-`j` sum plus `r` is
not ≡ 0 (mod 9). Position `i` reads bit `i` of each mask. -/
def wr (j : ℕ) (s : List ℕ) (c : List (ℕ × ℕ)) : ℕ → ℕ → Bool :=
  List.rec (fun _ r => !Nat.beq (r % 9) 0)
    (fun x _ f i r => Nat.beq (wtI i c % 3) 0 && f (i + 1) (r + wtI i c * dig j x)) s

lemma wr_nil (j : ℕ) (c : List (ℕ × ℕ)) (i r : ℕ) : wr j [] c i r = !Nat.beq (r % 9) 0 := rfl
lemma wr_cons (j x : ℕ) (s : List ℕ) (c : List (ℕ × ℕ)) (i r : ℕ) :
    wr j (x :: s) c i r = (Nat.beq (mwt (shiftN i c) % 3) 0 &&
      wr j s c (i + 1) (r + mwt (shiftN i c) * dig j x)) := by
  rw [← wtI_eq]; rfl

def allP (c : List (ℕ × ℕ)) (f : ℕ × ℕ → Bool) : Bool := List.rec true (fun p _ r => f p && r) c

lemma allP_spec (c : List (ℕ × ℕ)) (f : ℕ × ℕ → Bool) (h : allP c f = true) : ∀ p ∈ c, f p = true := by
  induction c with
  | nil => simp
  | cons q c ih =>
    have h' : (f q && allP c f) = true := h
    rw [Bool.and_eq_true] at h'
    intro p hp
    rcases List.mem_cons.1 hp with rfl | hp
    · exact h'.1
    · exact ih h'.2 p hp

/-- Masked count and the three masked digit sums, packed in base 32. -/
def msumP (s : List ℕ) : ℕ → ℕ :=
  List.rec (fun _ => 0)
    (fun x _ r m => (m % 2) * (1 + 32 * dig 0 x + 1024 * dig 1 x + 32768 * dig 2 x) + r (m / 2)) s

/-- Masked count. -/
def mcnt (s : List ℕ) : ℕ → ℕ := List.rec (fun _ => 0) (fun _ _ r m => (m % 2) + r (m / 2)) s

lemma msumP_eq (s : List ℕ) (m : ℕ) :
    msumP s m = mcnt s m + 32 * msum 0 s m + 1024 * msum 1 s m + 32768 * msum 2 s m := by
  induction s generalizing m with
  | nil => rfl
  | cons x s ih =>
    show (m % 2) * (1 + 32 * dig 0 x + 1024 * dig 1 x + 32768 * dig 2 x) + msumP s (m / 2)
      = ((m % 2) + mcnt s (m / 2)) + 32 * ((m % 2) * dig 0 x + msum 0 s (m / 2))
        + 1024 * ((m % 2) * dig 1 x + msum 1 s (m / 2)) + 32768 * ((m % 2) * dig 2 x + msum 2 s (m / 2))
    rw [ih]; ring

lemma mcnt_le (s : List ℕ) (m : ℕ) : mcnt s m ≤ s.length := by
  induction s generalizing m with
  | nil => exact le_refl 0
  | cons x s ih =>
    show (m % 2) + mcnt s (m / 2) ≤ s.length + 1
    have := ih (m / 2); have := Nat.mod_lt m (show 2 > 0 by norm_num); omega

lemma msum_le (j : ℕ) (s : List ℕ) (m : ℕ) : msum j s m ≤ 2 * s.length := by
  induction s generalizing m with
  | nil => exact Nat.zero_le _
  | cons x s ih =>
    rw [msum_cons]
    have := ih (m / 2)
    have h1 : m % 2 ≤ 1 := by omega
    have h2 : dig j x ≤ 2 := by unfold dig; omega
    have h3 : (m % 2) * dig j x ≤ 2 := by nlinarith
    simp only [List.length_cons]; omega

lemma mcnt_pos (N : List Vec3) (m : ℕ) (h : mcnt (N.map code) m ≠ 0) : maskSub N m ≠ [] := by
  induction N generalizing m with
  | nil => exact absurd rfl h
  | cons a N ih =>
    have h' : (m % 2) + mcnt (N.map code) (m / 2) ≠ 0 := h
    rcases Nat.mod_two_eq_zero_or_one m with h2 | h2
    · rw [show maskSub (a :: N) m = maskSub N (m / 2) by simp [maskSub, h2]]
      rw [h2] at h'
      exact ih _ (by omega)
    · rw [show maskSub (a :: N) m = a :: maskSub N (m / 2) by simp [maskSub, h2]]
      simp

def pOK (M : ℕ) : Bool :=
  Nat.blt 0 (M % 32) && Nat.beq (M / 32 % 32 % 3) 0 && Nat.beq (M / 1024 % 32 % 3) 0 &&
    Nat.beq (M / 32768 % 3) 0

def certOK (s : List ℕ) (jr : ℕ) (c : List (ℕ × ℕ)) : Bool :=
  Nat.blt s.length 16 && allP c (fun p => pOK (msumP s p.1)) && wr (jr % 3) s c 0 0

def W (N : List Vec3) : List (ℕ × ℕ) → Fin 3 → ℤ
  | [], _ => 0
  | p :: c, j => (p.2 : ℤ) * (maskSub N p.1).sum j + W N c j

lemma W_nil (c : List (ℕ × ℕ)) (j : Fin 3) : W [] c j = 0 := by
  induction c with
  | nil => rfl
  | cons p c ih => simp [W, maskSub, ih]

lemma W_cons (a : Vec3) (N : List Vec3) (c : List (ℕ × ℕ)) (j : Fin 3) :
    W (a :: N) c j = (mwt c : ℤ) * a j + W N (mshift c) j := by
  induction c with
  | nil => simp [W, mwt, mshift]
  | cons p c ih =>
    simp only [W, mwt, mshift, ih]
    rcases Nat.mod_two_eq_zero_or_one p.1 with h | h
    · rw [show maskSub (a :: N) p.1 = maskSub N (p.1 / 2) by simp [maskSub, h], h]
      push_cast; ring
    · rw [show maskSub (a :: N) p.1 = a :: maskSub N (p.1 / 2) by simp [maskSub, h], h]
      simp only [List.sum_cons, Pi.add_apply]
      push_cast; ring

lemma W_dvd (N : List Vec3) (c : List (ℕ × ℕ)) (j : Fin 3)
    (h : ∀ p ∈ c, (9 : ℤ) ∣ (maskSub N p.1).sum j) : (9 : ℤ) ∣ W N c j := by
  induction c with
  | nil => simp [W]
  | cons p c ih =>
    simp only [W]
    exact dvd_add (dvd_mul_of_dvd_right (h p (by simp)) _)
      (ih (fun q hq => h q (by simp [hq])))

lemma msum_map (j : ℕ) (N : List Vec3) (m : ℕ) :
    msum j (N.map code) m = (((maskSub N m).map code).map (dig j)).sum := by
  induction N generalizing m with
  | nil => rfl
  | cons a N ih =>
    rw [List.map_cons, msum_cons, ih]
    rcases Nat.mod_two_eq_zero_or_one m with h | h
    · rw [show maskSub (a :: N) m = maskSub N (m / 2) by simp [maskSub, h], h]; simp
    · rw [show maskSub (a :: N) m = a :: maskSub N (m / 2) by simp [maskSub, h], h]; simp

lemma mnz_spec (N : List Vec3) (m : ℕ) (h : mnz (N.map code) m = true) : maskSub N m ≠ [] := by
  induction N generalizing m with
  | nil =>
    have e : mnz ([] : List ℕ) m = false := rfl
    rw [List.map_nil, e] at h
    exact absurd h (by decide)
  | cons a N ih =>
    rw [List.map_cons, mnz_cons, Bool.or_eq_true] at h
    rcases Nat.mod_two_eq_zero_or_one m with h2 | h2
    · rw [show maskSub (a :: N) m = maskSub N (m / 2) by simp [maskSub, h2]]
      rw [h2] at h
      exact ih _ (h.resolve_left (by decide))
    · rw [show maskSub (a :: N) m = a :: maskSub N (m / 2) by simp [maskSub, h2]]
      simp

lemma wr_spec (j : Fin 3) (N : List Vec3) (c : List (ℕ × ℕ)) (i r : ℕ)
    (hw : wr j (N.map code) c i r = true) : ¬ (9 : ℤ) ∣ W N (shiftN i c) j + r := by
  induction N generalizing i r with
  | nil =>
    rw [List.map_nil, wr_nil] at hw
    have h' : ¬ r % 9 = 0 := by
      intro h0
      rw [h0] at hw
      exact absurd hw (by decide)
    rw [W_nil, zero_add]
    intro h
    exact h' (Nat.mod_eq_zero_of_dvd (by exact_mod_cast h))
  | cons a N ih =>
    rw [List.map_cons, wr_cons, Bool.and_eq_true, Nat.beq_eq] at hw
    have h3 := ih (i + 1) _ hw.2
    rw [W_cons, shift_shiftN]
    have h1 : (3 : ℤ) ∣ (mwt (shiftN i c) : ℤ) := by
      have := Nat.dvd_of_mod_eq_zero hw.1
      exact_mod_cast this
    have h2 := int_sub_dig a j
    have h4 : (9 : ℤ) ∣ (mwt (shiftN i c) : ℤ) * (a j - dig j (code a)) := by
      obtain ⟨x, hx⟩ := h1
      obtain ⟨y, hy⟩ := h2
      exact ⟨x * y, by rw [hx, hy]; ring⟩
    intro h5
    apply h3
    have e : W N (shiftN (i + 1) c) j + ((r + mwt (shiftN i c) * dig j (code a) : ℕ) : ℤ)
        = ((mwt (shiftN i c) : ℤ) * a j + W N (shiftN (i + 1) c) j + r)
          - (mwt (shiftN i c) : ℤ) * (a j - dig j (code a)) := by
      push_cast; ring
    rw [e]
    exact dvd_sub h5 h4

lemma sum_dig (S : List Vec3) (j : Fin 3) :
    (3 : ℤ) ∣ S.sum j - (((S.map code).map (dig j)).sum : ℤ) := by
  induction S with
  | nil => simp
  | cons a S ih =>
    simp only [List.sum_cons, List.map_cons, Pi.add_apply, Nat.cast_add]
    have := int_sub_dig a j
    have e : a j + S.sum j - ((dig j (code a) : ℤ) + (((S.map code).map (dig j)).sum : ℤ))
        = (a j - dig j (code a)) + (S.sum j - (((S.map code).map (dig j)).sum : ℤ)) := by ring
    rw [e]
    exact dvd_add this ih

def LBad (L : List Vec3) : Prop :=
  (∀ v ∈ L, code v ≠ 0) ∧ ∀ S : List Vec3, S.Sublist L → S ≠ [] →
    (∀ j, (3 : ℤ) ∣ S.sum j) → ∀ j, (9 : ℤ) ∣ S.sum j

lemma LBad.sub {L L' : List Vec3} (h : LBad L) (hs : L'.Sublist L) : LBad L' :=
  ⟨fun v hv => h.1 v (hs.subset hv), fun S hS => h.2 S (hS.trans hs)⟩

lemma LBad.perm {L L' : List Vec3} (h : LBad L) (hp : L.Perm L') : LBad L' := by
  refine ⟨fun v hv => h.1 v (hp.symm.subset hv), fun S hS hne h3 j => ?_⟩
  obtain ⟨S', hS'p, hS'⟩ : S.Subperm L := hS.subperm.trans hp.symm.subperm
  have hsum : S'.sum = S.sum := hS'p.sum_eq
  have hne' : S' ≠ [] := by
    rintro rfl
    exact hne hS'p.symm.eq_nil
  have := h.2 S' hS' hne' (by rw [hsum]; exact h3) j
  rwa [hsum] at this

lemma unpack (A B C D L : ℕ) (hL : L < 16) (hA : A ≤ L) (hB : B ≤ 2 * L) (hC : C ≤ 2 * L)
    (_hD : D ≤ 2 * L) (h0 : 0 < (A + 32 * B + 1024 * C + 32768 * D) % 32)
    (h1 : (A + 32 * B + 1024 * C + 32768 * D) / 32 % 32 % 3 = 0)
    (h2 : (A + 32 * B + 1024 * C + 32768 * D) / 1024 % 32 % 3 = 0)
    (h3 : (A + 32 * B + 1024 * C + 32768 * D) / 32768 % 3 = 0) :
    A ≠ 0 ∧ B % 3 = 0 ∧ C % 3 = 0 ∧ D % 3 = 0 := by
  have e0 : (A + 32 * B + 1024 * C + 32768 * D) % 32 = A := by omega
  have e1 : (A + 32 * B + 1024 * C + 32768 * D) / 32 = B + 32 * C + 1024 * D := by omega
  have e2 : (A + 32 * B + 1024 * C + 32768 * D) / 1024 = C + 32 * D := by omega
  have e3 : (A + 32 * B + 1024 * C + 32768 * D) / 32768 = D := by omega
  rw [e0] at h0
  rw [e1] at h1
  rw [e2] at h2
  rw [e3] at h3
  have f1 : (B + 32 * C + 1024 * D) % 32 = B := by omega
  have f2 : (C + 32 * D) % 32 = C := by omega
  rw [f1] at h1
  rw [f2] at h2
  exact ⟨by omega, h1, h2, h3⟩

lemma cert_sound (N : List Vec3) (hb : LBad N) (jr : ℕ) (c : List (ℕ × ℕ))
    (hc : certOK (N.map code) jr c = true) : False := by
  rw [certOK, Bool.and_eq_true, Bool.and_eq_true] at hc
  obtain ⟨⟨hlen, hm⟩, hw⟩ := hc
  have hlen' : (N.map code).length < 16 := by simpa [Nat.blt_eq] using hlen
  have hm' := allP_spec _ _ hm
  have h9 : ∀ p ∈ c, (9 : ℤ) ∣ (maskSub N p.1).sum ⟨jr % 3, Nat.mod_lt _ (by norm_num)⟩ := by
    intro p hp
    have hq := hm' p hp
    simp only [pOK, Bool.and_eq_true, Nat.beq_eq, Nat.blt_eq] at hq
    obtain ⟨⟨⟨hq0, hq1⟩, hq2⟩, hq3⟩ := hq
    rw [msumP_eq] at hq0 hq1 hq2 hq3
    have b0 := mcnt_le (N.map code) p.1
    have b1 := msum_le 0 (N.map code) p.1
    have b2 := msum_le 1 (N.map code) p.1
    have b3 := msum_le 2 (N.map code) p.1
    obtain ⟨hne, h0, h1, h2⟩ := unpack _ _ _ _ _ hlen' b0 b1 b2 b3 hq0 hq1 hq2 hq3
    refine hb.2 _ (maskSub_sublist N p.1) (mcnt_pos N p.1 hne) ?_ _
    intro j'
    have hs := sum_dig (maskSub N p.1) j'
    have hmod : (((maskSub N p.1).map code).map (dig j')).sum % 3 = 0 := by
      rw [← msum_map]
      fin_cases j'
      · exact h0
      · exact h1
      · exact h2
    have h3 : (3 : ℤ) ∣ ((((maskSub N p.1).map code).map (dig j')).sum : ℤ) := by
      have := Nat.dvd_of_mod_eq_zero hmod
      exact_mod_cast this
    have := dvd_add hs h3
    simpa using this
  have hW := W_dvd N c _ h9
  exact wr_spec ⟨jr % 3, Nat.mod_lt _ (by norm_num)⟩ N c 0 0 hw (by simpa [shiftN_zero] using hW)

lemma perm_lift {α β : Type} [DecidableEq α] (f : α → β) :
    ∀ (s : List β) (l : List α), (l.map f).Perm s → ∃ l' : List α, l'.Perm l ∧ l'.map f = s
  | [], l, h => by
    have := h.eq_nil
    simp only [List.map_eq_nil_iff] at this
    exact ⟨[], by simp [this], rfl⟩
  | x :: s, l, h => by
    have hx : x ∈ l.map f := h.symm.subset (List.mem_cons_self ..)
    obtain ⟨a, ha, rfl⟩ := List.mem_map.1 hx
    have hp : l.Perm (a :: l.erase a) := List.perm_cons_erase ha
    have h2 : ((l.erase a).map f).Perm s := by
      have := (hp.map f).symm.trans h
      exact this.cons_inv
    obtain ⟨l', hl', he⟩ := perm_lift f s (l.erase a) h2
    exact ⟨a :: l', (hl'.cons a).trans hp.symm, by simp [he]⟩

def act (g : Fin 3 → Fin 3 → ℤ) (v : Vec3) : Vec3 := fun j => ∑ k, g j k * v k

def comp (h g : Fin 3 → Fin 3 → ℤ) : Fin 3 → Fin 3 → ℤ := fun i k => ∑ j, h i j * g j k

lemma act_comp (h g : Fin 3 → Fin 3 → ℤ) (v : Vec3) : act (comp h g) v = act h (act g v) := by
  funext i
  simp only [act, comp, Finset.sum_mul, Finset.mul_sum, mul_assoc]
  exact Finset.sum_comm

lemma act_add (g : Fin 3 → Fin 3 → ℤ) (a b : Vec3) : act g (a + b) = act g a + act g b := by
  funext j
  simp [act, mul_add, Finset.sum_add_distrib]

lemma act_zero (g : Fin 3 → Fin 3 → ℤ) : act g 0 = 0 := by
  funext j
  simp [act]

lemma act_sum (g : Fin 3 → Fin 3 → ℤ) (S : List Vec3) : act g S.sum = (S.map (act g)).sum := by
  induction S with
  | nil => simp [act_zero]
  | cons a S ih => simp [act_add, ih]

def Inv3 (g : Fin 3 → Fin 3 → ℤ) : Prop := ∀ v : Vec3, (∀ j, (3 : ℤ) ∣ act g v j) → ∀ j, (3 : ℤ) ∣ v j

lemma Inv3.comp {h g : Fin 3 → Fin 3 → ℤ} (hh : Inv3 h) (hg : Inv3 g) : Inv3 (comp h g) := by
  intro v hv
  rw [act_comp] at hv
  exact hg v (hh _ hv)

lemma LBad.act {L : List Vec3} (h : LBad L) {g : Fin 3 → Fin 3 → ℤ} (hg : Inv3 g) :
    LBad (L.map (act g)) := by
  refine ⟨?_, ?_⟩
  · intro w hw h0
    obtain ⟨v, hv, rfl⟩ := List.mem_map.1 hw
    rw [code_eq_zero_iff] at h0
    exact h.1 v hv ((code_eq_zero_iff v).2 (hg v h0))
  · intro S hS hne h3 j
    obtain ⟨S0, hS0, rfl⟩ := List.sublist_map_iff.1 hS
    rw [← act_sum] at h3 ⊢
    have h9 := h.2 S0 hS0 (by rintro rfl; simp at hne) (hg _ h3)
    simp only [ZeroSumW33.act]
    exact Finset.dvd_sum (fun k _ => dvd_mul_of_dvd_right (h9 k) _)

def hd (h j k : ℕ) : ℕ := h / 3 ^ (3 * j + k) % 3

def matOf (h : ℕ) : Fin 3 → Fin 3 → ℤ := fun j k => (hd h j k : ℤ)

def gcodeN (h c : ℕ) : ℕ :=
  (hd h 0 0 * dig 0 c + hd h 0 1 * dig 1 c + hd h 0 2 * dig 2 c) % 3
  + 3 * ((hd h 1 0 * dig 0 c + hd h 1 1 * dig 1 c + hd h 1 2 * dig 2 c) % 3)
  + 9 * ((hd h 2 0 * dig 0 c + hd h 2 1 * dig 1 c + hd h 2 2 * dig 2 c) % 3)

lemma val_act (h : ℕ) (v : Vec3) (j : Fin 3) :
    (act (matOf h) v j : ZMod 3).val
      = (hd h j 0 * dig 0 (code v) + hd h j 1 * dig 1 (code v) + hd h j 2 * dig 2 (code v)) % 3 := by
  rw [← ZMod.val_natCast]
  congr 1
  rw [dig_code0, dig_code1, dig_code2]
  simp only [act, matOf, Fin.sum_univ_three]
  push_cast
  simp [ZMod.natCast_zmod_val]

lemma code_act (h : ℕ) (v : Vec3) : code (act (matOf h) v) = gcodeN h (code v) := by
  unfold code gcodeN
  rw [val_act, val_act, val_act]
  rfl

def detN (h : ℕ) : ℕ := (hd h 0 0 * (hd h 1 1 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 1)
  + 2 * hd h 0 1 * (hd h 1 0 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 0)
  + hd h 0 2 * (hd h 1 0 * hd h 2 1 + 2 * hd h 1 1 * hd h 2 0)) % 3

lemma det_id0 (a b c d e f g h i x y z : ℤ) :
    (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * x
      = (e * i - f * h) * (a * x + b * y + c * z) - (b * i - c * h) * (d * x + e * y + f * z)
        + (b * f - c * e) * (g * x + h * y + i * z) := by ring

lemma det_id1 (a b c d e f g h i x y z : ℤ) :
    (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * y
      = -(d * i - f * g) * (a * x + b * y + c * z) + (a * i - c * g) * (d * x + e * y + f * z)
        - (a * f - c * d) * (g * x + h * y + i * z) := by ring

lemma det_id2 (a b c d e f g h i x y z : ℤ) :
    (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * z
      = (d * h - e * g) * (a * x + b * y + c * z) - (a * h - b * g) * (d * x + e * y + f * z)
        + (a * e - b * d) * (g * x + h * y + i * z) := by ring

lemma inv3_core (a b c d e f g h i x y z : ℤ)
    (hdet : ¬ (3 : ℤ) ∣ (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)))
    (r0 : (3 : ℤ) ∣ a * x + b * y + c * z) (r1 : (3 : ℤ) ∣ d * x + e * y + f * z)
    (r2 : (3 : ℤ) ∣ g * x + h * y + i * z) : (3 : ℤ) ∣ x ∧ (3 : ℤ) ∣ y ∧ (3 : ℤ) ∣ z := by
  have comb : ∀ (p q w : ℤ), (3 : ℤ) ∣ p → (3 : ℤ) ∣ q → (3 : ℤ) ∣ w →
      ∀ a b c : ℤ, (3 : ℤ) ∣ a * p + b * q + c * w := by
    intro p q w hp hq hw a b c
    exact dvd_add (dvd_add (dvd_mul_of_dvd_right hp _) (dvd_mul_of_dvd_right hq _)) (dvd_mul_of_dvd_right hw _)
  refine ⟨?_, ?_, ?_⟩
  · refine ((Int.prime_three.dvd_mul).1 ?_).resolve_left hdet
    have := comb _ _ _ r0 r1 r2 (e * i - f * h) (-(b * i - c * h)) (b * f - c * e)
    have eq : (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * x = (e * i - f * h) * (a * x + b * y + c * z) + (-(b * i - c * h)) * (d * x + e * y + f * z)
        + (b * f - c * e) * (g * x + h * y + i * z) := by ring
    rw [eq]; exact this
  · refine ((Int.prime_three.dvd_mul).1 ?_).resolve_left hdet
    have := comb _ _ _ r0 r1 r2 (-(d * i - f * g)) (a * i - c * g) (-(a * f - c * d))
    have eq : (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * y = (-(d * i - f * g)) * (a * x + b * y + c * z) + (a * i - c * g) * (d * x + e * y + f * z)
        + (-(a * f - c * d)) * (g * x + h * y + i * z) := by ring
    rw [eq]; exact this
  · refine ((Int.prime_three.dvd_mul).1 ?_).resolve_left hdet
    have := comb _ _ _ r0 r1 r2 (d * h - e * g) (-(a * h - b * g)) (a * e - b * d)
    have eq : (a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)) * z = (d * h - e * g) * (a * x + b * y + c * z) + (-(a * h - b * g)) * (d * x + e * y + f * z)
        + (a * e - b * d) * (g * x + h * y + i * z) := by ring
    rw [eq]; exact this

lemma inv3_of (h : ℕ) (hc : (!Nat.beq (detN h) 0) = true) : Inv3 (matOf h) := by
  have hd3 : ¬ detN h = 0 := by
    intro h0
    rw [h0] at hc
    exact absurd hc (by decide)
  intro v hv
  have r0 := hv 0
  have r1 := hv 1
  have r2 := hv 2
  simp only [act, matOf, Fin.sum_univ_three, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.isValue] at r0 r1 r2
  have hdet : ¬ (3 : ℤ) ∣ ((hd h 0 0 : ℤ) * ((hd h 1 1 : ℤ) * hd h 2 2 - (hd h 1 2 : ℤ) * hd h 2 1)
      - (hd h 0 1 : ℤ) * ((hd h 1 0 : ℤ) * hd h 2 2 - (hd h 1 2 : ℤ) * hd h 2 0)
      + (hd h 0 2 : ℤ) * ((hd h 1 0 : ℤ) * hd h 2 1 - (hd h 1 1 : ℤ) * hd h 2 0)) := by
    intro h3
    apply hd3
    have hX : ((hd h 0 0 * (hd h 1 1 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 1)
        + 2 * hd h 0 1 * (hd h 1 0 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 0)
        + hd h 0 2 * (hd h 1 0 * hd h 2 1 + 2 * hd h 1 1 * hd h 2 0) : ℕ) : ℤ)
        = ((hd h 0 0 : ℤ) * ((hd h 1 1 : ℤ) * hd h 2 2 - (hd h 1 2 : ℤ) * hd h 2 1)
      - (hd h 0 1 : ℤ) * ((hd h 1 0 : ℤ) * hd h 2 2 - (hd h 1 2 : ℤ) * hd h 2 0)
      + (hd h 0 2 : ℤ) * ((hd h 1 0 : ℤ) * hd h 2 1 - (hd h 1 1 : ℤ) * hd h 2 0))
        + 3 * ((hd h 0 0 : ℤ) * hd h 1 2 * hd h 2 1 + (hd h 0 1 : ℤ) * hd h 1 0 * hd h 2 2
          + (hd h 0 1 : ℤ) * hd h 1 2 * hd h 2 0 + (hd h 0 2 : ℤ) * hd h 1 1 * hd h 2 0) := by
      push_cast; ring
    have h4 : (3 : ℤ) ∣ ((hd h 0 0 * (hd h 1 1 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 1)
        + 2 * hd h 0 1 * (hd h 1 0 * hd h 2 2 + 2 * hd h 1 2 * hd h 2 0)
        + hd h 0 2 * (hd h 1 0 * hd h 2 1 + 2 * hd h 1 1 * hd h 2 0) : ℕ) : ℤ) := by
      rw [hX]; exact dvd_add h3 (dvd_mul_right _ _)
    have h5 := Int.natCast_dvd_natCast.1 h4
    unfold detN
    exact Nat.mod_eq_zero_of_dvd h5
  obtain ⟨h0, h1, h2⟩ := inv3_core _ _ _ _ _ _ _ _ _ (v 0) (v 1) (v 2) hdet r0 r1 r2
  intro j
  fin_cases j
  · exact h0
  · exact h1
  · exact h2

def Claim (k len : ℕ) (tgt : ℕ → List ℕ) : Prop :=
  ∀ L : List Vec3, LBad L → L.length = k →
    ∃ g, Inv3 g ∧ ∃ i < len, (L.map (fun v => code (act g v))).Perm (tgt i)

def decodeCert : ℕ → ℕ → List (ℕ × ℕ)
  | 0, _ => []
  | f + 1, P => if P = 0 then [] else ((P % 24576) / 3, (P % 24576) % 3) :: decodeCert f (P / 24576)

def insR (x : ℕ) (l : List ℕ) : List ℕ :=
  List.rec [x] (fun y ys r => bif Nat.ble x y then x :: y :: ys else y :: r) l

lemma insR_perm (x : ℕ) (l : List ℕ) : (insR x l).Perm (x :: l) := by
  induction l with
  | nil => exact List.Perm.refl _
  | cons y ys ih =>
    show (bif Nat.ble x y then x :: y :: ys else y :: insR x ys).Perm (x :: y :: ys)
    cases Nat.ble x y
    · exact ((ih.cons y).trans (List.Perm.swap x y ys))
    · exact List.Perm.refl _

def sortR (l : List ℕ) : List ℕ := List.rec [] (fun x _ r => insR x r) l

lemma sortR_perm (l : List ℕ) : (sortR l).Perm l := by
  induction l with
  | nil => exact List.Perm.refl _
  | cons x l ih => exact (insR_perm x (sortR l)).trans (ih.cons x)

def eqR (l1 : List ℕ) : List ℕ → Bool :=
  List.rec (fun l2 => List.rec true (fun _ _ _ => false) l2)
    (fun x _ r l2 => List.rec false (fun y ys _ => Nat.beq x y && r ys) l2) l1

lemma eqR_eq (l1 l2 : List ℕ) (h : eqR l1 l2 = true) : l1 = l2 := by
  induction l1 generalizing l2 with
  | nil =>
    cases l2 with
    | nil => rfl
    | cons y ys => exact absurd h (by simp [eqR])
  | cons x xs ih =>
    cases l2 with
    | nil => exact absurd h (by simp [eqR])
    | cons y ys =>
      have h' : (Nat.beq x y && eqR xs ys) = true := h
      rw [Bool.and_eq_true, Nat.beq_eq] at h'
      rw [h'.1, ih ys h'.2]

def entryOK (len' : ℕ) (tgt' : ℕ → List ℕ) (s : List ℕ) (n : ℕ) : Bool :=
  if n % 2 = 1 then certOK s (n / 2 % 3) (decodeCert 12 (n / 2 / 3))
  else decide (n / 2 / 19683 < len') && !Nat.beq (detN (n / 2 % 19683)) 0 &&
    eqR (sortR (s.map (gcodeN (n / 2 % 19683)))) (tgt' (n / 2 / 19683))

def rowOK (len' : ℕ) (tgt' : ℕ → List ℕ) (t : List ℕ) : ℕ → List ℕ → Bool
  | e, [] => e == 27
  | e, r :: rs => entryOK len' tgt' (e :: t) r && rowOK len' tgt' t (e + 1) rs

lemma rowOK_spec (len' : ℕ) (tgt' : ℕ → List ℕ) (t : List ℕ) (row : List ℕ) :
    ∀ e, rowOK len' tgt' t e row = true → ∀ e', e ≤ e' → e' < 27 →
      ∃ r, entryOK len' tgt' (e' :: t) r = true := by
  induction row with
  | nil =>
    intro e h e' h1 h2
    simp only [rowOK, beq_iff_eq] at h
    omega
  | cons r rs ih =>
    intro e h e' h1 h2
    simp only [rowOK, Bool.and_eq_true] at h
    rcases Nat.eq_or_lt_of_le h1 with h3 | h3
    · subst h3; exact ⟨r, h.1⟩
    · exact ih (e + 1) h.2 e' h3 h2

def allBelow (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => allBelow p n && p n

lemma allBelow_spec (p : ℕ → Bool) : ∀ n, allBelow p n = true → ∀ i < n, p i = true
  | 0, _, i, hi => absurd hi (Nat.not_lt_zero _)
  | n + 1, h, i, hi => by
    simp only [allBelow, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with h1 | h1
    · exact allBelow_spec p n h.1 i h1
    · subst h1; exact h.2

def stepOK (len : ℕ) (tgt : ℕ → List ℕ) (len' : ℕ) (tgt' : ℕ → List ℕ) (row : ℕ → List ℕ) : Bool :=
  allBelow (fun i => rowOK len' tgt' (tgt i) 1 (row i)) len

lemma stepClaim {k len len' : ℕ} {tgt tgt' row : ℕ → List ℕ} (hk : Claim k len tgt)
    (hs : stepOK len tgt len' tgt' row = true) : Claim (k + 1) len' tgt' := by
  intro L hb hl
  cases L with
  | nil => simp at hl
  | cons v L0 =>
    have hb0 : LBad L0 := hb.sub (List.sublist_cons_self v L0)
    obtain ⟨g, hg, i, hi, hp⟩ := hk L0 hb0 (by simpa using hl)
    have hN := hb.act hg
    have he0 : code (act g v) ≠ 0 := hN.1 _ (List.mem_map_of_mem (List.mem_cons_self ..))
    have he27 : code (act g v) < 27 := code_lt _
    obtain ⟨r, hr⟩ := rowOK_spec len' tgt' (tgt i) (row i) 1
      (allBelow_spec _ len hs i hi) (code (act g v)) (by omega) he27
    have hperm : (((v :: L0).map (act g)).map code).Perm (code (act g v) :: tgt i) := by
      simp only [List.map_cons, List.map_map]
      exact hp.cons _
    unfold entryOK at hr
    split_ifs at hr with hodd
    · exfalso
      obtain ⟨N', hN'p, hN'e⟩ := perm_lift code _ _ hperm
      exact cert_sound N' (hN.perm hN'p.symm) _ _ (by rw [hN'e]; exact hr)
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at hr
      obtain ⟨⟨hlt, hinv⟩, hsrt⟩ := hr
      have hpp := sortR_perm ((code (act g v) :: tgt i).map (gcodeN (r / 2 % 19683)))
      rw [eqR_eq _ _ hsrt] at hpp
      replace hpp := hpp.symm
      refine ⟨comp (matOf (r / 2 % 19683)) g, (inv3_of _ hinv).comp hg, r / 2 / 19683, hlt, ?_⟩
      have e : (v :: L0).map (fun w => code (act (comp (matOf (r / 2 % 19683)) g) w))
          = (code (act g v) :: L0.map (fun w => code (act g w))).map (gcodeN (r / 2 % 19683)) := by
        simp only [List.map_cons, List.map_map, act_comp, code_act]
        rfl
      rw [e]
      exact ((hp.cons _).map _).trans hpp


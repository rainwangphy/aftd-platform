{"name":"Bonami.sum_boolCube_succ","v":1,"source_hash":"8953481d12363ef2","lines":["n : ℕ","φ : BoolCube (n + 1) → ℝ","⊢ ∑ x, φ x = ∑ x, φ (Fin.snoc x false) + ∑ x, φ (Fin.snoc x true)","h_split : ∑ x, φ x = ∑ x, φ (Fin.snoc x.1 x.2)","⊢ ∑ x, φ x = ∑ x, φ (Fin.snoc x.1 x.2)","case hi","⊢ ∀ a ∈ Finset.univ, (Fin.init a, a (Fin.last n)) ∈ Finset.univ","case i_inj","⊢ ∀ a₁ ∈ Finset.univ, ∀ a₂ ∈ Finset.univ, (Fin.init a₁, a₁ (Fin.last n)) = (Fin.init a₂, a₂ (Fin.last n)) → a₁ = a₂","case i_surj","⊢ ∀ b ∈ Finset.univ, ∃ a, ∃ (_ : a ∈ Finset.univ), (Fin.init a, a (Fin.last n)) = b","case h","⊢ ∀ a ∈ Finset.univ, φ a = φ (Fin.snoc (Fin.init a, a (Fin.last n)).1 (Fin.init a, a (Fin.last n)).2)","⊢ ∀ (a₁ a₂ : Fin (n + 1) → Bool),","    (∀ (x : Fin n), Fin.init a₁ x = Fin.init a₂ x) →","      a₁ (Fin.last n) = a₂ (Fin.last n) → ∀ (x : Fin (n + 1)), a₁ x = a₂ x","a₁ a₂ : Fin (n + 1) → Bool","h₁ : ∀ (x : Fin n), Fin.init a₁ x = Fin.init a₂ x","h₂ : a₁ (Fin.last n) = a₂ (Fin.last n)","x : Fin (n + 1)","⊢ a₁ x = a₂ x","case last","⊢ a₁ (Fin.last n) = a₂ (Fin.last n)","case cast","i✝ : Fin n","⊢ a₁ i✝.castSucc = a₂ i✝.castSucc","b : (Fin n → Bool) × Bool","hb : b ∈ Finset.univ","⊢ ∃ a, ∃ (_ : a ∈ Finset.univ), (Fin.init a, a (Fin.last n)) = b","⊢ ∃ (_ : Fin.snoc b.1 b.2 ∈ Finset.univ), (Fin.init (Fin.snoc b.1 b.2), Fin.snoc b.1 b.2 (Fin.last n)) = b","⊢ ∑ x, φ (Fin.snoc x.1 x.2) = ∑ x, (φ (Fin.snoc x false) + φ (Fin.snoc x true))","⊢ ∑ x, ∑ y, φ (Fin.snoc (x, y).1 (x, y).2) = ∑ x, (φ (Fin.snoc x false) + φ (Fin.snoc x true))","x✝¹ : BoolCube n","x✝ : x✝¹ ∈ Finset.univ","⊢ ∑ y, φ (Fin.snoc (x✝¹, y).1 (x✝¹, y).2) = φ (Fin.snoc x✝¹ false) + φ (Fin.snoc x✝¹ true)","case hn","⊢ false ≠ true","case h₀","⊢ ∀ c ∈ Finset.univ, c ≠ false ∧ c ≠ true → φ (Fin.snoc (x✝¹, c).1 (x✝¹, c).2) = 0","case ha","⊢ false ∉ Finset.univ → φ (Fin.snoc (x✝¹, false).1 (x✝¹, false).2) = 0","case hb","⊢ true ∉ Finset.univ → φ (Fin.snoc (x✝¹, true).1 (x✝¹, true).2) = 0"],"goals":[[0,1,2],[0,1,3,2],[0,1,4],[5,0,
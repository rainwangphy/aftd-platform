{"name":"BooleanAnalysis.chiS_flipBit","v":1,"source_hash":"2e25f33e7b5c22c5","lines":["n : ℕ","S : Finset (Fin n)","x : BoolCube n","i : Fin n","⊢ chiS S (flipBit x i) = if i ∈ S then -chiS S x else chiS S x","⊢ ∏ i_1 ∈ S, boolToSign (Function.update x i (!x i) i_1) =","    if i ∈ S then -∏ i ∈ S, boolToSign (x i) else ∏ i ∈ S, boolToSign (x i)","case pos","hiS : i ∈ S","case neg","hiS : i ∉ S","⊢ ∏ i_1 ∈ S, boolToSign (Function.update x i (!x i) i_1) = -∏ i ∈ S, boolToSign (x i)","flipped_prod : ∏ j ∈ S, boolToSign (Function.update x i (!x i) j) = (boolToSign !x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","⊢ ∏ j ∈ S, boolToSign (Function.update x i (!x i) j) = (boolToSign !x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","this :","  ∏ j ∈ S, boolToSign (Function.update x i (!x i) j) =","    ∏ j ∈ S, Function.update (fun j => boolToSign (x j)) i (boolToSign !x i) j","⊢ ∏ j ∈ S, boolToSign (Function.update x i (!x i) j) =","⊢ ∀ x_1 ∈ S,","    boolToSign (Function.update x i (!x i) x_1) = Function.update (fun j => boolToSign (x j)) i (boolToSign !x i) x_1","j : Fin n","a✝ : j ∈ S","⊢ boolToSign (Function.update x i (!x i) j) = Function.update (fun j => boolToSign (x j)) i (boolToSign !x i) j","⊢ j ∈ S → boolToSign (Function.update x i (!x i) j) = Function.update (fun j => boolToSign (x j)) i (boolToSign !x i) j","⊢ boolToSign (if j = i then !x i else x j) = if j = i then boolToSign !x i else boolToSign (x j)","h : j = i","⊢ (boolToSign !x i) = boolToSign !x i","h : ¬j = i","⊢ boolToSign (x j) = boolToSign (x j)","a✝ hiS : j ∈ S","⊢ (boolToSign !x j) = boolToSign !x j","⊢ ∏ j ∈ S, Function.update (fun j => boolToSign (x j)) i (boolToSign !x i) j =","    (boolToSign !x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","orig_prod : ∏ j ∈ S, boolToSign (x j) = boolToSign (x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","⊢ ∏ j ∈ S, boolToSign (x j) = boolToSign (x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","⊢ boolToSign (x i) * ∏ x_1 ∈ S.erase i, boolToSign (x x_1) = boolToSign (x i) * ∏ j ∈ S \\ {i}, boolToSign (x j)","hneg : (boolToSign !x i) = -boolToSign (x i)","⊢ (boolToSign !x i) = -boolToSign (x i)","case false","⊢ (boolToSign !false) = -boolToSign false","case true","⊢ (boolToSign !true) = -boolToSign true","⊢ -boolToSign (x i) * ∏ j ∈ S \\ {i}, boolToSign (x j) = -(boolToSign (x i) * ∏ j ∈ S \\ {i}, boolToSign (x j))","⊢ ∏ i_1 ∈ S, boolToSign (Function.update x i (!x i) i_1) = ∏ i ∈ S, boolToSign (x i)","⊢ ∀ x_1 ∈ S, boolToSign (Function.update x i (!x i) x_1) = boolToSign (x x_1)","hj : j ∈ S","⊢ boolToSign (Function.update x i (!x i) j) = boolToSign (x j)","hji : j ≠ i"],"goals":[[0,1,2,3,4],[0,1,2,3,5,6],[7,0,1,2,3,8,5,6],[9,0,1,2,3,10,5,6],[7,0,1,2,3,8,11],[7,0,1,2,3,8,12,11],[0,1,2,3,8,13],[0,1,2,3,8,14,15,16,13],[0,1,2,3,8,17,16],[0,1,2,3,8,18,19],[0,1,2,3,8,20,21,22],[0,1,2,3,8,20,23],[0,1,2,3,8,20,21,24],[7,0,1,2,3,8,20,21,25,26],[9,0,1,2,3,8,20,21,27,28],[7,0,1,2,20,29,30],[0,1,2,3,8,14,15,16,31,32],[7,0,1,2,3,8,12,33,11],[0,1,2,3,8,12,34],[0,1,2,3,8,12,35],[7,0,1,2,3,8,12,33,36,11],[0,1,2,3,8,12,33,37],[38,0,1,2,3,8,12,33,39],[40,0,1,2,3,8,12,33,41],[7,0,1,2,3,8,12,33,36,42],[9,0,1,2,3,10,43],[9,0,1,2,3,10,44],[9,0,1,2,3,10,20,45,46],[9,0,1,2,3,10,20,45,47,46]],"steps":[{"line":7,"col":2,"end_line":7,"end_col":27,"tactic":"simp only [chiS, flipBit]","before":[0],"after":[1],"used":["Real","Finset","instDecidableEqFin","Membership.mem","BooleanAnalysis.flipBit","id","Finset.instSetLike","Real.instNeg","Finset.decidableMem","Fin","BooleanAnalysis.chiS","Eq","SetLike.instMembership","Neg.neg","ite"]},{"line":8,"col":2,"end_line":8,"end_col":22,"tactic":"by_cases hiS : i ∈ S","before":[1],"after":[2,3],"used":["Real","Function.update","Bool.not","BooleanAnalysis.boolToSign","Finset","instDecidableEqFin","Membership.mem","dite","Finset.prod","Finset.instSetLike","Real.instNeg","Bool","Finset.decidableMem","Fin","Eq","Not","SetLike.instMembership","Neg.neg","Real.instCommMonoid","ite"]},{"line":9,"col":4,"end_line":9,"end_col":31,"tactic":"simp only [hiS
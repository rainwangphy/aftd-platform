{"name":"Fin.succSuccAbove_comm_natAdd","v":1,"source_hash":"11b435c33782bfb5","lines":["n n1 : ℕ","i j : Fin (n + 1 + 1)","m : Fin n","⊢ (natAdd n1 i).succSuccAbove (natAdd n1 j) (natAdd n1 m) = natAdd n1 (i.succSuccAbove j m)","⊢ ↑(if n1 + ↑m < n1 + ↑i ∧ n1 + ↑m < n1 + ↑j then ⟨n1 + ↑m, ⋯⟩","      else","        if n1 + ↑m + 1 < n1 + ↑i ∧ n1 + ↑j ≤ n1 + ↑m then ⟨n1 + ↑m + 1, ⋯⟩","        else if n1 + ↑i ≤ n1 + ↑m ∧ n1 + ↑m + 1 < n1 + ↑j then ⟨n1 + ↑m + 1, ⋯⟩ else ⟨n1 + ↑m + 2, ⋯⟩) =","    n1 +","      ↑(if ↑m < ↑i ∧ ↑m < ↑j then ⟨↑m, ⋯⟩","        else if ↑m + 1 < ↑i ∧ ↑j ≤ ↑m then ⟨↑m + 1, ⋯⟩ else if ↑i ≤ ↑m ∧ ↑m + 1 < ↑j then ⟨↑m + 1, ⋯⟩ else ⟨↑m + 2, ⋯⟩)"],"goals":[[0,1,2,3],[0,1,2,4,5,6,7,8,9,10]],"steps":[{"line":9,"col":2,"end_line":9,"end_col":52,"tactic":"simp only [succSuccAbove, val_natAdd, Fin.ext_iff]","before":[0],"after":[1],"used":["Eq.mpr","Fin.natAdd","congrArg","Fin.mk","id","instOfNatNat","LE.le","instLENat","Fin.val","instHAdd","And","Fin.succSuccAbove","HAdd.hAdd","Nat","LT.lt","Nat.decLt","Eq.ndrec","instAddNat","Eq.refl","congrFun'","instLTNat","instDecidableAnd","ite_congr","OfNat.ofNat"]},{"line":10,"col":2,"end_line":10,"end_col":7,"tactic":"grind","before":[1],"after":[],"used":[]}],"steps_total":2,"truncated":false}

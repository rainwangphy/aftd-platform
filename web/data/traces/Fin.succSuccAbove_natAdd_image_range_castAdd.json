{"name":"Fin.succSuccAbove_natAdd_image_range_castAdd","v":1,"source_hash":"dfcc7f892b6005c1","lines":["n n1 : ℕ","i j : Fin (n + 1 + 1)","⊢ (natAdd n1 i).succSuccAbove (natAdd n1 j) '' Set.range (castAdd n) = {i | ↑i < n1}","a : Fin (n1 + n + 1 + 1)","⊢ a ∈ (natAdd n1 i).succSuccAbove (natAdd n1 j) '' Set.range (castAdd n) ↔ a ∈ {i | ↑i < n1}","⊢ (∃ a_1, (natAdd n1 i).succSuccAbove (natAdd n1 j) (castAdd n a_1) = a) ↔ ↑a < n1","⊢ (∃ b, castAdd (n + 1 + 1) b = a) ↔ ↑a < n1","| ∃ a_1, (natAdd n1 i).succSuccAbove (natAdd n1 j) (castAdd n a_1) = a","b : Fin n1","| castAdd (n + 1 + 1) b = a","| (natAdd n1 i).succSuccAbove (natAdd n1 j) (castAdd n b) = a","case mp","⊢ (∃ b, castAdd (n + 1 + 1) b = a) → ↑a < n1","case mpr","⊢ ↑a < n1 → ∃ b, castAdd (n + 1 + 1) b = a","⊢ ↑(castAdd (n + 1 + 1) b) < n1","h : ↑a < n1","⊢ ↑a < n1","⊢ castAdd (n + 1 + 1) ⟨↑a, h⟩ = a"],"goals":[[0,1,2],[0,1,3,4],[0,1,3,5],[0,1,3,6],[0,1,3,7],[0,1,3,8,9],[0,1,3,8,10],[11,0,1,3,12],[13,0,1,3,14],[11,0,1,8,15],[0,1,3,16,17],[0,1,3,16,18]],"steps":[{"line":9,"col":2,"end_line":9,"end_col":7,"tactic":"ext a","before":[0],"after":[1],"used":["Set.ext","Fin.natAdd","Fin.castAdd","Set.ofPred","instOfNatNat","Fin.val","instHAdd","Fin.succSuccAbove","HAdd.hAdd","Nat","LT.lt","instAddNat","Set.image","Set.range","instLTNat","OfNat.ofNat","Fin"]},{"line":10,"col":2,"end_line":10,"end_col":83,"tactic":"simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and, Set.mem_ofPred_eq]","before":[1],"after":[2],"used":["Eq.mpr","Fin.natAdd","Fin.castAdd","congrArg","Set.ofPred","Membership.mem","Exists","id","instOfNatNat","Fin.val","funext","instHAdd","And","Iff","Fin.succSuccAbove","HAdd.hAdd","Nat","LT.lt","instAddNat","Set.image","congrFun'","Set.range","instLTNat","OfNat.ofNat"]},{"line":11,"col":2,"end_line":13,"end_col":47,"tactic":"conv_lhs =>\n  enter [1, b]\n  rw [succSuccAbove_natAdd_apply_castAdd i j]","before":[2],"after":[3],"used":["Eq.mpr","Fin.natAdd","Fin.castAdd","congrArg","Exists","Eq.rec",
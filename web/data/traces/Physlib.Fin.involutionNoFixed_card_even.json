{"name":"Physlib.Fin.involutionNoFixed_card_even","v":1,"source_hash":"a9ee0492befe60e4","lines":["⊢ ∀ (n : ℕ), Even n → Fintype.card { f // Function.Involutive f ∧ ∀ (i : Fin n), f i ≠ i } = (n - 1)‼","n : ℕ","he : Even n","⊢ Fintype.card { f // Function.Involutive f ∧ ∀ (i : Fin n), f i ≠ i } = (n - 1)‼","n r : ℕ","hr : n = r + r","hr' : n = 2 * r","⊢ n = 2 * r","r : ℕ","hr : 2 * r = r + r","⊢ Fintype.card { f // Function.Involutive f ∧ ∀ (i : Fin (2 * r)), f i ≠ i } = (2 * r - 1)‼"],"goals":[[0],[1,2,3],[4,5,3],[4,5,6,3],[4,5,7],[8,9,10]],"steps":[{"line":6,"col":2,"end_line":6,"end_col":12,"tactic":"intro n he","before":[0],"after":[1],"used":["Nat"]},{"line":7,"col":2,"end_line":7,"end_col":22,"tactic":"obtain ⟨r, hr⟩ := he","before":[1],"after":[2],"used":["Nat","Even","instAddNat"]},{"line":8,"col":2,"end_line":8,"end_col":34,"tactic":"have hr' : n = 2 * r := by omega","before":[2],"after":[3],"used":["HMul.hMul","instMulNat","instOfNatNat","Nat","Decidable.byContradiction","instDecidableEqNat","OfNat.ofNat","Eq","Not","instHMul"]},{"line":8,"col":29,"end_line":8,"end_col":34,"tactic":"omega","before":[4],"after":[],"used":["HMul.hMul","instMulNat","instOfNatNat","Nat","Decidable.byContradiction","instDecidableEqNat","OfNat.ofNat","Eq","Not","instHMul"]},{"line":9,"col":2,"end_line":9,"end_col":11,"tactic":"subst hr'","before":[3],"after":[5],"used":["HMul.hMul","instMulNat","instOfNatNat","Nat","OfNat.ofNat","Eq","instHMul"]},{"line":10,"col":2,"end_line":10,"end_col":40,"tactic":"exact involutionNoFixed_card_mul_two r","before":[5],"after":[],"used":["Physlib.Fin.involutionNoFixed_card_mul_two"]}],"steps_total":6,"truncated":false}

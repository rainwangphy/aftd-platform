{"name":"TensorSpecies.Tensor.IsReindexing.succAbove_succAbove_comm","v":1,"source_hash":"08b20deeb1353025","lines":["C : Type","n : ℕ","c : Fin (n + 1 + 1) → C","k1 : Fin (n + 1 + 1)","k2 : Fin (n + 1)","⊢ let k2' := k1.succAbove k2;","  let k1' := k2.predAbove k1;","  IsReindexing ((c ∘ k2'.succAbove) ∘ k1'.succAbove) ((c ∘ k1.succAbove) ∘ k2.succAbove) id","k2' : Fin (n + 1 + 1) := k1.succAbove k2","k1' : Fin (n + 1) := k2.predAbove k1","⊢ IsReindexing ((c ∘ k2'.succAbove) ∘ k1'.succAbove) ((c ∘ k1.succAbove) ∘ k2.succAbove) id","m : Fin n","⊢ ((c ∘ k2'.succAbove) ∘ k1'.succAbove) (id m) = ((c ∘ k1.succAbove) ∘ k2.succAbove) m","⊢ c (k2'.succAbove (k1'.succAbove m)) = c (k1.succAbove (k2.succAbove m))","⊢ k2'.succAbove (k1'.succAbove m) = k1.succAbove (k2.succAbove m)"],"goals":[[0,1,2,3,4,5,6,7],[0,1,2,3,4,8,9,10],[0,1,2,3,4,8,9,11,12],[0,1,2,3,4,8,9,11,13],[0,1,2,3,4,8,9,11,14]],"steps":[{"line":14,"col":2,"end_line":14,"end_col":15,"tactic":"intro k2' k1'","before":[0],"after":[1],"used":["Fin.succAbove","instOfNatNat","instHAdd","HAdd.hAdd","Nat","instAddNat","OfNat.ofNat","Fin"]},{"line":15,"col":2,"end_line":15,"end_col":45,"tactic":"refine ⟨Function.bijective_id, fun m => ?_⟩","before":[1],"after":[2],"used":["Fin.succAbove","Function.bijective_id","Function.comp","id","instOfNatNat","instHAdd","HAdd.hAdd","Nat","And.intro","Function.Bijective","instAddNat","OfNat.ofNat","Fin","Eq"]},{"line":16,"col":2,"end_line":16,"end_col":40,"tactic":"simp only [id_eq, Function.comp_apply]","before":[2],"after":[3],"used":["Fin.succAbove","Function.comp","id","instOfNatNat","instHAdd","HAdd.hAdd","Nat","instAddNat","OfNat.ofNat","Fin","Eq"]},{"line":17,"col":2,"end_line":17,"end_col":9,"tactic":"congr 1","before":[3],"after":[4],"used":["Eq.rec","instOfNatNat","instHAdd","HAdd.hAdd","Nat","instAddNat","Eq.refl","OfNat.ofNat","Fin","Eq"]},{"line":18,"col":2,"end_line":18,"end_col":59,"tactic":"exact Fin.succAbove_succAbove_succAbove_predAbove k1 k2 m","before":[4],"afte
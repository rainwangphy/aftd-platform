{"name":"agCnt_sum","v":1,"source_hash":"f3b109a6e61e3e85","lines":["n s : ℕ","σ : Fin n → Fin s","p : Fin n","⊢ ∑ j, agCnt σ p j = n - 1","⊢ ∑ j, #{q | q ≠ p ∧ σ q = j} = n - 1","⊢ #(univ.biUnion fun j => {q | q ≠ p ∧ σ q = j}) = n - 1","⊢ (↑univ).PairwiseDisjoint fun j => {q | q ≠ p ∧ σ q = j}","this : (univ.biUnion fun j => {q | q ≠ p ∧ σ q = j}) = univ.erase p","⊢ (univ.biUnion fun j => {q | q ≠ p ∧ σ q = j}) = univ.erase p","p q : Fin n","⊢ (q ∈ univ.biUnion fun j => {q | q ≠ p ∧ σ q = j}) ↔ q ∈ univ.erase p","i : Fin s","a✝¹ : i ∈ ↑univ","j : Fin s","a✝ : j ∈ ↑univ","hij : i ≠ j","⊢ Function.onFun Disjoint (fun j => {q | q ≠ p ∧ σ q = j}) i j","⊢ i ∈ ↑univ → ∀ ⦃y : Fin s⦄, y ∈ ↑univ → i ≠ y → Function.onFun Disjoint (fun j => {q | q ≠ p ∧ σ q = j}) i y","a✝ : i ∈ ↑univ","⊢ ∀ ⦃y : Fin s⦄, y ∈ ↑univ → i ≠ y → Function.onFun Disjoint (fun j => {q | q ≠ p ∧ σ q = j}) i y","⊢ j ∈ ↑univ → i ≠ j → Function.onFun Disjoint (fun j => {q | q ≠ p ∧ σ q = j}) i j","⊢ i ≠ j → Function.onFun Disjoint (fun j => {q | q ≠ p ∧ σ q = j}) i j","⊢ Disjoint {q | q ≠ p ∧ σ q = i} {q | q ≠ p ∧ σ q = j}","⊢ ∀ x ∈ univ, x ≠ p ∧ σ x = i → ¬(x ≠ p ∧ σ x = j)","a✝² : i ∈ ↑univ","a✝¹ : j ∈ ↑univ","q : Fin n","a✝ : q ∈ univ","h1 : q ≠ p ∧ σ q = i","h2 : q ≠ p ∧ σ q = j","⊢ False","⊢ q ∈ univ → q ≠ p ∧ σ q = i → ¬(q ≠ p ∧ σ q = j)","⊢ q ≠ p ∧ σ q = i → ¬(q ≠ p ∧ σ q = j)"],"goals":[[0,1,2,3],[0,1,2,4],[0,1,2,5],[0,1,2,6],[0,1,2,7,5],[0,1,2,8],[0,1,9,10],[0,1,2,11,12,13,14,15,16],[0,1,2,11,17],[0,1,2,11,18,19],[0,1,2,11,18,13,20],[0,1,2,11,12,13,14,21],[0,1,2,11,12,13,14,15,22],[0,1,2,11,12,13,14,15,23],[0,1,2,11,24,13,25,15,26,27,28,29,30],[0,1,2,11,12,13,14,15,26,31],[0,1,2,11,24,13,25,15,26,27,32]],"steps":[{"line":5,"col":2,"end_line":5,"end_col":14,"tactic":"unfold agCnt","before":[0],"after":[1],"used":["Finset.univ","HSub.hSub","id","instSubNat","instOfNatNat","Fin.fintype","agCnt","instHSub","Nat","Nat.instAddCommMonoid","OfNat.ofNat","Fin","Eq","Finset.sum"]},{"line":6,"col":2,"end_li
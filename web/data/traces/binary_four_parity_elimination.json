{"name":"binary_four_parity_elimination","v":1,"source_hash":"74c957f942353264","lines":["a b u l : ZMod 2","⊢ ↑u.val + ↑(u + a).val + ↑(u + b).val + ↑(u + a + b).val - 2 * ↑(a * b + l).val =","    (2 + 4 * ↑(a * b + l).val) * ↑(u + l).val + 2 * ↑(a + b + u).val","⊢ ∀ (a b u l : ZMod 2),","    ↑u.val + ↑(u + a).val + ↑(u + b).val + ↑(u + a + b).val - 2 * ↑(a * b + l).val =","      (2 + 4 * ↑(a * b + l).val) * ↑(u + l).val + 2 * ↑(a + b + u).val"],"goals":[[0,1,2],[3,4,5]],"steps":[{"line":10,"col":2,"end_line":10,"end_col":16,"tactic":"revert a b u l","before":[0],"after":[1],"used":[]},{"line":11,"col":2,"end_line":11,"end_col":8,"tactic":"decide","before":[1],"after":[],"used":["HMul.hMul","of_decide_eq_true","ZMod.commRing","AddGroupWithOne.toAddGroup","CommSemiring.toSemiring","ZMod.fintype","Nat.instAtLeastTwoHAddOfNat","ZMod.decidableEq","AddGroupWithOne.toAddMonoidWithOne","HSub.hSub","id","Distrib.toAdd","AddMonoidWithOne.toNatCast","instOfNatNat","Nat.cast","Field.toSemifield","ZMod","instDistribOfSemiring","SubNegMonoid.toSub","Bool.true","instHAdd","ZMod.instField","CommRing.toCommSemiring","instHSub"]}],"steps_total":2,"truncated":false}

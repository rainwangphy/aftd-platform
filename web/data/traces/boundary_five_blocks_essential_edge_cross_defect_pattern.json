{"name":"boundary_five_blocks_essential_edge_cross_defect_pattern","v":1,"source_hash":"59cc82757ec79705","lines":["k : ℕ","hk : 5 ≤ k","G : SimpleGraph (Fin (4 * k))","inst✝ : DecidableRel G.Adj","A B C D : Finset (Fin (4 * k))","hAB : Disjoint A B","hAC : Disjoint A C","hAD : Disjoint A D","hBC : Disjoint B C","hBD : Disjoint B D","hCD : Disjoint C D","hcover : A ∪ B ∪ C ∪ D = Finset.univ","hA : A.card = 5","hC : C.card = 5","hsizeAB : A.card + B.card = 2 * k","hsizeCD : C.card + D.card = 2 * k","hnoAB : ∀ a ∈ A, ∀ b ∈ B, ¬G.Adj a b","hnoCD : ∀ c ∈ C, ∀ d ∈ D, ¬G.Adj c d","hdegree : ∀ (v : Fin (4 * k)), 2 * k + 2 ≤ (G.neighborFinset v).card","hsep :","  ∀ (X U V : Finset (Fin (4 * k))),","    U.Nonempty →","      V.Nonempty →","        Disjoint X U →","          Disjoint X V → Disjoint U V → X ∪ U ∪ V = Finset.univ → (∀ u ∈ U, ∀ v ∈ V, ¬G.Adj u v) → 2 * k ≤ X.card","hext : is_k_extendable G k","x y : Fin (4 * k)","hx : x ∈ A","hy : y ∈ C","hxy : G.Adj x y","hess : ¬is_k_extendable (G.deleteEdges {s(x, y)}) k","⊢ ({w ∈ C | ¬G.Adj x w}.card = 2 → ∀ u ∈ C, ¬G.Adj x u → {v ∈ A | ¬G.Adj v u}.card = 1) ∧","    ({w ∈ C | ¬G.Adj x w}.card ≤ 1 → {v ∈ A | ¬G.Adj v y}.card = 2)","R : Finset (Fin (4 * k))","hRsum : R.card + 2 * k = 4 * k","hxR : x ∈ R","hyR : y ∈ R","hforced : ¬∃ P, P.IsPerfectMatching","P : (SimpleGraph.induce {a | a ∈ R} G).Subgraph","hP : P.IsPerfectMatching","hR : R.card = 2 * k","⊢ R.card = 2 * k","hnr : ¬((SimpleGraph.induce {v | v ∈ R} G).deleteEdges {s(⟨x, hxR⟩, ⟨y, hyR⟩)}).Reachable ⟨x, hxR⟩ ⟨y, hyR⟩","hPxy : P.Adj ⟨x, hxR⟩ ⟨y, hyR⟩","Q W : Finset (Fin (4 * k))","hQW : Disjoint Q W","hcov : Q ∪ W ∪ {x, y} = R","hxQ : x ∉ Q","hyQ : y ∉ Q","hxW : x ∉ W","hyW : y ∉ W","hqe : Even Q.card","hwe : Even W.card","hyQadj : ∀ q ∈ Q, ¬G.Adj y q","hxWadj : ∀ w ∈ W, ¬G.Adj x w","hQWadj : ∀ q ∈ Q, ∀ w ∈ W, ¬G.Adj q w","hshape :","  have r := {c ∈ C | ¬G.Adj x c}.card;","  (r ≤ 1 → 2 ≤ (Q ∩ A).card) ∧ (r = 2 → (W ∩ C).card = 2 ∧ (Q ∩ A).card = 0 ∧ (Q ∩ B).card = 1)
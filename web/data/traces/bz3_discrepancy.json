{"name":"bz3_discrepancy","v":1,"source_hash":"a509f09619e2a78b","lines":["w : Fin 3 → ℝ","⊢ banzhaf_discrepancy ![3 / 10, 7 / 10, 0] (1 / 2) (1 / 2) w = ↑(bz3_discr (bz3_pattern w))","⊢ ∑ i,","      |![3 / 10, 7 / 10, 0] i -","          propensity_banzhaf_measure (1 / 2) (1 / 2) w i / ∑ j, propensity_banzhaf_measure (1 / 2) (1 / 2) w j| =","    ↑(have T := ↑(bz3_cnt (bz3_pattern w) 0 + bz3_cnt (bz3_pattern w) 1 + bz3_cnt (bz3_pattern w) 2);","      |3 / 10 - ↑(bz3_cnt (bz3_pattern w) 0) / T| + |7 / 10 - ↑(bz3_cnt (bz3_pattern w) 1) / T| +","        |0 - ↑(bz3_cnt (bz3_pattern w) 2) / T|)","⊢ |![3 / 10, 7 / 10, 0] 0 -","            ↑(bz3_cnt (bz3_pattern w) 0) / 4 /","              (↑(bz3_cnt (bz3_pattern w) 0) / 4 + ↑(bz3_cnt (bz3_pattern w) 1) / 4 +","                ↑(bz3_cnt (bz3_pattern w) 2) / 4)| +","        |![3 / 10, 7 / 10, 0] 1 -","            ↑(bz3_cnt (bz3_pattern w) 1) / 4 /","      |![3 / 10, 7 / 10, 0] 2 -","          ↑(bz3_cnt (bz3_pattern w) 2) / 4 /","            (↑(bz3_cnt (bz3_pattern w) 0) / 4 + ↑(bz3_cnt (bz3_pattern w) 1) / 4 + ↑(bz3_cnt (bz3_pattern w) 2) / 4)| =","    ↑(|3 / 10 -","              ↑(bz3_cnt (bz3_pattern w) 0) /","                ↑(bz3_cnt (bz3_pattern w) 0 + bz3_cnt (bz3_pattern w) 1 + bz3_cnt (bz3_pattern w) 2)| +","          |7 / 10 -","              ↑(bz3_cnt (bz3_pattern w) 1) /","        |0 -","            ↑(bz3_cnt (bz3_pattern w) 2) /","              ↑(bz3_cnt (bz3_pattern w) 0 + bz3_cnt (bz3_pattern w) 1 + bz3_cnt (bz3_pattern w) 2)|)","h4 : ∀ (a b : ℝ), a / 4 / b = a / (4 * b)","a b : ℝ","⊢ a / 4 / b = a / (4 * b)","              ((↑(bz3_cnt (bz3_pattern w) 0) + ↑(bz3_cnt (bz3_pattern w) 1) + ↑(bz3_cnt (bz3_pattern w) 2)) / 4)| +","            ((↑(bz3_cnt (bz3_pattern w) 0) + ↑(bz3_cnt (bz3_pattern w) 1) + ↑(bz3_cnt (bz3_pattern w) 2)) / 4)| =","            ↑(bz3_cnt (bz3_pattern w) 0) /","              (↑(bz3_cnt (bz3_pattern w) 0) + ↑(bz3_cnt (bz3_pattern w) 1) + ↑(bz3_cnt (bz3_pattern w) 2))| +","            ↑(bz3
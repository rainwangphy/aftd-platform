{"name":"cycle_power_alternating_paired_endpoint_label_period","v":1,"source_hash":"834fb44636028814","lines":["α : Type u_1","h : ℕ","hh : 0 < h","x : ℤ → ℕ → Bool","σ : ℤ → α","heven : ∀ (p : ℤ), ∀ j < 2 * h, x (2 * p) j = true ↔ j = 0 ∨ j = 2 * h - 1","hpair : ∀ (p : ℤ), ∀ j < h, x (2 * p + 1) (2 * j) = x (2 * p + 1) (2 * j + 1)","hslots : ∀ (v : ℤ) (a : α), ∃ j < 2 * h, x (v - ↑j) j = true ∧ σ (v - ↑j) = a","hsep :","  ∀ (v : ℤ) (j k : ℕ),","    j < 2 * h → k < 2 * h → x (v - ↑j) j = true → x (v - ↑k) k = true → σ (v - ↑j) = σ (v - ↑k) → j = k","⊢ ∀ (p : ℤ), σ (2 * p + 2 * ↑h) = σ (2 * p)","p : ℤ","⊢ σ (2 * p + 2 * ↑h) = σ (2 * p)","w : ℤ := 2 * p + 2 * ↑h","j : ℕ","hj : j < 2 * h","hxj : x (w - ↑j) j = true","hσ : σ (w - ↑j) = σ (2 * p)","case pos","he : j % 2 = 0","case neg","he : ¬j % 2 = 0","hwj : w - ↑j = 2 * (p + ↑h - ↑(j / 2))","⊢ w - ↑j = 2 * (p + ↑h - ↑(j / 2))","⊢ 2 * p + 2 * ↑h - ↑j = 2 * (p + ↑h - ↑j / 2)","hxj : x (2 * (p + ↑h - ↑(j / 2))) j = true","hz : j = 0 ∨ j = 2 * h - 1","hjz : j = 0","⊢ j = 0","hj : 0 < 2 * h","hxj : x (2 * (p + ↑h - ↑(0 / 2))) 0 = true","hσ : σ (w - ↑0) = σ (2 * p)","he : 0 % 2 = 0","hwj : w - ↑0 = 2 * (p + ↑h - ↑(0 / 2))","hz : 0 = 0 ∨ 0 = 2 * h - 1","hjodd : j = 2 * (j / 2) + 1","⊢ j = 2 * (j / 2) + 1","hr : j / 2 < h","⊢ j / 2 < h","q : ℤ := p + ↑h - ↑(j / 2) - 1","hwj : w - ↑j = 2 * q + 1","⊢ w - ↑j = 2 * q + 1","⊢ 2 * p + 2 * ↑h - ↑j = 2 * (p + ↑h - ↑j / 2 - 1) + 1","hjm : j - 1 = 2 * (j / 2)","⊢ j - 1 = 2 * (j / 2)","hprev : x (w - ↑j) (j - 1) = true","⊢ x (w - ↑j) (j - 1) = true","⊢ x (2 * q + 1) (2 * (j / 2) + 1) = true","v : ℤ := w - 1","hstart : v - ↑(j - 1) = w - ↑j","⊢ v - ↑(j - 1) = w - ↑j","⊢ w - 1 - ↑(j - 1) = w - ↑j","hendstart : v - ↑(2 * h - 1) = 2 * p","⊢ v - ↑(2 * h - 1) = 2 * p","⊢ 2 * p + 2 * ↑h - 1 - ↑(2 * h - 1) = 2 * p","heidx : 2 * h - 1 < 2 * h","⊢ 2 * h - 1 < 2 * h","hend : x (v - ↑(2 * h - 1)) (2 * h - 1) = true","⊢ x (v - ↑(2 * h - 1)) (2 * h - 1) = true","⊢ x (2 * p) (2 * h - 1) = true","heq :
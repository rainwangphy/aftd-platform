{"name":"cycle_power_dyadic_defective_fold_model_of_corrected_periodicity","v":1,"source_hash":"be3fd4b9143034ba","lines":["t : ℕ","ht : 1 ≤ t","x : ℤ → ℕ → Bool","e : ℤ → Bool","hm : cycle_power_dyadic_defective_half_model (t + 1) x e 0","hper :","  ∀ (v : ℤ),","    ∑ a ∈ Finset.range (2 ^ t), (x (v - ↑a) a).toNat + (e v).toNat =","      ∑ a ∈ Finset.range (2 ^ t), (x (v + 2 ^ t - ↑a) a).toNat + (e (v + 2 ^ t)).toNat","⊢ let y := fun p a => x p a || x p (a + 2 ^ t);","  (∀ (p : ℤ), cycle_power_dyadic_class_weight t (y p) = ∑ a ∈ Finset.range (2 ^ t), (y p a).toNat) ∧","    (∀ j < t, ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ j), (y (v - ↑a) a && y (v - ↑a) (a + 2 ^ t - 2 ^ j)).toNat = 1) ∧","      (∀ (d : ℕ), 1 ≤ d → d < 2 ^ t → ∀ (v : ℤ), ∃ a < 2 ^ t - d, y (v - ↑a) a = true ∧ y (v - ↑a) (a + d) = true) ∧","        ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ t), (y (v - ↑a) a).toNat = t + 1","y : ℤ → ℕ → Bool := fun p a => x p a || x p (a + 2 ^ t)","⊢ (∀ (p : ℤ), cycle_power_dyadic_class_weight t (y p) = ∑ a ∈ Finset.range (2 ^ t), (y p a).toNat) ∧","htight : ∀ (p : ℤ), cycle_power_dyadic_class_weight (t + 1) (x p) = ∑ a ∈ Finset.range (2 ^ (t + 1)), (x p a).toNat","hexact :","  ∀ (j : ℕ),","    j + 1 < t + 1 →","      ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ j), (x (v - ↑a) a && x (v - ↑a) (a + 2 ^ (t + 1) - 2 ^ j)).toNat = 1","htop :","    ∑ a ∈ Finset.range (2 ^ (t + 1 - 1)), (x (v - ↑a) a && x (v - ↑a) (a + 2 ^ (t + 1) - 2 ^ (t + 1 - 1))).toNat +","        (e (v + 0)).toNat =","      1","hcover :","  ∀ (d : ℕ),","    1 ≤ d →","      d < 2 ^ (t + 1) →","        d ≠ 2 ^ (t + 1 - 1) → ∀ (v : ℤ), ∃ a < 2 ^ (t + 1) - d, x (v - ↑a) a = true ∧ x (v - ↑a) (a + d) = true","hcount : ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ (t + 1)), (x (v - ↑a) a).toNat + (e v).toNat = t + 1 + 1","hs : 2 ^ (t + 1) = 2 ^ t + 2 ^ t","⊢ 2 ^ (t + 1) = 2 ^ t + 2 ^ t","⊢ 2 ^ t * 2 = 2 ^ t + 2 ^ t","case refine_1","⊢ ∀ j < t, ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ j), (y (v - ↑a) a && y (v - ↑a) (a + 2 ^ t - 2 ^ j)).toNat = 1
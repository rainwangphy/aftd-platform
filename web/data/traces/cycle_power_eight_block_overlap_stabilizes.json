{"name":"cycle_power_eight_block_overlap_stabilizes","v":1,"source_hash":"850bad26bbe56327","lines":["h : ℕ","hh : 0 < h","x : ℤ → ℕ → Bool","hprefix : ∀ (p : ℤ) (a b : ℕ), a ≤ b → b < 2 * h → x p b = true → x p a = true","hparent :","  ∀ (p : ℤ),","    ∀ a < 4 * h,","      (a < 2 * h → x p (a + 12 * h) = true → x p a = true) ∧ (2 * h ≤ a → x p a = true → x p (a + 12 * h) = true)","h6 : ∀ (v : ℤ), ∑ a ∈ range (4 * h), (x (v - ↑a) a && x (v - ↑a) (a + 12 * h)).toNat = 1","h7 : ∀ (v : ℤ), ∑ a ∈ range (2 * h), (x (v - ↑a) a && x (v - ↑a) (a + 14 * h)).toNat = 1","hcover : ∀ (d : ℕ), 1 ≤ d → d < 16 * h → ∀ (v : ℤ), ∃ a < 16 * h - d, x (v - ↑a) a = true ∧ x (v - ↑a) (a + d) = true","hnov : ∀ (p : ℤ), ∀ a < 2 * h, x p (2 * h + a) = true → x p a = true","hsep :","  ∀ (p r : ℤ) (a b : ℕ),","    p < r →","      a < 2 * h →","        b < 2 * h → x p a = true → x p (14 * h + a) = true → x r b = true → x r (14 * h + b) = true → ↑h ≤ r - p","p : ℤ","t s : ℕ","hts : t < s","hsq : s < 2 * h","hroot : x p t = true","hchild : x p (2 * h + t) = true","hmiss : x p s = false","⊢ cycle_power_eight_block_stable_overlap h x","aux :","  ∀ (N : ℕ) (p : ℤ) (t s : ℕ),","    2 * h - t = N →","      t < s →","        s < 2 * h → x p t = true → x p (2 * h + t) = true → x p s = false → cycle_power_eight_block_stable_overlap h x","⊢ ∀ (N : ℕ) (p : ℤ) (t s : ℕ),","N : ℕ","⊢ ∀ (p : ℤ) (t s : ℕ),","case h","ih :","  ∀ m < N,","    ∀ (p : ℤ) (t s : ℕ),","      2 * h - t = m →","        t < s →","          s < 2 * h → x p t = true → x p (2 * h + t) = true → x p s = false → cycle_power_eight_block_stable_overlap h x","p✝ : ℤ","t✝ s✝ : ℕ","hts✝ : t✝ < s✝","hsq✝ : s✝ < 2 * h","hroot✝ : x p✝ t✝ = true","hchild✝ : x p✝ (2 * h + t✝) = true","hmiss✝ : x p✝ s✝ = false","hN : 2 * h - t = N","u v : ℕ","hu : u < s - t","hv : v < 2 * h - (s - t)","htv : t ≤ v","hAu : x (p + ↑s - ↑(2 * h) - ↑u) u = true","hCu : x (p + ↑s - ↑(2 * h) - ↑u) (2 * h + u) = true","hMu : x (p + ↑s - ↑(2 * h) - ↑u) (2 * h + u - (s - t)) = 
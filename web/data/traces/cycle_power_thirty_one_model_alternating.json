{"name":"cycle_power_thirty_one_model_alternating","v":1,"source_hash":"9751048c4208b45d","lines":["x : ℤ → ℕ → Bool","htight : ∀ (p : ℤ), cycle_power_dyadic_class_weight (4 + 1) (x p) = ∑ a ∈ Finset.range (2 ^ (4 + 1)), (x p a).toNat","hexact :","  ∀ j < 4 + 1, ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ j), (x (v - ↑a) a && x (v - ↑a) (a + 2 ^ (4 + 1) - 2 ^ j)).toNat = 1","hcover :","  ∀ (d : ℕ), 1 ≤ d → d < 2 ^ (4 + 1) → ∀ (v : ℤ), ∃ a < 2 ^ (4 + 1) - d, x (v - ↑a) a = true ∧ x (v - ↑a) (a + d) = true","hcount : ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ (4 + 1)), (x (v - ↑a) a).toNat = 4 + 1 + 1","⊢ ∀ (p : ℤ), x (p + 1) 1 = !x p 1","p : ℤ","⊢ x (p + 1) 1 = !x p 1","case false","h : x p 1 = false","⊢ x (p + 1) 1 = !false","case true","h : x p 1 = true","⊢ x (p + 1) 1 = !true"],"goals":[[0,1,2,3,4,5,6,7],[0,1,2,3,4,5,6,8,9],[10,0,1,2,3,4,5,6,8,11,12],[13,0,1,2,3,4,5,6,8,14,15]],"steps":[{"line":12,"col":2,"end_line":12,"end_col":9,"tactic":"intro p","before":[0],"after":[1],"used":["Int"]},{"line":13,"col":2,"end_line":13,"end_col":17,"tactic":"cases h : x p 1","before":[1],"after":[2,3],"used":["instOfNatNat","Nat","Bool","Eq.refl","OfNat.ofNat","Eq"]},{"line":14,"col":4,"end_line":14,"end_col":101,"tactic":"simpa using cycle_power_thirty_one_model_bit_one_not_both_false x htight hexact hcover hcount p h","before":[2],"after":[],"used":["Eq.mpr","Bool.not_false","Bool.not","congrArg","cycle_power_thirty_one_model_bit_one_not_both_false","id","instOfNatNat","Int","Bool.true","instHAdd","instOfNat","HAdd.hAdd","Nat","Bool","Int.instAdd","OfNat.ofNat","Bool.false","Eq"]},{"line":15,"col":4,"end_line":15,"end_col":100,"tactic":"simpa using cycle_power_thirty_one_model_bit_one_not_both_true x htight hexact hcover hcount p h","before":[3],"after":[],"used":["Eq.mpr","Bool.not","congrArg","id","instOfNatNat","Int","Bool.true","instHAdd","instOfNat","HAdd.hAdd","Nat","Bool","Int.instAdd","OfNat.ofNat","Bool.false","Eq","cycle_power_thirty_one_model_bit_one_not_both_true","Bool.not_true"]
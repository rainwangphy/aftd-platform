{"name":"cycle_power_thirty_one_model_bit_one_not_both_false","v":1,"source_hash":"5f2f0d1eae8b0b1b","lines":["x : ℤ → ℕ → Bool","htight : ∀ (p : ℤ), cycle_power_dyadic_class_weight (4 + 1) (x p) = ∑ a ∈ Finset.range (2 ^ (4 + 1)), (x p a).toNat","hexact :","  ∀ j < 4 + 1, ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ j), (x (v - ↑a) a && x (v - ↑a) (a + 2 ^ (4 + 1) - 2 ^ j)).toNat = 1","hcover :","  ∀ (d : ℕ), 1 ≤ d → d < 2 ^ (4 + 1) → ∀ (v : ℤ), ∃ a < 2 ^ (4 + 1) - d, x (v - ↑a) a = true ∧ x (v - ↑a) (a + d) = true","hcount : ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ (4 + 1)), (x (v - ↑a) a).toNat = 4 + 1 + 1","⊢ ∀ (p : ℤ), x p 1 = false → x (p + 1) 1 = true","p : ℤ","hp : x p 1 = false","⊢ x (p + 1) 1 = true","hq : ¬x (p + 1) 1 = true","⊢ False","hq' : x (p + 1) 1 = false","⊢ x (p + 1) 1 = false","t :","  ∀ (p_1 : ℤ),","    cycle_power_dyadic_class_weight (4 + 1) ((fun p_2 a => x (p + p_2) a) p_1) =","      ∑ a ∈ Finset.range (2 ^ (4 + 1)), ((fun p_2 a => x (p + p_2) a) p_1 a).toNat","e :","  ∀ j < 4 + 1,","    ∀ (v : ℤ),","      ∑ a ∈ Finset.range (2 ^ j),","          ((fun p_1 a => x (p + p_1) a) (v - ↑a) a &&","              (fun p_1 a => x (p + p_1) a) (v - ↑a) (a + 2 ^ (4 + 1) - 2 ^ j)).toNat =","        1","c :","  ∀ (d : ℕ),","    1 ≤ d →","      d < 2 ^ (4 + 1) →","        ∀ (v : ℤ),","          ∃ a < 2 ^ (4 + 1) - d,","            (fun p_1 a => x (p + p_1) a) (v - ↑a) a = true ∧ (fun p_1 a => x (p + p_1) a) (v - ↑a) (a + d) = true","n : ∀ (v : ℤ), ∑ a ∈ Finset.range (2 ^ (4 + 1)), ((fun p_1 a => x (p + p_1) a) (v - ↑a) a).toNat = 4 + 1 + 1","h0 : (fun q a => x (p + q) a) 0 1 = false","⊢ (fun q a => x (p + q) a) 0 1 = false","h1 : (fun q a => x (p + q) a) 1 1 = false","⊢ (fun q a => x (p + q) a) 1 1 = false","case pos","hu : (fun q a => x (p + q) a) 5 1 = true","case neg","hu : ¬(fun q a => x (p + q) a) 5 1 = true","⊢ x (p + 5) 1 = false"],"goals":[[0,1,2,3,4,5,6,7],[0,1,2,3,4,5,6,8,9,10],[0,1,2,3,4,5,6,8,9,11,12],[0,1,2,3,4,5,6,8,9,11,13,12],[0,1,2,3,4,5,6,8,9,11,14],[0,1
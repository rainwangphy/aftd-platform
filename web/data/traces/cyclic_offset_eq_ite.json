{"name":"cyclic_offset_eq_ite","v":1,"source_hash":"a9de72e754e0227a","lines":["n : ℕ","i j : Fin n","⊢ cyclic_offset i j = if ↑i ≤ ↑j then ↑j - ↑i else ↑j + n - ↑i","⊢ (↑j + n - ↑i) % n = if ↑i ≤ ↑j then ↑j - ↑i else ↑j + n - ↑i","hi : ↑i < n","hj : ↑j < n","case pos","h : ↑i ≤ ↑j","⊢ (↑j + n - ↑i) % n = ↑j - ↑i","case neg","h : ¬↑i ≤ ↑j","⊢ (↑j + n - ↑i) % n = ↑j + n - ↑i","e : ↑j + n - ↑i = ↑j - ↑i + n","⊢ ↑j + n - ↑i = ↑j - ↑i + n","⊢ ↑j - ↑i < n","⊢ ↑j + n - ↑i < n"],"goals":[[0,1,2],[0,1,3],[0,1,4,3],[0,1,4,5,3],[6,0,1,4,5,7,8],[9,0,1,4,5,10,11],[6,0,1,4,5,7,12,8],[0,1,4,5,7,13],[0,1,4,5,7,12,14],[0,1,4,5,10,15]],"steps":[{"line":3,"col":2,"end_line":3,"end_col":22,"tactic":"unfold cyclic_offset","before":[0],"after":[1],"used":["cyclic_offset","HSub.hSub","id","instSubNat","LE.le","instLENat","Fin.val","instHAdd","instHSub","HAdd.hAdd","Nat","instAddNat","Eq","Nat.decLe","ite"]},{"line":4,"col":2,"end_line":4,"end_col":19,"tactic":"have hi := i.isLt","before":[1],"after":[2],"used":["Fin.isLt","Fin.val","Nat","LT.lt","instLTNat"]},{"line":5,"col":2,"end_line":5,"end_col":19,"tactic":"have hj := j.isLt","before":[2],"after":[3],"used":["Fin.isLt","Fin.val","Nat","LT.lt","instLTNat"]},{"line":6,"col":2,"end_line":6,"end_col":18,"tactic":"split_ifs with h","before":[3],"after":[4,5],"used":["HSub.hSub","Nat.instMod","instHMod","instSubNat","LE.le","instLENat","Fin.val","dite","instHAdd","HMod.hMod","instHSub","HAdd.hAdd","Nat","instAddNat","Eq","Not","Nat.decLe","ite"]},{"line":7,"col":4,"end_line":7,"end_col":60,"tactic":"have e : (j : ℕ) + n - i = ((j : ℕ) - i) + n := by omega","before":[4],"after":[6],"used":["HSub.hSub","instSubNat","Fin.val","instHAdd","instHSub","HAdd.hAdd","Nat","Decidable.byContradiction","instAddNat","instDecidableEqNat","Eq","Not"]},{"line":7,"col":55,"end_line":7,"end_col":60,"tactic":"omega","before":[7],"after":[],"used":["HSub.hSub","instSubNat","Fin.val","instHAdd","instHSub","HAdd.hAdd","Nat","Decidable.byContradiction","instAddN
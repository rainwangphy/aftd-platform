{"name":"dfa_prod_is_synchronizing_iff","v":1,"source_hash":"0ab1ad5f7ce99f20","lines":["α : Type u_1","σ₁ : Type u_2","σ₂ : Type u_3","A₁ : DFA α σ₁","A₂ : DFA α σ₂","q₁ : σ₁","q₂ : σ₂","w : List α","⊢ (dfa_prod A₁ A₂).evalFrom (q₁, q₂) w = (A₁.evalFrom q₁ w, A₂.evalFrom q₂ w)","case nil","⊢ (dfa_prod A₁ A₂).evalFrom (q₁, q₂) [] = (A₁.evalFrom q₁ [], A₂.evalFrom q₂ [])","case cons","a : α","ih : ∀ (q₁ : σ₁) (q₂ : σ₂), (dfa_prod A₁ A₂).evalFrom (q₁, q₂) w = (A₁.evalFrom q₁ w, A₂.evalFrom q₂ w)","⊢ (dfa_prod A₁ A₂).evalFrom (q₁, q₂) (a :: w) = (A₁.evalFrom q₁ (a :: w), A₂.evalFrom q₂ (a :: w))","⊢ List.foldl (dfa_prod A₁ A₂).step ((dfa_prod A₁ A₂).step (q₁, q₂) a) w =","    (List.foldl A₁.step (A₁.step q₁ a) w, List.foldl A₂.step (A₂.step q₂ a) w)","⊢ dfa_is_synchronizing (dfa_prod A₁ A₂) w ↔ dfa_is_synchronizing A₁ w ∧ dfa_is_synchronizing A₂ w","case mp","⊢ dfa_is_synchronizing (dfa_prod A₁ A₂) w → dfa_is_synchronizing A₁ w ∧ dfa_is_synchronizing A₂ w","case mpr","⊢ dfa_is_synchronizing A₁ w ∧ dfa_is_synchronizing A₂ w → dfa_is_synchronizing (dfa_prod A₁ A₂) w","h : dfa_is_synchronizing (dfa_prod A₁ A₂) w","⊢ dfa_is_synchronizing A₁ w ∧ dfa_is_synchronizing A₂ w","case mp.left","⊢ dfa_is_synchronizing A₁ w","case mp.right","⊢ dfa_is_synchronizing A₂ w","q₁ q₂ : σ₁","⊢ A₁.evalFrom q₁ w = A₁.evalFrom q₂ w","hprod : (dfa_prod A₁ A₂).evalFrom (q₁, A₂.start) w = (dfa_prod A₁ A₂).evalFrom (q₂, A₂.start) w","hprod : (A₁.evalFrom q₁ w, A₂.evalFrom A₂.start w) = (A₁.evalFrom q₂ w, A₂.evalFrom A₂.start w)","q₁ q₂ : σ₂","⊢ A₂.evalFrom q₁ w = A₂.evalFrom q₂ w","hprod : (dfa_prod A₁ A₂).evalFrom (A₁.start, q₁) w = (dfa_prod A₁ A₂).evalFrom (A₁.start, q₂) w","hprod : (A₁.evalFrom A₁.start w, A₂.evalFrom q₁ w) = (A₁.evalFrom A₁.start w, A₂.evalFrom q₂ w)","h₁ : dfa_is_synchronizing A₁ w","h₂ : dfa_is_synchronizing A₂ w","r₁ : σ₁","r₂ : σ₂","⊢ (dfa_prod A₁ A₂).evalFrom (q₁, q₂) w = (dfa_prod A₁ A₂).evalFrom (r₁, r₂) w","⊢ (A₁.evalFrom q₁ w, A₂.evalFrom q₂ w) = (A₁.evalFrom r₁ w, A
{"name":"energy_filter_centered_binomial_fourth_row_reindex","v":1,"source_hash":"f7ae6784089a5884","lines":["k : ℕ","⊢ ∑ i ∈ Finset.Icc (-↑k) ↑k, energy_filter_centered_binomial_weight k i ^ 4 =","    (∑ j ∈ Finset.range (2 * k + 1), ↑((2 * k).choose j) ^ 4) / ↑((2 * k).choose k) ^ 4","    ∑ i ∈ Finset.range (2 * k + 1), ↑((2 * k).choose i) ^ 4 / ↑((2 * k).choose k) ^ 4","case hi","⊢ ∀ a ∈ Finset.Icc (-↑k) ↑k, (↑k + a).toNat ∈ Finset.range (2 * k + 1)","case i_inj","⊢ ∀ a₁ ∈ Finset.Icc (-↑k) ↑k, ∀ a₂ ∈ Finset.Icc (-↑k) ↑k, (↑k + a₁).toNat = (↑k + a₂).toNat → a₁ = a₂","case i_surj","⊢ ∀ b ∈ Finset.range (2 * k + 1), ∃ a, ∃ (_ : a ∈ Finset.Icc (-↑k) ↑k), (↑k + a).toNat = b","case h","⊢ ∀ a ∈ Finset.Icc (-↑k) ↑k,","    energy_filter_centered_binomial_weight k a ^ 4 = ↑((2 * k).choose (↑k + a).toNat) ^ 4 / ↑((2 * k).choose k) ^ 4","i : ℤ","hi : i ∈ Finset.Icc (-↑k) ↑k","⊢ (↑k + i).toNat ∈ Finset.range (2 * k + 1)","hi : -↑k ≤ i ∧ i ≤ ↑k","⊢ (↑k + i).toNat < 2 * k + 1","a : ℤ","ha : a ∈ Finset.Icc (-↑k) ↑k","b : ℤ","hb : b ∈ Finset.Icc (-↑k) ↑k","hab : (↑k + a).toNat = (↑k + b).toNat","⊢ a = b","ha : -↑k ≤ a ∧ a ≤ ↑k","hb : -↑k ≤ b ∧ b ≤ ↑k","k j : ℕ","hj : j ∈ Finset.range (2 * k + 1)","⊢ ∃ a, ∃ (_ : a ∈ Finset.Icc (-↑k) ↑k), (↑k + a).toNat = j","hj : j < 2 * k + 1","case i_surj.refine_1","⊢ ↑j - ↑k ∈ Finset.Icc (-↑k) ↑k","case i_surj.refine_2","⊢ (↑k + (↑j - ↑k)).toNat = j","⊢ -↑k ≤ ↑j - ↑k ∧ ↑j - ↑k ≤ ↑k","⊢ energy_filter_centered_binomial_weight k i ^ 4 = ↑((2 * k).choose (↑k + i).toNat) ^ 4 / ↑((2 * k).choose k) ^ 4"],"goals":[[0,1,2],[0,1,3],[4,0,5],[6,0,7],[8,0,9],[10,0,11,12],[4,0,13,14,15],[4,0,13,16,15],[4,0,13,16,17],[6,0,18,19,20,21,22,23],[6,0,18,24,20,25,22,23],[8,26,27,28],[8,26,29,28],[30,26,29,31],[32,26,29,33],[30,26,29,34],[10,0,13,14,35],[10,0,13,16,35]],"steps":[{"line":5,"col":2,"end_line":5,"end_col":21,"tactic":"rw [Finset.sum_div]","before":[0],"after":[1],"used":["Eq.mpr","Real","Nat.choose","instHDiv","HMul.hMul","GroupWithZero.toDivInvMonoid"
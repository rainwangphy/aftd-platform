{"name":"energy_filter_centered_row_sum","v":1,"source_hash":"d9ac0d824df1874b","lines":["k : ℕ","f : ℤ → ℝ","⊢ ∑ t ∈ Finset.Icc (-↑k) ↑k, f t = ∑ j ∈ Finset.range (2 * k + 1), f (↑j - ↑k)","case hi","⊢ ∀ a ∈ Finset.Icc (-↑k) ↑k, (↑k + a).toNat ∈ Finset.range (2 * k + 1)","case i_inj","⊢ ∀ a₁ ∈ Finset.Icc (-↑k) ↑k, ∀ a₂ ∈ Finset.Icc (-↑k) ↑k, (↑k + a₁).toNat = (↑k + a₂).toNat → a₁ = a₂","case i_surj","⊢ ∀ b ∈ Finset.range (2 * k + 1), ∃ a, ∃ (_ : a ∈ Finset.Icc (-↑k) ↑k), (↑k + a).toNat = b","case h","⊢ ∀ a ∈ Finset.Icc (-↑k) ↑k, f a = f (↑(↑k + a).toNat - ↑k)","t : ℤ","ht : t ∈ Finset.Icc (-↑k) ↑k","⊢ (↑k + t).toNat ∈ Finset.range (2 * k + 1)","ht : -↑k ≤ t ∧ t ≤ ↑k","⊢ (↑k + t).toNat < 2 * k + 1","a : ℤ","ha : a ∈ Finset.Icc (-↑k) ↑k","b : ℤ","hb : b ∈ Finset.Icc (-↑k) ↑k","hab : (↑k + a).toNat = (↑k + b).toNat","⊢ a = b","ha : -↑k ≤ a ∧ a ≤ ↑k","hb : -↑k ≤ b ∧ b ≤ ↑k","j : ℕ","hj : j ∈ Finset.range (2 * k + 1)","⊢ ∃ a, ∃ (_ : a ∈ Finset.Icc (-↑k) ↑k), (↑k + a).toNat = j","hj : j < 2 * k + 1","case i_surj.refine_1","⊢ ↑j - ↑k ∈ Finset.Icc (-↑k) ↑k","case i_surj.refine_2","⊢ (↑k + (↑j - ↑k)).toNat = j","⊢ -↑k ≤ ↑j - ↑k ∧ ↑j - ↑k ≤ ↑k","⊢ f t = f (↑(↑k + t).toNat - ↑k)","he : ↑(↑k + t).toNat - ↑k = t","⊢ ↑(↑k + t).toNat - ↑k = t"],"goals":[[0,1,2],[3,0,1,4],[5,0,1,6],[7,0,1,8],[9,0,1,10],[3,0,1,11,12,13],[3,0,1,11,14,13],[3,0,1,11,14,15],[5,0,1,16,17,18,19,20,21],[5,0,1,16,22,18,23,20,21],[7,0,1,24,25,26],[7,0,1,24,27,26],[28,0,1,24,27,29],[30,0,1,24,27,31],[28,0,1,24,27,32],[9,0,1,11,12,33],[9,0,1,11,14,33],[9,0,1,11,14,34,33],[0,1,11,14,35]],"steps":[{"line":4,"col":2,"end_line":4,"end_col":51,"tactic":"apply Finset.sum_bij (fun t _ => ((k : ℤ) + t).toNat)","before":[0],"after":[1,2,3,4],"used":["Real","HMul.hMul","Int.instLinearOrder","Finset","Finset.sum_bij","HSub.hSub","Membership.mem","Int.instNegInt","instMulNat","instOfNatNat","Int","Int.instLocallyFiniteOrder","Finset.Icc","TotalPreorder.toPreorder","Nat.cast","Finset.range","instHAdd","instHSub","Finset.i
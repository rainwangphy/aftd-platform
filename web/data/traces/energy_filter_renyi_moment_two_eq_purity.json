{"name":"energy_filter_renyi_moment_two_eq_purity","v":1,"source_hash":"2cf0ceee595d9a63","lines":["n : Type u_1","inst✝¹ : Fintype n","inst✝ : DecidableEq n","A : Matrix n n ℝ","hA : A.IsHermitian","⊢ (A * A).trace = ∑ i, hA.eigenvalues i ^ 2","U : Matrix n n ℝ := ↑hA.eigenvectorUnitary","D : Matrix n n ℝ := Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues)","hUU : star U * U = 1","⊢ (((Unitary.conjStarAlgAut ℝ (Matrix n n ℝ)) hA.eigenvectorUnitary)","          (Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues)) *","        ((Unitary.conjStarAlgAut ℝ (Matrix n n ℝ)) hA.eigenvectorUnitary)","          (Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues))).trace =","    ∑ i, hA.eigenvalues i ^ 2","| (A * A).trace","| (((Unitary.conjStarAlgAut ℝ (Matrix n n ℝ)) hA.eigenvectorUnitary)","        (Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues)) *","      ((Unitary.conjStarAlgAut ℝ (Matrix n n ℝ)) hA.eigenvectorUnitary)","        (Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues))).trace","⊢ (↑hA.eigenvectorUnitary * Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues) * star ↑hA.eigenvectorUnitary *","        (↑hA.eigenvectorUnitary * Matrix.diagonal (RCLike.ofReal ∘ hA.eigenvalues) *","          star ↑hA.eigenvectorUnitary)).trace =","⊢ (U * D * star U * (U * D * star U)).trace = ∑ i, hA.eigenvalues i ^ 2","hid : U * D * star U * (U * D * star U) = U * (D * D) * star U","⊢ U * D * star U * (U * D * star U) = U * (D * D) * star U","⊢ U * D * star U * (U * D * star U) = U * D * (star U * U) * D * star U","⊢ U * D * (star U * U) * D * star U = U * (D * D) * star U","⊢ U * D * 1 * D * star U = U * (D * D) * star U","⊢ (star U * U * (D * D)).trace = ∑ i, hA.eigenvalues i ^ 2","⊢ (1 * (D * D)).trace = ∑ i, hA.eigenvalues i ^ 2","⊢ (D * D).trace = ∑ i, hA.eigenvalues i ^ 2","⊢ ∑ i, (RCLike.ofReal ∘ hA.eigenvalues) i * (RCLike.ofReal ∘ hA.eigenvalues) i = ∑ i, hA.eigenvalues i ^ 2","a : ℤ → ℝ","k : ℕ","⊢ energy_filter_renyi_moment a k 2 = energy_filter_sequence_purity a k","⊢ (let w :=
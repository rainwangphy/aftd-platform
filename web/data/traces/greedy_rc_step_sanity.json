{"name":"greedy_rc_step_sanity","v":1,"source_hash":"373ba9ea95fe70b9","lines":["⊢ greedy_rc_step id {[1, 2], [2, 3]} {[1, 2, 3]}","⊢ 1 < {[1, 2], [2, 3]}.card ∧","    ∃ x ∈ {[1, 2], [2, 3]} ∪ Finset.image (rev_comp id) {[1, 2], [2, 3]},","      ∃ y ∈ {[1, 2], [2, 3]} ∪ Finset.image (rev_comp id) {[1, 2], [2, 3]},","        (y ≠ x ∧ y ≠ rev_comp id x) ∧","          (∀ x' ∈ {[1, 2], [2, 3]} ∪ Finset.image (rev_comp id) {[1, 2], [2, 3]},","              ∀ y' ∈ {[1, 2], [2, 3]} ∪ Finset.image (rev_comp id) {[1, 2], [2, 3]},","                y' ≠ x' ∧ y' ≠ rev_comp id x' → string_overlap_len x' y' ≤ string_overlap_len x y) ∧","            {[1, 2, 3]} = insert (string_overlap_merge x y) ({[1, 2], [2, 3]} \\ {x, rev_comp id x, y, rev_comp id y})"],"goals":[[0],[1,2,3,4,5,6,7,8]],"steps":[{"line":3,"col":2,"end_line":3,"end_col":23,"tactic":"unfold greedy_rc_step","before":[0],"after":[1],"used":["Finset","id","Insert.insert","instOfNatNat","Finset.instInsert","List.cons","List","instDecidableEqList","Nat","instDecidableEqNat","greedy_rc_step","Finset.instSingleton","Singleton.singleton","OfNat.ofNat","List.nil"]},{"line":3,"col":25,"end_line":3,"end_col":31,"tactic":"decide","before":[1],"after":[],"used":["string_overlap_merge","instDecidableNot","of_decide_eq_true","Finset.instUnion","Finset","Finset.instSDiff","Membership.mem","Exists","rev_comp","id","Insert.insert","forall_prop_decidable","Ne","instOfNatNat","Finset.decidableEq","LE.le","instLENat","Finset.instInsert","List.cons","Bool.true","SDiff.sdiff","List","And","Finset.instSetLike"]}],"steps_total":2,"truncated":false}

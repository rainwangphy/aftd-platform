{"name":"has_range_criterion_of_matrix_pencil","v":1,"source_hash":"daf47e169bce39a5","lines":["m n k : ℕ","A : Fin k → Matrix (Fin m) (Fin n) ℂ","⊢ ∀ (m₁ m₂ : Fin m → ℂ) (n_1 : Fin n → ℂ),","    (fun i => ∑ r, ∑ s, (m₁ + m₂) r * A i r s * n_1 s) =","      (fun i => ∑ r, ∑ s, m₁ r * A i r s * n_1 s) + fun i => ∑ r, ∑ s, m₂ r * A i r s * n_1 s","x x' : Fin m → ℂ","y : Fin n → ℂ","⊢ (fun i => ∑ r, ∑ s, (x + x') r * A i r s * y s) =","    (fun i => ∑ r, ∑ s, x r * A i r s * y s) + fun i => ∑ r, ∑ s, x' r * A i r s * y s","i : Fin k","⊢ ∑ r, ∑ s, (x + x') r * A i r s * y s =","    ((fun i => ∑ r, ∑ s, x r * A i r s * y s) + fun i => ∑ r, ∑ s, x' r * A i r s * y s) i","⊢ ∀ (c : ℂ) (m_1 : Fin m → ℂ) (n_1 : Fin n → ℂ),","    (fun i => ∑ r, ∑ s, (c • m_1) r * A i r s * n_1 s) = c • fun i => ∑ r, ∑ s, m_1 r * A i r s * n_1 s","c : ℂ","x : Fin m → ℂ","⊢ (fun i => ∑ r, ∑ s, (c • x) r * A i r s * y s) = c • fun i => ∑ r, ∑ s, x r * A i r s * y s","⊢ ∑ r, ∑ s, (c • x) r * A i r s * y s = (c • fun i => ∑ r, ∑ s, x r * A i r s * y s) i","⊢ ∀ (m_1 : Fin m → ℂ) (n₁ n₂ : Fin n → ℂ),","    (fun i => ∑ r, ∑ s, m_1 r * A i r s * (n₁ + n₂) s) =","      (fun i => ∑ r, ∑ s, m_1 r * A i r s * n₁ s) + fun i => ∑ r, ∑ s, m_1 r * A i r s * n₂ s","y y' : Fin n → ℂ","⊢ (fun i => ∑ r, ∑ s, x r * A i r s * (y + y') s) =","    (fun i => ∑ r, ∑ s, x r * A i r s * y s) + fun i => ∑ r, ∑ s, x r * A i r s * y' s","⊢ ∑ r, ∑ s, x r * A i r s * (y + y') s =","    ((fun i => ∑ r, ∑ s, x r * A i r s * y s) + fun i => ∑ r, ∑ s, x r * A i r s * y' s) i","    (fun i => ∑ r, ∑ s, m_1 r * A i r s * (c • n_1) s) = c • fun i => ∑ r, ∑ s, m_1 r * A i r s * n_1 s","⊢ (fun i => ∑ r, ∑ s, x r * A i r s * (c • y) s) = c • fun i => ∑ r, ∑ s, x r * A i r s * y s","⊢ ∑ r, ∑ s, x r * A i r s * (c • y) s = (c • fun i => ∑ r, ∑ s, x r * A i r s * y s) i","⊢ ∑ x_1, ∑ x_2, x x_1 * A i x_1 x_2 * (c * y x_2) = ∑ x_1, ∑ i_1, c * (x x_1 * A i x_1 i_1 * y i_1)","r : Fin m","x✝¹ : r ∈ Finset.univ","s : Fin n","x✝ : s ∈ Finset.univ","⊢ x r * A i r s * (c * y s) = c * (x r * A i r s * y s)","⊢ (pencilMap m n k A) (x ⊗ₜ[ℂ] y) i = ∑ r, ∑ s, x r * A i r s * y s","hA : LinearIndependent ℂ A","⊢ Function.Surjective ⇑(pencilMap m n k A)","⊢ (pencilMap m n k A).range = ⊤","hne : ¬(pencilMap m n k A).range = ⊤","⊢ False","f : (Fin k → ℂ) →ₗ[ℂ] ℂ","hf0 : f ≠ 0","hf : (pencilMap m n k A).range ≤ f.ker","c : Fin k → ℂ := fun i => f (Pi.single i 1)","hfc : ∀ (v : Fin k → ℂ), f v = ∑ i, c i * v i","⊢ ∀ (v : Fin k → ℂ), f v = ∑ i, c i * v i","v : Fin k → ℂ","⊢ f v = ∑ i, c i * v i","hv : v = ∑ i, v i • Pi.single i 1","⊢ v = ∑ i, v i • Pi.single i 1","j : Fin k","⊢ v j = (∑ i, v i • Pi.single i 1) j","⊢ f (∑ i, v i • Pi.single i 1) = ∑ i, c i * v i","| f v","| f (∑ i, v i • Pi.single i 1)","hzero : ∑ i, c i • A i = 0","⊢ ∑ i, c i • A i = 0","⊢ (∑ i, c i • A i) r s = 0 r s","this : (pencilMap m n k A) (Pi.single r 1 ⊗ₜ[ℂ] Pi.single s 1) ∈ f.ker","this : ∑ i, c i * (pencilMap m n k A) (Pi.single r 1 ⊗ₜ[ℂ] Pi.single s 1) i = 0","this : ∑ x, c x * ∑ r_1, ∑ s_1, Pi.single r 1 r_1 * A x r_1 s_1 * Pi.single s 1 s_1 = 0","hc : ∀ (i : Fin k), c i = 0","c : Fin k → ℂ := ⋯","⊢ f = 0","v : Fin k","⊢ (f ∘ₗ LinearMap.single ℂ (fun i => ℂ) v) 1 = (0 ∘ₗ LinearMap.single ℂ (fun i => ℂ) v) 1","m n k ℓ : ℕ","B : Fin ℓ → Matrix (Fin m) (Fin n) ℂ","hB : LinearIndependent ℂ B","hcond :","  ∀ (x : Fin m → ℂ) (y : Fin n → ℂ),","    (∀ (i : Fin k), ∑ r, ∑ s, x r * A i r s * y s = 0) →","      (∀ (j : Fin ℓ), ∑ r, ∑ s, star (x r) * B j r s * y s = 0) → x = 0 ∨ y = 0","⊢ has_range_criterion_subspaces m n k ℓ","case refine_1","⊢ Module.finrank ℂ (TensorProduct ℂ (Fin m → ℂ) (Fin n → ℂ) ⧸ (pencilMap m n k A).ker) = k","case refine_2","⊢ Module.finrank ℂ (TensorProduct ℂ (Fin m → ℂ) (Fin n → ℂ) ⧸ (pencilMap m n ℓ B).ker) = ℓ","case refine_3","⊢ ∀ (x : Fin m → ℂ) (y : Fin n → ℂ),","    x ⊗ₜ[ℂ] y ∈ (pencilMap m n k A).ker → star x ⊗ₜ[ℂ] y ∈ (pencilMap m n ℓ B).ker → x = 0 ∨ y = 0","⊢ Module.finrank ℂ (Fin k → ℂ) = k","⊢ Module.finrank ℂ (Fin
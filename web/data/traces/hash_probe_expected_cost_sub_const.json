{"name":"hash_probe_expected_cost_sub_const","v":1,"source_hash":"6804700e436d79d2","lines":["n : ℕ","r : Fin n → ZMod n","c : ZMod n","T : Finset (ZMod n)","a : ZMod n","⊢ hash_insert_step n (fun j => r j - c) T a = hash_insert_step n r T (a - c)","⊢ (if h : {j | a + (r j - c) ∉ T}.Nonempty then T ∪ {a + (r ({j | a + (r j - c) ∉ T}.min' h) - c)} else T) =","    if h : {j | a - c + r j ∉ T}.Nonempty then T ∪ {a - c + r ({j | a - c + r j ∉ T}.min' h)} else T","j : Fin n","⊢ a + (r j - c) = a - c + r j","A : List (ZMod n)","⊢ List.foldl (hash_insert_step n fun j => r j - c) T A =","    List.foldl (hash_insert_step n r) T (List.map (fun x => x - c) A)","case nil","⊢ List.foldl (hash_insert_step n fun j => r j - c) T [] =","    List.foldl (hash_insert_step n r) T (List.map (fun x => x - c) [])","case cons","c a : ZMod n","as : List (ZMod n)","ih :","  ∀ (T : Finset (ZMod n)),","    List.foldl (hash_insert_step n fun j => r j - c) T as =","      List.foldl (hash_insert_step n r) T (List.map (fun x => x - c) as)","⊢ List.foldl (hash_insert_step n fun j => r j - c) T (a :: as) =","    List.foldl (hash_insert_step n r) T (List.map (fun x => x - c) (a :: as))","⊢ List.foldl (hash_insert_step n fun j => r j - c) (hash_insert_step n (fun j => r j - c) T a) as =","    List.foldl (hash_insert_step n r) (hash_insert_step n r T (a - c)) (List.map (fun x => x - c) as)","⊢ List.foldl (hash_insert_step n fun j => r j - c) (hash_insert_step n r T (a - c)) as =","t n : ℕ","p : (Fin t → ZMod n) × ZMod n","⊢ (fun p => (fun i => p.1 i + c, p.2 + c)) ((fun p => (fun i => p.1 i - c, p.2 - c)) p) = p","case fst","x✝ : Fin t","⊢ ((fun p => (fun i => p.1 i + c, p.2 + c)) ((fun p => (fun i => p.1 i - c, p.2 - c)) p)).1 x✝ = p.1 x✝","case snd","⊢ ((fun p => (fun i => p.1 i + c, p.2 + c)) ((fun p => (fun i => p.1 i - c, p.2 - c)) p)).2 = p.2","⊢ (fun p => (fun i => p.1 i - c, p.2 - c)) ((fun p => (fun i => p.1 i + c, p.2 + c)) p) = p","⊢ ((fun p => (fun i => p.1 i - c, p.2 - c)) ((fun p => (fun i
{"name":"matrix3_valid_of_unit_checks","v":1,"source_hash":"e050a4b732328219","lines":["R : Type u_1","inst✝ : CommSemiring R","L : List (Matrix3Triad R)","c : R","A B : Matrix (Fin 3) (Fin 3) R","⊢ eval_matrix3_decomposition L (c • A) B = c • eval_matrix3_decomposition L A B","case nil","⊢ eval_matrix3_decomposition [] (c • A) B = c • eval_matrix3_decomposition [] A B","case cons","t : Matrix3Triad R","L' : List (Matrix3Triad R)","ih : eval_matrix3_decomposition L' (c • A) B = c • eval_matrix3_decomposition L' A B","⊢ eval_matrix3_decomposition (t :: L') (c • A) B = c • eval_matrix3_decomposition (t :: L') A B","⊢ eval_matrix3_decomposition L A (c • B) = c • eval_matrix3_decomposition L A B","⊢ eval_matrix3_decomposition [] A (c • B) = c • eval_matrix3_decomposition [] A B","ih : eval_matrix3_decomposition L' A (c • B) = c • eval_matrix3_decomposition L' A B","⊢ eval_matrix3_decomposition (t :: L') A (c • B) = c • eval_matrix3_decomposition (t :: L') A B","i j : Fin 3","⊢ Matrix.single i j c = c • Matrix.single i j 1","A : Matrix (Fin 3) (Fin 3) R","⊢ A = ∑ i, ∑ j, A i j • Matrix.single i j 1","⊢ ∑ i, ∑ j, Matrix.single i j (A i j) = ∑ i, ∑ j, A i j • Matrix.single i j 1","i : Fin 3","x✝¹ : i ∈ Finset.univ","j : Fin 3","x✝ : j ∈ Finset.univ","⊢ Matrix.single i j (A i j) = A i j • Matrix.single i j 1","h :","  ∀ (i j k l : Fin 3),","    eval_matrix3_decomposition L (Matrix.single i j 1) (Matrix.single k l 1) = Matrix.single i j 1 * Matrix.single k l 1","⊢ is_valid_matrix3_decomposition L","⊢ eval_matrix3_decomposition L A B = A * B","⊢ eval_matrix3_decomposition L (∑ i, ∑ j, A i j • Matrix.single i j 1) B = A * B","⊢ eval_matrix3_decomposition L (∑ i, ∑ j, A i j • Matrix.single i j 1) (∑ i, ∑ j, B i j • Matrix.single i j 1) = A * B","⊢ ∑ x,","      ∑ x_1,","        ∑ x_2,","          ∑ x_3, A x x_1 • B x_2 x_3 • eval_matrix3_decomposition L (Matrix.single x x_1 1) (Matrix.single x_2 x_3 1) =","    A * B","⊢ ∑ x, ∑ x_1, ∑ x_2, ∑ x_3, A x x_1 • B x_2 x_3 • (Matrix.sin
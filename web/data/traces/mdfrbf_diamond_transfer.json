{"name":"mdfrbf_diamond_transfer","v":1,"source_hash":"083bbf01a455036a","lines":["j K d k k' : ℕ","f : Fin k → Fin k'","T : Finset (Fin K) → Finset (Fin d)","hT : ∀ (A A' : Finset (Fin K)), T A ⊆ T A' ↔ A ⊆ A'","χ : Finset (Fin d) → Fin k'","ψ : Finset (Fin K) → Fin k","h : ∀ (A : Finset (Fin K)), A.Nonempty → χ (T A) = f (ψ A)","col : Fin k","hempty : ψ ∅ ≠ col","⊢ has_monochromatic_diamond_copy j K col ψ → has_monochromatic_diamond_copy j d (f col) χ","bot top : Finset (Fin K)","hbot : bot ⊂ top","hbotc : ψ bot = col","htopc : ψ top = col","mid : Fin j → Finset (Fin K)","hmid : ∀ (i : Fin j), bot ⊂ mid i ∧ mid i ⊂ top ∧ ψ (mid i) = col","hincomp : ∀ (i i' : Fin j), i ≠ i' → ¬mid i ⊆ mid i'","⊢ has_monochromatic_diamond_copy j d (f col) χ","hinj : Function.Injective T","hbotne : bot.Nonempty","⊢ bot.Nonempty","⊢ bot ≠ ∅","h0 : bot = ∅","⊢ False","hbotc : ψ ∅ = col","htopne : top.Nonempty","hmidne : ∀ (i : Fin j), (mid i).Nonempty","⊢ ∀ (i : Fin j), (mid i).Nonempty","i : Fin j","⊢ (mid i).Nonempty","⊢ mid i ≠ ∅","h0 : mid i = ∅","hc : ψ (mid i) = col","hc : ψ ∅ = col","case refine_1","⊢ T bot ⊂ T top","case refine_2","⊢ χ (T bot) = f col","case refine_3","⊢ χ (T top) = f col","case refine_4","⊢ ∀ (i : Fin j), T bot ⊂ (fun i => T (mid i)) i ∧ (fun i => T (mid i)) i ⊂ T top ∧ χ ((fun i => T (mid i)) i) = f col","case refine_5","⊢ ∀ (i i' : Fin j), i ≠ i' → ¬(fun i => T (mid i)) i ⊆ (fun i => T (mid i)) i'","⊢ T bot ⊆ T top ∧ T bot ≠ T top","⊢ T bot ⊂ (fun i => T (mid i)) i ∧ (fun i => T (mid i)) i ⊂ T top ∧ χ ((fun i => T (mid i)) i) = f col","case refine_4.refine_1","⊢ T bot ⊂ (fun i => T (mid i)) i","case refine_4.refine_2","⊢ (fun i => T (mid i)) i ⊂ T top","case refine_4.refine_3","⊢ χ ((fun i => T (mid i)) i) = f col","⊢ T bot ⊆ (fun i => T (mid i)) i ∧ T bot ≠ (fun i => T (mid i)) i","⊢ (fun i => T (mid i)) i ⊆ T top ∧ (fun i => T (mid i)) i ≠ T top","i i' : Fin j","hne : i ≠ i'","hincl : (fun i => T (mid i)) i ⊆ (fun i => T (mid i)) i'"],"goals":[[0,1,2,3,4,5
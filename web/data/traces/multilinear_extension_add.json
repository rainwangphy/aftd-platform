{"name":"multilinear_extension_add","v":1,"source_hash":"2ee0c870131c04fc","lines":["m : ℕ","f g : Finset (Fin m) → ℝ","x : Fin m → ℝ","⊢ multilinear_extension (f + g) x = multilinear_extension f x + multilinear_extension g x","⊢ ∑ S, ((f + g) S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) =","    ∑ S, (f S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) + ∑ S, (g S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u)","    ∑ x_1, ((f x_1 * ∏ u ∈ x_1, x u) * ∏ u ∈ x_1ᶜ, (1 - x u) + (g x_1 * ∏ u ∈ x_1, x u) * ∏ u ∈ x_1ᶜ, (1 - x u))","⊢ ∀ x_1 ∈ Finset.univ,","    ((f + g) x_1 * ∏ u ∈ x_1, x u) * ∏ u ∈ x_1ᶜ, (1 - x u) =","      (f x_1 * ∏ u ∈ x_1, x u) * ∏ u ∈ x_1ᶜ, (1 - x u) + (g x_1 * ∏ u ∈ x_1, x u) * ∏ u ∈ x_1ᶜ, (1 - x u)","S : Finset (Fin m)","a✝ : S ∈ Finset.univ","⊢ ((f + g) S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) =","    (f S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) + (g S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u)","⊢ S ∈ Finset.univ →","    ((f + g) S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) =","      (f S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) + (g S * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u)","⊢ ((f S + g S) * ∏ u ∈ S, x u) * ∏ u ∈ Sᶜ, (1 - x u) ="],"goals":[[0,1,2,3],[0,1,2,4,5],[0,1,2,4,6],[0,1,2,7,8,9],[0,1,2,10,11,12,13],[0,1,2,10,14,15,16],[0,1,2,10,11,17,13]],"steps":[{"line":3,"col":2,"end_line":3,"end_col":30,"tactic":"unfold multilinear_extension","before":[0],"after":[1],"used":["Real","Finset","id","multilinear_extension","Real.instAdd","instHAdd","Pi.instAdd","HAdd.hAdd","Fin","Eq"]},{"line":4,"col":2,"end_line":4,"end_col":31,"tactic":"rw [← Finset.sum_add_distrib]","before":[1],"after":[2],"used":["Finset.fintype","Eq.mpr","Real","HMul.hMul","Finset.univ","congrArg","Finset.sum_add_distrib","Compl.compl","Finset","Real.instSub","AddMonoid.toAddZeroClass","instDecidableEqFin","HSub.hSub","BooleanAlgebra.toCompl","AddZeroClass.toAddZero","id","Fin.fintype","Finset.prod","Real.instAdd","Real.instOne","instHAdd","Pi.instAdd","instHSub","HAdd.hAdd"]},{"line":5,"col":2,"end_line":5,"end_col":28,"t
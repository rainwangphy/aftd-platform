{"name":"perm_cross_inv_sum","v":1,"source_hash":"e784057a3a871eff","lines":["n : ℕ","σ : Equiv.Perm (Fin n)","⊢ ((∑ a, ∑ b, if ↑(σ a) < ↑a ∧ ↑b ≤ ↑(σ b) ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","      ∑ a, if ↑(σ a) < ↑a then ↑(σ a) else 0) =","    ∑ a, if ↑(σ a) < ↑a then ↑a else 0","hpt :","  ∀ (a : Fin n),","    (((∑ b, if ↑(σ a) < ↑a ∧ ↑b ≤ ↑(σ b) ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","          ∑ b, if ↑(σ a) < ↑a ∧ ↑(σ b) < ↑b ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","        if ↑(σ a) < ↑a then ↑(σ a) else 0) =","      (∑ b, if ↑(σ b) < ↑b ∧ ↑(σ a) < ↑a ∧ ↑a < ↑b ∧ ↑(σ b) < ↑(σ a) then 1 else 0) + if ↑(σ a) < ↑a then ↑a else 0","⊢ ∀ (a : Fin n),","a : Fin n","⊢ (((∑ b, if ↑(σ a) < ↑a ∧ ↑b ≤ ↑(σ b) ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","        ∑ b, if ↑(σ a) < ↑a ∧ ↑(σ b) < ↑b ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","      if ↑(σ a) < ↑a then ↑(σ a) else 0) =","    (∑ b, if ↑(σ b) < ↑b ∧ ↑(σ a) < ↑a ∧ ↑a < ↑b ∧ ↑(σ b) < ↑(σ a) then 1 else 0) + if ↑(σ a) < ↑a then ↑a else 0","case pos","ha : ↑(σ a) < ↑a","case neg","ha : ¬↑(σ a) < ↑a","h1 : {x | ↑x < ↑a ∧ ↑(σ a) < ↑(σ x)}.card + ↑(σ a) = {x | ↑a < ↑x ∧ ↑(σ x) < ↑(σ a)}.card + ↑a","h1 : (∑ i, if ↑i < ↑a ∧ ↑(σ a) < ↑(σ i) then 1 else 0) + ↑(σ a) = (∑ i, if ↑a < ↑i ∧ ↑(σ i) < ↑(σ a) then 1 else 0) + ↑a","⊢ ∑ x,","        ((if ↑(σ a) < ↑a ∧ ↑x ≤ ↑(σ x) ∧ ↑x < ↑a ∧ ↑(σ a) < ↑(σ x) then 1 else 0) +","          if ↑(σ a) < ↑a ∧ ↑(σ x) < ↑x ∧ ↑x < ↑a ∧ ↑(σ a) < ↑(σ x) then 1 else 0) +","      ↑(σ a) =","    (∑ b, if ↑(σ b) < ↑b ∧ ↑(σ a) < ↑a ∧ ↑a < ↑b ∧ ↑(σ b) < ↑(σ a) then 1 else 0) + ↑a","e1 :","  ∀ (b : Fin n),","    ((if ↑(σ a) < ↑a ∧ ↑b ≤ ↑(σ b) ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","        if ↑(σ a) < ↑a ∧ ↑(σ b) < ↑b ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) =","      if ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0","⊢ ∀ (b : Fin n),","b : Fin n","⊢ ((if ↑(σ a) < ↑a ∧ ↑b ≤ ↑(σ b) ∧ ↑b < ↑a ∧ ↑(σ a) < ↑(σ b) then 1 else 0) +","      if ↑(σ a) < ↑a ∧ ↑(σ b) < ↑b ∧ ↑b < ↑a ∧ ↑
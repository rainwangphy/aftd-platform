{"name":"pure_nash_of_common_payoff_maximizer","v":1,"source_hash":"8462e622c62e6a15","lines":["Player : Type u_1","inst✝ : DecidableEq Player","G : StrategicGame Player","u : ((j : Player) → G.Strategy j) → ℝ","h_common : ∀ (i : Player) (s : (j : Player) → G.Strategy j), G.payoff i s = u s","s : (i : Player) → G.Strategy i","h_max : ∀ (s' : (j : Player) → G.Strategy j), u s' ≤ u s","⊢ is_pure_nash_equilibrium G s","i : Player","s_i' : G.Strategy i","⊢ G.payoff i (Function.update s i s_i') ≤ G.payoff i s","⊢ u (Function.update s i s_i') ≤ u s"],"goals":[[0,1,2,3,4,5,6,7],[0,1,2,3,4,5,6,8,9,10],[0,1,2,3,4,5,6,8,9,11]],"steps":[{"line":8,"col":2,"end_line":8,"end_col":14,"tactic":"intro i s_i'","before":[0],"after":[1],"used":[]},{"line":9,"col":2,"end_line":9,"end_col":25,"tactic":"rw [h_common, h_common]","before":[1],"after":[2],"used":["Eq.mpr","Real.instLE","Real","Function.update","congrArg","id","LE.le","StrategicGame.Strategy","Eq","StrategicGame.payoff"]},{"line":10,"col":2,"end_line":10,"end_col":40,"tactic":"exact h_max (Function.update s i s_i')","before":[2],"after":[],"used":["Function.update","StrategicGame.Strategy"]}],"steps_total":3,"truncated":false}

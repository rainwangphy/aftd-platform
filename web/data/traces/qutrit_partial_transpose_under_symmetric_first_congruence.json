{"name":"qutrit_partial_transpose_under_symmetric_first_congruence","v":1,"source_hash":"248845a588c2210c","lines":["m : ℕ","ρ : Matrix (Fin 3 × Fin m) (Fin 3 × Fin m) ℂ","H : Matrix (Fin 3) (Fin 3) ℂ","hpt : ∀ (i j : Fin 3) (p q : Fin m), ρ (i, p) (j, q) = ρ (j, p) (i, q)","⊢ ∀ (a c : Fin 3) (p q : Fin m), ∑ i, ∑ j, H a i * ρ (i, p) (j, q) * H c j = ∑ i, ∑ j, H c i * ρ (i, p) (j, q) * H a j","a c : Fin 3","p q : Fin m","⊢ ∑ i, ∑ j, H a i * ρ (i, p) (j, q) * H c j = ∑ i, ∑ j, H c i * ρ (i, p) (j, q) * H a j","⊢ ∑ y, ∑ x, H a x * ρ (x, p) (y, q) * H c y = ∑ i, ∑ j, H c i * ρ (i, p) (j, q) * H a j","⊢ ∀ x ∈ Finset.univ, ∑ x_1, H a x_1 * ρ (x_1, p) (x, q) * H c x = ∑ j, H c x * ρ (x, p) (j, q) * H a j","i : Fin 3","hi : i ∈ Finset.univ","⊢ ∑ x, H a x * ρ (x, p) (i, q) * H c i = ∑ j, H c i * ρ (i, p) (j, q) * H a j","⊢ ∀ x ∈ Finset.univ, H a x * ρ (x, p) (i, q) * H c i = H c i * ρ (i, p) (x, q) * H a x","j : Fin 3","hj : j ∈ Finset.univ","⊢ H a j * ρ (j, p) (i, q) * H c i = H c i * ρ (i, p) (j, q) * H a j","⊢ H a j * ρ (j, p) (i, q) * H c i = H c i * ρ (j, p) (i, q) * H a j"],"goals":[[0,1,2,3,4],[0,1,2,3,5,6,7],[0,1,2,3,5,6,8],[0,1,2,3,5,6,9],[0,1,2,3,5,6,10,11,12],[0,1,2,3,5,6,10,11,13],[0,1,2,3,5,6,10,11,14,15,16],[0,1,2,3,5,6,10,11,14,15,17]],"steps":[{"line":14,"col":2,"end_line":14,"end_col":15,"tactic":"intro a c p q","before":[0],"after":[1],"used":["instOfNatNat","Nat","OfNat.ofNat","Fin"]},{"line":15,"col":2,"end_line":15,"end_col":22,"tactic":"rw [Finset.sum_comm]","before":[1],"after":[2],"used":["Eq.mpr","HMul.hMul","Finset.univ","congrArg","Complex.instMul","id","Prod.mk","instOfNatNat","Fin.fintype","Nat","Complex","Finset.sum_comm","OfNat.ofNat","Fin","Eq","Complex.instAddCommMonoid","Finset.sum","instHMul"]},{"line":16,"col":2,"end_line":16,"end_col":28,"tactic":"apply Finset.sum_congr rfl","before":[2],"after":[3],"used":["HMul.hMul","Finset.univ","Finset","Complex.instMul","Prod.mk","instOfNatNat","Fin.fintype","Nat","Complex","OfNat.ofNat","Fin","Com
{"name":"tarski_slice_subbox_monotone_and_fixed","v":1,"source_hash":"63b99488a46248aa","lines":["n k : ℕ","inst✝ : NeZero n","f : (Fin (k + 1) → Fin n) → Fin (k + 1) → Fin n","hf : Monotone f","a b : Fin (k + 1) → Fin n","ha : a ≤ f a","hb : f b ≤ b","i : Fin (k + 1)","c : Fin n","hac : a i ≤ c","hcb : c ≤ b i","⊢ let g := fun y j => f (i.insertNth c y) (i.succAbove j);","  let a' := a ∘ i.succAbove;","  let b' := b ∘ i.succAbove;","  Monotone g ∧","    a' ≤ g a' ∧","      g b' ≤ b' ∧","        ∀ (y : Fin k → Fin n),","          a' ≤ y →","            y ≤ b' →","              g y = y →","                let x := i.insertNth c y;","                a ≤ x ∧ x ≤ b ∧ ∀ (j : Fin (k + 1)), j ≠ i → f x j = x j","⊢ (Monotone fun y j => f (i.insertNth c y) (i.succAbove j)) ∧","    (a ∘ i.succAbove ≤ fun j => f (i.insertNth c (a ∘ i.succAbove)) (i.succAbove j)) ∧","      (fun j => f (i.insertNth c (b ∘ i.succAbove)) (i.succAbove j)) ≤ b ∘ i.succAbove ∧","          a ∘ i.succAbove ≤ y →","            y ≤ b ∘ i.succAbove →","              (fun j => f (i.insertNth c y) (i.succAbove j)) = y →","                a ≤ i.insertNth c y ∧","                  i.insertNth c y ≤ b ∧ ∀ (j : Fin (k + 1)), j ≠ i → f (i.insertNth c y) j = i.insertNth c y j","case refine_1","⊢ Monotone fun y j => f (i.insertNth c y) (i.succAbove j)","case refine_2","⊢ a ∘ i.succAbove ≤ fun j => f (i.insertNth c (a ∘ i.succAbove)) (i.succAbove j)","case refine_3","⊢ (fun j => f (i.insertNth c (b ∘ i.succAbove)) (i.succAbove j)) ≤ b ∘ i.succAbove","case refine_4","⊢ ∀ (y : Fin k → Fin n),","    a ∘ i.succAbove ≤ y →","      y ≤ b ∘ i.succAbove →","        (fun j => f (i.insertNth c y) (i.succAbove j)) = y →","          a ≤ i.insertNth c y ∧","            i.insertNth c y ≤ b ∧ ∀ (j : Fin (k + 1)), j ≠ i → f (i.insertNth c y) j = i.insertNth c y j","y y' : Fin k → Fin n","hyy' : y ≤ y'","⊢ (fun y j => f (i.insertNth c y) (i.succAbove j)) y ≤ (fun y j => f (i.insertNth c y) (i.succAbove j)) y'","j : Fin k","⊢ (fun y